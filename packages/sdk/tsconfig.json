{
   "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "outDir": "dist",
      "rootDir": "src",
      "strict": true,
      "types": ["node"],
      "declaration": true,
      "sourceMap": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "incremental": true,
      "tsBuildInfoFile": "../../.cache/tsc/sdk.tsbuildinfo"
   },
   "include": ["src"]
}
