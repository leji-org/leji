---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/source-serif-4';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
// The two palettes ship as sheets of their own, loaded through their built URLs so
// they are hashed and cached like the main stylesheet. They are linked rather than
// imported because the order matters: an imported sheet joins the bundle Astro
// appends at the end of the head, and the dark palette has to be able to follow the
// light one. The dark link carries the condition, which is how one copy of the
// palette serves both the operating system's preference and a reader's stored choice.
import paletteSheet from '../styles/palette.css?url';
import darkSheet from '../styles/dark.css?url';
import SchemeToggle from '../components/SchemeToggle.astro';
import { chromeStrings } from '../data/i18n';
import { alternates, localeOf } from '../i18n';

const {
   title = 'Leji: the shared context layer for AI-native teams',
   description = 'Leji is an open specification for a shared, versioned, repo-owned context layer read by people and AI agents, with every change governed through review.',
   alternate,
   noindex = false,
   lang = 'en',
} = Astro.props;
// The skip link opens the body of every page in every language. `lang` is the page's
// own declaration, while the strings are keyed by the registry's locale, so the label is
// read from the URL the way the header and the footer read theirs.
const chrome = chromeStrings(localeOf(Astro.url.pathname));
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// Language alternates, emitted here for every page in every language rather than
// per page: the registry knows which routes are translated, so the set is
// reciprocal by construction and a route with no translation emits none.
const localeAlternates = alternates(Astro.url.pathname);

// Analytics are opt-in at build time and off by default: this source ships with none, so a
// plain build produces a site that loads nothing third-party. A deployment that wants
// analytics sets both values in the build environment, PUBLIC_ANALYTICS_SCRIPT being the
// full script URL and PUBLIC_ANALYTICS_SITE the site token that script expects. Either one
// alone does nothing, since a script without its token cannot report anyway.
const analyticsScript = (import.meta.env.PUBLIC_ANALYTICS_SCRIPT ?? '').trim();
const analyticsSite = (import.meta.env.PUBLIC_ANALYTICS_SITE ?? '').trim();
const analyticsEnabled = analyticsScript !== '' && analyticsSite !== '';
// Only the origin reaches the policy: a CSP source matches by origin, and a bad URL here
// should fail the build loudly rather than ship a policy nobody can read.
const analyticsSource = analyticsEnabled ? ` ${new URL(analyticsScript).origin}` : '';

// CSP, kept in lockstep with public/_headers except the directives that have no effect in a <meta> policy:
// frame-ancestors and X-Content-Type-Options are response headers only, and live in public/_headers alone.
// The policy is first-party only unless the build supplies analytics, in which case that one
// origin joins the three directives its beacon needs and nothing else changes.
const CSP =
   `default-src 'self'; img-src 'self' data:${analyticsSource}; style-src 'self' 'unsafe-inline'; ` +
   `script-src 'self' 'unsafe-inline'${analyticsSource}; ` +
   `connect-src 'self'${analyticsSource}; ` +
   "font-src 'self'; base-uri 'self'; object-src 'none'";

// Sitewide structured data, public information only.
const siteLd = {
   '@context': 'https://schema.org',
   '@graph': [
      {
         '@type': 'WebSite',
         '@id': 'https://leji.org/#website',
         name: 'Leji',
         description:
            'Leji is an open specification for a shared, versioned, repo-owned context layer read by people and AI agents, with every change governed through review.',
         url: 'https://leji.org',
         inLanguage: 'en',
         publisher: { '@id': 'https://leji.org/#organization' },
      },
      {
         // The publisher is the steward, not the specification. Leji is the spec;
         // Contexing, LLC stewards it (GOVERNANCE.md).
         '@type': 'Organization',
         '@id': 'https://leji.org/#organization',
         name: 'Contexing, LLC',
         url: 'https://contexing.com',
      },
   ],
};
---

<!doctype html>
<html lang={lang}>
   <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta http-equiv="Content-Security-Policy" content={CSP} />
      <meta name="referrer" content="strict-origin-when-cross-origin" />
      <title>{title}</title>
      <meta name="description" content={description} />
      {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
      {alternate && <link rel="alternate" type="text/markdown" href={alternate} />}
      {localeAlternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={new URL(a.href, Astro.site)} />)}
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <link rel="sitemap" href="/sitemap-index.xml" />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:type" content="website" />
      {!noindex && <meta property="og:url" content={canonical} />}
      <meta property="og:site_name" content="Leji" />
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={ogImage} />
      {
         /* The light palette, the dark one, then the script that addresses it, all three
          written by the parser inside the head so they act before the first paint and
          ahead of the stylesheets the bundle appends at the end of it. With no stored
          choice the dark link's own query follows the operating system live and the
          script does nothing, so no listener exists anywhere. A stored light choice
          silences the link; a stored dark one silences it and writes a second link to
          the same sheet, which every browser treats as render blocking because the
          parser created it, so a reader never sees the other scheme first. */
      }
      <link rel="stylesheet" href={paletteSheet} />
      <link id="leji-dark" rel="stylesheet" href={darkSheet} media="(prefers-color-scheme: dark)" />
      <script is:inline>
         (function () {
            try {
               var choice = localStorage.getItem('leji-appearance');
               if (choice !== 'light' && choice !== 'dark') return;
               var sheet = document.getElementById('leji-dark');
               document.documentElement.dataset.appearance = choice;
               sheet.media = 'not all';
               if (choice === 'dark')
                  document.write('<link rel="stylesheet" href="' + sheet.getAttribute('href') + '">');
            } catch (e) {}
         })();
      </script>
      <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
      {analyticsEnabled && <script is:inline src={analyticsScript} data-site={analyticsSite} defer />}
   </head>
   <body>
      <a class="skip-link" href="#content">{chrome.skipToContent}</a>
      <slot />
      {
         /* The scheme control closes the body of every page, after the content rather
          than in the header: it is the reader's own setting, not a destination, and it
          keeps its corner of the viewport wherever the page has been scrolled to. */
      }
      <SchemeToggle />
   </body>
</html>
