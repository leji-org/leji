---
// Stable doc sidebar; only the active item changes. Collapsible groups persist open/closed across pages (localStorage).
import { SPEC_DOCS, specPath } from '../data/spec-docs';
import { navStrings } from '../data/i18n';
import { englishKey, localeOf, localizedHref } from '../i18n';
const { current } = Astro.props as { current: string };

// `current` is the English route the page stands for, in either language; the language
// itself is the page's own URL. Both sides of the comparison reduce to the English
// route, so a translated page highlights the entry its page of record highlights.
const locale = localeOf(Astro.url.pathname);
const nav = navStrings(locale);
const to = (route: string) => localizedHref(route, locale);

const currentKey = englishKey(current);
const here = (route: string) => (currentKey === englishKey(route) ? 'page' : undefined);
const schemasHere = currentKey.startsWith('/schemas') ? 'page' : undefined;
---

<nav class="doc-nav" aria-label={nav.documentation}>
   <details data-group="spec" open>
      <summary><span>{nav.specification}</span><span class="chev" aria-hidden="true">›</span></summary>
      <ol>
         {
            SPEC_DOCS.map((d) => (
               <li>
                  <a href={to(specPath(d.id))} aria-current={here(specPath(d.id))}>
                     {nav.specDocs[d.id]}
                  </a>
               </li>
            ))
         }
      </ol>
      <ol class="plain">
         <li>
            <a href={to('/spec/full/')} aria-current={here('/spec/full/')}>{nav.onePage}</a>
         </li>
      </ol>
   </details>

   <details data-group="reference" open>
      <summary><span>{nav.reference}</span><span class="chev" aria-hidden="true">›</span></summary>
      <ol class="plain">
         <li>
            <a href={to('/manifest/')} aria-current={here('/manifest/')}>{nav.manifestFile}</a>
         </li>
         <li>
            <a href={to('/schemas/')} aria-current={schemasHere}>{nav.schemas}</a>
         </li>
         <li>
            <a href={to('/cli/')} aria-current={here('/cli/')}>{nav.cli}</a>
         </li>
         <li>
            <a href={to('/mcp/')} aria-current={here('/mcp/')}>{nav.mcp}</a>
         </li>
      </ol>
   </details>

   <details data-group="resources" open>
      <summary><span>{nav.resources}</span><span class="chev" aria-hidden="true">›</span></summary>
      <ol class="plain">
         <li>
            <a href={to('/quickstart/')} aria-current={here('/quickstart/')}>{nav.quickstart}</a>
         </li>
         <li>
            <a href={to('/agent-ready/')} aria-current={here('/agent-ready/')}>{nav.agentReady}</a>
         </li>
         <li>
            <a href={to('/adoption/')} aria-current={here('/adoption/')}>{nav.adoptionGuide}</a>
         </li>
         <li>
            <a href={to('/federation/')} aria-current={here('/federation/')}>{nav.federation}</a>
         </li>
         <li>
            <a href={to('/rationale/')} aria-current={here('/rationale/')}>{nav.rationale}</a>
         </li>
         <li>
            <a href={to('/ai-native/')} aria-current={here('/ai-native/')}>{nav.aiNative}</a>
         </li>
         <li>
            <a href={to('/trust/')} aria-current={here('/trust/')}>{nav.trust}</a>
         </li>
         <li>
            <a href={to('/translation/')} aria-current={here('/translation/')}>{nav.translation}</a>
         </li>
      </ol>
   </details>
</nav>

<script is:inline>
   // Persist each group's collapsed state across navigation so it doesn't reset.
   // In one column the sidebar stacks above the article, so an open nav puts
   // roughly twenty links between the reader and the H1 they followed a link to
   // reach. Collapse the groups by default at that width: three summary rows, one
   // tap to the same list, and the header's own menu is still there. A reader who
   // has opened a group keeps their choice on both widths.
   var narrow = window.matchMedia('(max-width: 800px)').matches;
   for (const d of document.querySelectorAll('.doc-nav details[data-group]')) {
      const key = 'leji-nav-' + d.dataset.group;
      const saved = localStorage.getItem(key);
      if (saved !== null) d.open = saved === '1';
      else if (narrow) d.open = false;
      d.addEventListener('toggle', () => localStorage.setItem(key, d.open ? '1' : '0'));
   }
</script>
