---
import LejiLogo from './LejiLogo.astro';
import { footerStrings, navStrings } from '../data/i18n';
import { localeOf, localizedHref } from '../i18n';

// The footer closes every page in every language and takes no props for it, so the
// language it renders in is read from the page's own URL, exactly as the header does.
// The logo, Trust and Trademark are pages of this site, so each one points at the
// locale's own page where it exists and at the English page where it does not.
const locale = localeOf(Astro.url.pathname);
const footer = footerStrings(locale);
const href = (route: string) => localizedHref(route, locale);
---

<footer class="site-footer">
   <div class="wrap">
      <div class="footer-entry">
         <a class="footer-brand" href={href('/')} aria-label={navStrings(locale).home}><LejiLogo height={30} /></a>
         <span class="footer-phon">/LEH-jee/&ensp;·&ensp;{footer.tagline}</span>
      </div>
      <p class="footer-meaning">{footer.description}</p>
      <div class="footer-meta">
         <span
            >{footer.createdBy}{' '}<a href="https://vuongnguyen.com" target="_blank" rel="noopener">Vuong Nguyen</a> · <span
               class="meta-verbose">{footer.stewardedBy}{' '}</span
            ><a href="https://contexing.com" target="_blank" rel="noopener">Contexing</a> · <a
               href="mailto:hello@leji.org">hello@leji.org</a
            ></span
         >
         <span
            >Apache-2.0<span class="meta-verbose"> {footer.codeSchemas}</span> · CC-BY-4.0<span class="meta-verbose">
               {' '}{footer.specProse}</span
            > · <a href={href('/trust/')}>{footer.trust}</a> · <a href={href('/trademark/')}>{footer.trademark}</a> · <a
               href="https://github.com/leji-org/leji/blob/main/SECURITY.md"
               target="_blank"
               rel="noopener">{footer.security}</a
            ></span
         >
      </div>
   </div>
</footer>

<style>
   .site-footer {
      margin-top: 1rem;
      border-top: 3px solid var(--leji-accent-line);
      background:
         radial-gradient(900px 380px at 82% -30%, var(--leji-band-glow-mint), transparent 60%), var(--leji-deep);
      color: var(--leji-ink-on-deep);
      position: relative;
      overflow: hidden;
      /* The bottom padding also clears the corner control's footprint, so the last row stays reachable at the page's end. */
      padding: 2.4rem 0 max(2rem, calc(2.5rem + var(--leji-corner-inset) + 0.5rem));
   }
   .site-footer::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: repeating-linear-gradient(90deg, transparent 0 78px, rgba(112, 216, 194, 0.06) 78px 79px);
      pointer-events: none;
   }
   .site-footer > * {
      position: relative;
   }

   .footer-entry {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.4rem 1.1rem;
   }
   .footer-brand {
      color: var(--leji-ink-on-deep);
      display: inline-flex;
      transform: translateY(4px);
   }
   .footer-phon {
      font-family: var(--mono);
      font-size: 0.78rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--leji-accent);
   }
   .footer-meaning {
      font-family: var(--serif-display);
      font-size: clamp(1.15rem, 2.2vw, 1.5rem);
      font-weight: 520;
      line-height: 1.3;
      letter-spacing: 0.005em;
      color: var(--leji-ink-on-deep-soft);
      margin: 0.9rem 0 0;
      max-width: 40ch;
   }
   .footer-meaning a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: rgba(112, 216, 194, 0.45);
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
      transition:
         color 0.15s ease,
         text-decoration-color 0.15s ease;
   }
   .footer-meaning a:hover {
      color: var(--leji-accent);
      text-decoration-color: var(--leji-accent);
   }

   .footer-meta {
      margin-top: 1.9rem;
      padding-top: 1.1rem;
      border-top: 1px solid rgba(112, 216, 194, 0.26);
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem 2.5rem;
      font-family: var(--mono);
      font-size: 0.74rem;
      letter-spacing: 0.04em;
      color: var(--white-faint);
   }
   .footer-meta a {
      color: var(--white-strong);
      text-decoration: none;
      border-bottom: 1px solid rgba(112, 216, 194, 0.5);
      padding-bottom: 1px;
      transition:
         color 0.15s,
         border-color 0.15s;
   }
   .footer-meta a:hover {
      color: var(--leji-accent);
      border-color: var(--leji-accent);
   }
   /* small screens: drop "Stewarded by" and the license parentheticals */
   @media (max-width: 600px) {
      .meta-verbose {
         display: none;
      }
   }
</style>
