---
// Syntax-highlighted code block with a copy button. The button copies the
// rendered code's textContent, so the copied text is exactly the source.
//
// A page names the button after the command it copies, in its own language; where it
// names nothing the general label stands in, read from the page's URL like the rest of
// the shared chrome. The button renames itself while the feedback shows, so that name
// is handed to the script below as a data attribute: one script serves every language,
// and a word inside it could only be in one of them.
import { Code } from 'astro:components';
import copyIcon from '../assets/copy.svg?raw';
import checkIcon from '../assets/check.svg?raw';
import lejiSyntaxTheme from '../styles/shiki-leji.json';
import { chromeStrings } from '../data/i18n';
import { localeOf } from '../i18n';

interface Props {
   code: string;
   lang?: string;
   /** Accessible label for the button (and its copied/idle states). */
   label?: string;
}
const chrome = chromeStrings(localeOf(Astro.url.pathname));
const { code, lang = 'text', label = chrome.copyCode } = Astro.props;
---

<div class="cc" data-copy-code data-copy-label={label} data-copied-label={chrome.copied}>
   <Code code={code} lang={lang} theme={lejiSyntaxTheme} />
   <button type="button" class="cc-copy" aria-label={label}>
      <span class="cc-i cc-i-copy" set:html={copyIcon} />
      <span class="cc-i cc-i-check" set:html={checkIcon} />
   </button>
</div>

<style>
   .cc {
      position: relative;
      margin-top: 0.6rem;
   }
   .cc :global(.astro-code) {
      background: var(--leji-deep) !important;
      border-radius: 10px;
      padding: 1rem 1.2rem;
      /* room so long lines never slide under the copy button */
      padding-right: 3.2rem;
      font-size: var(--code-fz);
      line-height: 1.6;
      margin: 0;
      overflow-x: auto;
   }
   .cc-copy {
      position: absolute;
      top: 0.6rem;
      right: 0.6rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.4rem;
      color: var(--white-soft);
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 6px;
      cursor: pointer;
      transition:
         background 0.15s ease,
         color 0.15s ease,
         border-color 0.15s ease;
   }
   .cc-copy:hover,
   .cc-copy:focus-visible {
      background: rgba(112, 216, 194, 0.2);
      color: var(--leji-accent);
      border-color: var(--leji-accent);
      outline: none;
   }
   .cc-i {
      display: block;
   }
   .cc-i :global(svg) {
      display: block;
      width: 15px;
      height: 15px;
   }
   .cc-i-check {
      display: none;
   }
   .cc-copy.copied .cc-i-copy {
      display: none;
   }
   .cc-copy.copied .cc-i-check {
      display: block;
      color: var(--leji-accent);
   }
   @media (prefers-reduced-motion: reduce) {
      .cc-copy {
         transition: none;
      }
   }
</style>

<script>
   for (const root of document.querySelectorAll<HTMLElement>('[data-copy-code]')) {
      const codeEl = root.querySelector<HTMLElement>('.astro-code');
      const copyBtn = root.querySelector<HTMLButtonElement>('.cc-copy');
      if (!codeEl || !copyBtn) continue;
      // Both names come from the markup, in the language the page was rendered in.
      const { copyLabel = '', copiedLabel = '' } = root.dataset;
      let timer = 0;
      copyBtn.addEventListener('click', async () => {
         try {
            await navigator.clipboard.writeText(codeEl.textContent ?? '');
            copyBtn.classList.add('copied');
            copyBtn.setAttribute('aria-label', copiedLabel);
            window.clearTimeout(timer);
            timer = window.setTimeout(() => {
               copyBtn.classList.remove('copied');
               copyBtn.setAttribute('aria-label', copyLabel);
            }, 1400);
         } catch {
            // clipboard unavailable: the code stays visible to copy by hand
         }
      });
   }
</script>
