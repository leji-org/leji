---
// The page classification eyebrow, defined in one place so the taxonomy cannot
// drift page to page.
//
// What it encodes is what governs the page, which is the fact a reader arriving
// from a search engine cannot otherwise get: the sidebar's grouping is the same
// information, but it collapses on mobile and says nothing on a deep link.
//
// The normative split is transcribed from the specification itself, not invented
// here (spec/README.md): "The JSON Schemas in ../schemas/ are normative for the
// machine-readable artifacts. The documents in ../rationale/ and ../adoption/ are
// non-normative."
//
// Adding a page means picking a kind, never writing an eyebrow string. The phrases
// live in `data/schema-labels.ts` so a locale can author its own; the specification
// line inside two of them is a version token and is placed rather than translated.
import { pageKindLabels } from '../data/i18n';
import { type PageKind, SPEC_LINE } from '../data/schema-labels';
import { localeOf } from '../i18n';

interface Props {
   kind: PageKind;
   /** Omit where the page's own markdown supplies the h1. */
   title?: string;
}

const { kind, title } = Astro.props;
const kinds = pageKindLabels(localeOf(Astro.url.pathname));
---

<p class="eyebrow">{kinds[kind].replace('{spec}', SPEC_LINE)}</p>
{title && <h1>{title}</h1>}
