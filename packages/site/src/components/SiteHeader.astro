---
// Site header. `flush` drops the band background and mint line where the header sits inside the monument (the landing page).
import LejiLogo from './LejiLogo.astro';
import githubIcon from '../assets/github.svg?raw';
import { chromeStrings, navStrings } from '../data/i18n';
import { englishKey, localeOf, localeOptions, localizedHref } from '../i18n';
const { flush = false } = Astro.props;

// The header is on every page in every language and takes no props for it, so the
// language it renders in is read from the page's own URL. Each destination is the
// same page in that language where it exists, and the English one where it does not.
const path = Astro.url.pathname;
const locale = localeOf(path);
const nav = navStrings(locale);
const chrome = chromeStrings(locale);
const href = (route: string) => localizedHref(route, locale);

// Section-aware active state across the reference and adoption sections, compared on
// the English route both sides reduce to: a translated page marks the entry its own
// page of record marks, which a comparison against the served path cannot do.
const here = englishKey(path);
const inSection = (route: string) => {
   const key = englishKey(route);
   return here === key || here.startsWith(`${key}/`);
};
const active = (...routes: string[]) => (routes.some(inSection) ? 'page' : undefined);

// The languages this page exists in, and nothing where it exists in one only: a
// reader is never offered a link into a page that was never written. It sits
// beside the logo rather than in the menu, because which language you are
// reading is a property of the whole site, not one more destination in it.
const languages = localeOptions(path);
const readingNow = languages.find((l) => l.current);
const languageLabel = readingNow ? nav.language.replace('{language}', readingNow.label) : '';
---

<header class:list={['site-header-band', { flush }]}>
   <div class="wrap header-row">
      <div class="brand-row">
         <a class="brand" href={href('/')} aria-label={nav.home}><LejiLogo height={30} /></a>
         {
            readingNow && (
               <details class="locale-select">
                  <summary aria-label={languageLabel}>
                     <span lang={readingNow.locale}>{readingNow.label}</span>
                     <span class="caret" aria-hidden="true">
                        ›
                     </span>
                  </summary>
                  {/* A disclosure, so the list opens by click and by keyboard with
                      no script of its own, the way the sidebar's groups do. A div
                      rather than a nav: the header's bare `nav` rules style the
                      menu band, and a second nav here would inherit them. */}
                  <div class="locale-menu">
                     {languages.map((l) => (
                        <a
                           href={l.href}
                           hreflang={l.locale}
                           lang={l.locale}
                           aria-current={l.current ? 'true' : undefined}
                        >
                           {l.label}
                        </a>
                     ))}
                  </div>
               </details>
            )
         }
      </div>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={nav.openMenu}>
         <span class="bars" aria-hidden="true"></span>
      </button>
      <nav id="site-nav" aria-label={nav.primary}>
         <a href={href('/quickstart/')} aria-current={active('/quickstart/')}>{nav.quickstart}</a>
         <a href={href('/spec/')} aria-current={active('/spec/')}>{nav.spec}</a>
         <div class="nav-group">
            <a
               href={href('/adoption/')}
               class="nav-trigger"
               aria-haspopup="true"
               aria-current={active('/adoption/', '/federation/')}
            >
               {nav.adopt}{' '}
               <span class="caret" aria-hidden="true">›</span>
            </a>
            <div class="nav-menu">
               <a href={href('/adoption/')}>{nav.adoptionGuide}</a>
               <a href={href('/federation/')}>{nav.federation}</a>
            </div>
         </div>
         <div class="nav-group">
            <a
               href={href('/manifest/')}
               class="nav-trigger"
               aria-haspopup="true"
               aria-current={active('/manifest/', '/schemas/', '/cli/', '/mcp/')}
            >
               {nav.reference}{' '}
               <span class="caret" aria-hidden="true">›</span>
            </a>
            <div class="nav-menu">
               <a href={href('/manifest/')}>{nav.manifest}</a>
               <a href={href('/schemas/')}>{nav.schemas}</a>
               <a href={href('/cli/')}>{nav.cli}</a>
               <a href={href('/mcp/')}>{nav.mcp}</a>
            </div>
         </div>
         <a href={href('/rationale/')} aria-current={active('/rationale/')}>{nav.rationale}</a>
         <!-- Trust is deliberately not here: it lives in the footer and in the
              Resources group of every doc page's sidebar. Nor is the language
              selector: it sits beside the logo. -->
         <a
            class="source-link"
            href="https://github.com/leji-org/leji"
            target="_blank"
            rel="noopener"
            aria-label={chrome.sourceRepository}
         >
            {chrome.source}
            <span class="gh-icon" set:html={githubIcon} />
         </a>
      </nav>
   </div>
</header>

<style>
   .site-header-band {
      border-bottom: 3px solid var(--leji-accent-line);
      background: var(--leji-deep);
      color: var(--leji-ink-on-deep);
      position: sticky;
      top: 0;
      /* the stuck ground swap on every page, and the flush variant's mint line */
      transition:
         background-color 0.25s ease,
         border-color 0.25s ease;
      /* above .doc-nav, which pins at the content level, and above the dropdowns
         (z-30) a stuck band has to keep painting over. */
      z-index: 40;
      /* no overflow:hidden here: it would clip the Reference dropdown. The
         fluting ::before is inset:0, so it never overflows the band anyway. */
   }
   .site-header-band::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: repeating-linear-gradient(90deg, transparent 0 78px, rgba(112, 216, 194, 0.06) 78px 79px);
      pointer-events: none;
   }
   .site-header-band > * {
      position: relative;
   }
   /* Flush: the landing page's monument band runs up behind this header, so the
      band paints the background and the header stays transparent on top of it.
      The transparent border reserves the mint rule's 3px, so taking the line
      back is a colour change and never a height change. */
   .site-header-band.flush {
      border-bottom: 3px solid transparent;
      background: transparent;
   }
   /* The fluting is hidden, not dropped: at rest the monument draws its own
      flutes behind this header, so a second set would double them. It fades in
      with the glass ground, where the band paints and the monument no longer
      shows through. */
   .site-header-band.flush::before {
      opacity: 0;
      transition: opacity 0.25s ease;
   }
   .site-header-band.flush[data-stuck]::before {
      opacity: 1;
   }
   /* Two stages, two different constraints. Ground first: once the page can
      scroll at all, something is travelling under the band, so it needs a
      ground or that content reads straight through it. That ground is glass,
      and only here: the band is translucent exactly while content can pass
      beneath it, so every page's at-rest look is untouched. Over the hero the
      monument's own dark ground makes the change visually silent. */
   .site-header-band[data-stuck] {
      background: var(--leji-stuck-backdrop);
      /* -webkit- first, standard last: the build's CSS minifier collapses the
         pair to whichever comes last, and the standard property is the one to
         keep; Safari without it falls to the @supports rule below. */
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
   }
   /* Without blur behind it, 85% is not glass but a washed-out band that the
      page shows through: fall back to the solid ground. */
   @supports not (backdrop-filter: blur(1px)) {
      .site-header-band[data-stuck] {
         background: var(--leji-deep);
      }
   }
   /* Same solid ground where the reader has asked for less transparency. */
   @media (prefers-reduced-transparency: reduce) {
      .site-header-band[data-stuck] {
         background: var(--leji-deep);
      }
   }
   /* The mint line is the monument's boundary, not a scroll indicator: it
      arrives only once the monument's bottom edge has passed under the band,
      where the flush header stops sitting inside the monument and becomes the
      standard band. */
   .site-header-band.flush[data-past-hero] {
      border-bottom-color: var(--leji-accent-line);
   }
   .header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.8rem 1.5rem;
      padding-top: 1.05rem;
      padding-bottom: 1.05rem;
   }
   /* The logo and the language selector travel together as one flex item, so
      the row's space-between still puts the brand left and the nav right. */
   .brand-row {
      display: inline-flex;
      align-items: center;
      gap: 0.85rem;
   }
   .brand {
      color: var(--leji-ink-on-deep);
      display: inline-flex;
   }

   /* Language selector. A small bordered pill carrying the native language name
      in its own case, set apart from the nav's uppercase links because it names
      the language being read rather than a destination. It is a <details>, so it
      opens by click and by keyboard with no script of its own, and it is rendered
      only where the page exists in more than one language. */
   .locale-select {
      position: relative;
   }
   .locale-select summary {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.03em;
      text-transform: none;
      line-height: 1.4;
      display: inline-flex;
      align-items: center;
      gap: 0.35em;
      cursor: pointer;
      list-style: none;
      padding: 0.3em 0.7em 0.3em 0.8em;
      border: 1px solid var(--leji-accent-rule);
      border-radius: 999px;
      background: transparent;
      color: var(--white-soft);
      transition:
         color 0.2s,
         border-color 0.2s,
         background-color 0.2s;
   }
   /* The native marker, replaced by the caret the rest of the header uses. */
   .locale-select summary::-webkit-details-marker {
      display: none;
   }
   .locale-select summary:hover,
   .locale-select summary:focus-visible,
   .locale-select[open] summary {
      color: var(--leji-accent);
      border-color: var(--leji-accent);
      background: rgba(112, 216, 194, 0.08);
   }
   .locale-select summary .caret {
      font-size: 0.85em;
   }
   .locale-select[open] summary .caret {
      transform: rotate(270deg);
   }
   .locale-menu {
      position: absolute;
      top: calc(100% + 0.7rem);
      left: 0;
      min-width: 10rem;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      padding: 0.5rem;
      background: var(--leji-surface);
      border: 1px solid var(--leji-border);
      border-radius: 10px;
      box-shadow: 0 14px 34px rgba(24, 61, 59, 0.24);
      z-index: 30;
   }
   .locale-menu a {
      color: var(--leji-text-body);
      text-decoration: none;
      text-transform: none;
      letter-spacing: 0.01em;
      font-size: 0.82rem;
      white-space: nowrap;
      padding: 0.4rem 0.7rem;
      border-radius: 5px;
   }
   .locale-menu a:hover {
      color: var(--leji-text);
      background: rgba(0, 159, 113, 0.06);
   }
   .locale-menu a[aria-current='true'] {
      color: var(--leji-text);
      font-weight: 600;
   }
   .nav-toggle {
      display: none;
      align-items: center;
      justify-content: center;
      width: 2.4rem;
      height: 2.4rem;
      margin: -0.5rem -0.5rem -0.5rem 0;
      padding: 0;
      background: none;
      border: none;
      color: var(--leji-ink-on-deep);
      cursor: pointer;
   }
   .bars,
   .bars::before,
   .bars::after {
      display: block;
      width: 22px;
      height: 2px;
      background: currentColor;
      transition:
         transform 0.2s ease,
         opacity 0.15s ease;
   }
   .bars {
      position: relative;
   }
   .bars::before,
   .bars::after {
      content: '';
      position: absolute;
      left: 0;
   }
   .bars::before {
      top: -7px;
   }
   .bars::after {
      top: 7px;
   }
   .nav-toggle[aria-expanded='true'] .bars {
      background: transparent;
   }
   .nav-toggle[aria-expanded='true'] .bars::before {
      transform: translateY(7px) rotate(45deg);
   }
   .nav-toggle[aria-expanded='true'] .bars::after {
      transform: translateY(-7px) rotate(-45deg);
   }
   nav {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem 1.6rem;
      font-family: var(--mono);
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
   }
   nav a {
      white-space: nowrap;
   }
   .source-link {
      display: inline-flex;
      align-items: center;
      gap: 0.45em;
   }
   .source-link .gh-icon {
      display: inline-flex;
   }
   .source-link .gh-icon :global(svg) {
      display: block;
      height: 14px;
      width: auto;
      transform: translateY(-1px);
   }
   nav a {
      color: var(--white-soft);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      padding-bottom: 2px;
      transition:
         color 0.2s,
         border-color 0.2s;
   }
   nav a:hover {
      color: var(--leji-accent);
      border-color: var(--leji-accent);
   }
   nav a[aria-current='page'] {
      color: var(--leji-accent);
   }

   /* Reference dropdown */
   .nav-group {
      position: relative;
      display: inline-flex;
   }
   /* chevron rotates down to read as a dropdown, fully on open */
   .caret {
      display: inline-block;
      font-size: 1.15em;
      transform: rotate(90deg);
      transition: transform 0.15s;
   }
   .nav-group:hover .caret,
   .nav-group:focus-within .caret {
      transform: rotate(270deg);
   }
   .nav-menu {
      position: absolute;
      top: calc(100% + 0.7rem);
      left: 0;
      min-width: 10rem;
      display: none;
      flex-direction: column;
      gap: 0.15rem;
      padding: 0.5rem;
      background: var(--leji-surface);
      border: 1px solid var(--leji-border);
      border-radius: 10px;
      box-shadow: 0 14px 34px rgba(24, 61, 59, 0.24);
      z-index: 30;
   }
   /* keep the menu open while crossing the gap from trigger to menu */
   .nav-group:hover::after {
      content: '';
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: 0.7rem;
   }
   .nav-group:hover .nav-menu,
   .nav-group:focus-within .nav-menu {
      display: flex;
   }
   .nav-menu a {
      color: var(--leji-text-body);
      text-transform: none;
      letter-spacing: 0.01em;
      font-size: 0.82rem;
      padding: 0.4rem 0.7rem;
      border-radius: 5px;
      border-bottom: none;
   }
   .nav-menu a:hover {
      color: var(--leji-text);
      background: rgba(0, 159, 113, 0.06);
      border-color: transparent;
   }

   @media (prefers-reduced-motion: reduce) {
      .bars,
      .bars::before,
      .bars::after,
      .site-header-band,
      .site-header-band.flush::before {
         transition: none;
      }
   }

   /* Mobile: collapse the nav behind the hamburger. Placed last so these rules
      win on source order (media queries add no specificity). */
   @media (max-width: 830px) {
      .nav-toggle {
         display: inline-flex;
      }
      nav {
         display: none;
         flex-basis: 100%;
         flex-direction: column;
         align-items: stretch;
         gap: 0;
         padding-top: 0.4rem;
      }
      nav[data-open] {
         display: flex;
      }
      /* No rules between rows: the stack reads as one menu, and a per-row border
         collides with the hover underline nav a already carries. */
      nav > a,
      .nav-trigger {
         width: 100%;
         padding: 0.75rem 0;
      }
      /* Colour alone carries the state here. The desktop hover underline spans the
         full row once the link is full-width, which reads as a divider rather than
         an underline, and touch leaves it stuck on after a tap. */
      nav a:hover {
         border-color: transparent;
      }
      .nav-group {
         display: block;
         width: 100%;
      }
      .caret {
         display: none;
      }
      /* Except the selector's. The nav triggers lose their caret because their
         children are laid out open below them here; the selector is still a
         closed disclosure at this width, so it keeps the one affordance that
         says so. Everything else about it is unchanged: it stays beside the
         logo, and its panel stays a panel. */
      .locale-select .caret {
         display: inline-block;
      }
      /* Reference children as an indented sub-list, always visible on touch */
      .nav-menu {
         position: static;
         display: flex;
         min-width: 0;
         padding: 0.1rem 0 0.5rem 1.1rem;
         background: transparent;
         border: none;
         border-radius: 0;
         box-shadow: none;
      }
      .nav-menu a {
         color: var(--white-soft);
         text-transform: uppercase;
         letter-spacing: 0.08em;
         font-size: 0.72rem;
         padding: 0.5rem 0;
      }
      .nav-menu a:hover {
         color: var(--leji-accent);
         background: transparent;
      }
      /* The flush header borrows the monument's background, but the band only
         reserves --header-h behind it: one collapsed row. An open menu is several
         times that, so the overflow would fall on the page background and the
         white-soft links would sit on the canvas, unreadable. Paint our own while open. */
      .site-header-band.flush:has(nav[data-open]) {
         background: var(--leji-deep);
      }
   }
</style>

<script>
   const band = document.querySelector<HTMLElement>('.site-header-band');
   if (band) {
      // Only the flush header reads these, but the state is the band's either way.
      // Synced on load as well as on scroll: an anchor lands the page pre-scrolled.
      // Two stages, because the band's ground and its mint line answer to
      // different things: the ground guards against content showing through, so
      // it lands as soon as anything can scroll under the band; the line marks
      // the monument's bottom edge passing under it. Without a monument there is
      // no such edge, so the line follows the ground.
      const monument = document.querySelector('.monument');
      const isPastHero = monument
         ? () => monument.getBoundingClientRect().bottom <= band.offsetHeight
         : () => window.scrollY > 0;
      const sync = () => {
         band.toggleAttribute('data-stuck', window.scrollY > 0);
         band.toggleAttribute('data-past-hero', isPastHero());
      };
      sync();
      window.addEventListener('scroll', sync, { passive: true });
   }

   const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
   const nav = document.getElementById('site-nav');

   if (toggle && nav) {
      const close = () => {
         nav.removeAttribute('data-open');
         toggle.setAttribute('aria-expanded', 'false');
      };
      const open = () => {
         nav.setAttribute('data-open', '');
         toggle.setAttribute('aria-expanded', 'true');
      };

      toggle.addEventListener('click', () => {
         nav.hasAttribute('data-open') ? close() : open();
      });

      // tapping a destination closes the menu
      nav.addEventListener('click', (e) => {
         if ((e.target as HTMLElement).closest('a')) close();
      });

      // Escape closes; focus returns to the toggle
      document.addEventListener('keydown', (e) => {
         if (e.key === 'Escape' && nav.hasAttribute('data-open')) {
            close();
            toggle.focus();
         }
      });

      // crossing back to the desktop layout resets state
      const desktop = window.matchMedia('(min-width: 831px)');
      desktop.addEventListener('change', (e) => {
         if (e.matches) close();
      });
   }
</script>
