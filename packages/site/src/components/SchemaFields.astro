---
// Generated field reference for a JSON Schema (two levels deep, $defs resolved); single-sourced so reference and contract agree.
//
// The tree comes from the projection rather than from a walk of its own, so what this
// draws and what a translation must carry are one answer: a page in another language
// hands in the localized schema and reads its own words for the chrome around it.
import { schemaLabels } from '../data/i18n';
import { localeOf } from '../i18n';
import { type FieldType, type ProjectedField, schemaProjection } from '../schema-i18n';

const { schema } = Astro.props;

const labels = schemaLabels(localeOf(Astro.url.pathname));
const fields: ProjectedField[] = schemaProjection(schema).fields;

// A type is either the schema's own tokens, printed as published, or a phrase in the
// page's language framing them.
const typeText = (type: FieldType): string =>
   'literal' in type ? type.literal : labels[type.key].replace('{values}', type.values ?? '');

// A description is written for the schema file, where a name in backticks is source
// rather than prose, so the pairs are drawn as code here instead of printing as
// themselves. A backtick with no partner is text, which is what keeps a fence marker
// (```mermaid) literal. Every segment stays an escaped text child, never set:html, so
// nothing a description contains can be markup.
const segments = (text: string) => {
   const out: { part: string; code: boolean }[] = [];
   const span = /`([^`]+)`/g;
   let plain = 0;
   for (let m = span.exec(text); m; m = span.exec(text)) {
      if (m.index > plain) out.push({ part: text.slice(plain, m.index), code: false });
      out.push({ part: m[1], code: true });
      plain = m.index + m[0].length;
   }
   if (plain < text.length) out.push({ part: text.slice(plain), code: false });
   return out;
};
---

<dl class="field-list">
   {
      fields.map((f) => (
         <>
            <dt id={f.name}>
               <a class="anchor" href={`#${f.name}`} aria-label={labels.linkTo.replace('{name}', f.name)}>
                  #
               </a>
               <code class="fname">{f.name}</code>
               <span class="ftype">{typeText(f.type)}</span>
               {f.required && (
                  <span class="req" title={labels.required}>
                     {labels.required}
                  </span>
               )}
            </dt>
            <dd>
               {f.text && <p class="fdesc">{segments(f.text).map((s) => (s.code ? <code>{s.part}</code> : s.part))}</p>}
               {f.pattern && (
                  <p class="pattern">
                     {labels.pattern} <code>{f.pattern}</code>
                  </p>
               )}
               {f.shared && (
                  <div class="object-body shared-shape">
                     <p class="shared-note">{labels.sharedShape}</p>
                     {f.shared.map((c) => (
                        <div class="subfield">
                           <div class="subfield-head">
                              <code class="fname">{c.name}</code>
                              <span class="ftype">{typeText(c.type)}</span>
                              {c.required && <span class="req">{labels.required}</span>}
                           </div>
                           {c.text && (
                              <p class="subdesc">
                                 {segments(c.text).map((p) => (p.code ? <code>{p.part}</code> : p.part))}
                              </p>
                           )}
                        </div>
                     ))}
                  </div>
               )}
               {f.children.length > 0 && (
                  <div class="object-body">
                     {f.children.map((s) => (
                        <div class="subfield">
                           <div class="subfield-head">
                              <code class="fname">{s.name}</code>
                              <span class="ftype">{typeText(s.type)}</span>
                              {s.required && <span class="req">{labels.required}</span>}
                           </div>
                           {s.text && (
                              <p class="subdesc">
                                 {segments(s.text).map((p) => (p.code ? <code>{p.part}</code> : p.part))}
                              </p>
                           )}
                           {s.children.length > 0 && (
                              <div class="object-body nested">
                                 {s.children.map((g) => (
                                    <div class="subfield">
                                       <div class="subfield-head">
                                          <code class="fname">{g.name}</code>
                                          <span class="ftype">{typeText(g.type)}</span>
                                          {g.required && <span class="req">{labels.required}</span>}
                                       </div>
                                       {g.text && (
                                          <p class="subdesc">
                                             {segments(g.text).map((p) => (p.code ? <code>{p.part}</code> : p.part))}
                                          </p>
                                       )}
                                    </div>
                                 ))}
                              </div>
                           )}
                        </div>
                     ))}
                  </div>
               )}
            </dd>
         </>
      ))
   }
</dl>

<style>
   /* Set off by spacing and indentation, not boxes or rules. */
   .field-list {
      margin: 1.8rem 0 0;
   }

   .field-list dt {
      position: relative;
      margin-top: 2.5rem;
      display: flex;
      align-items: baseline;
      gap: 0.55rem;
      flex-wrap: wrap;
      scroll-margin-top: calc(var(--header-h) + 1.5rem);
   }
   .field-list > dt:first-of-type {
      margin-top: 0.6rem;
   }
   .fname {
      font-family: var(--mono);
      background: none;
      padding: 0;
   }
   .field-list dt > .fname {
      font-size: 1.02rem;
      font-weight: 600;
      color: var(--leji-text);
      letter-spacing: -0.01em;
   }

   /* the deep-link anchor sits in the gutter, revealed on hover/focus */
   .anchor {
      position: absolute;
      left: -1.15rem;
      top: 0;
      font-family: var(--mono);
      font-weight: 600;
      /* Link green, not brand green: the brand measures 3.2:1 on the canvas, and
         this is an interactive control, not decoration. */
      color: var(--leji-link);
      text-decoration: none;
      opacity: 0;
      transition: opacity 0.15s;
   }
   .field-list dt:hover .anchor,
   .anchor:focus-visible {
      opacity: 1;
   }
   /* Narrow screens hide it visually, but a keyboard user must still be able to
      reach and see it, so it returns on focus rather than being display:none. */
   @media (max-width: 560px) {
      .anchor {
         opacity: 0;
         pointer-events: none;
      }
      .anchor:focus-visible {
         opacity: 1;
         pointer-events: auto;
      }
   }

   .ftype {
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--leji-text-body);
      white-space: nowrap;
   }
   /* An enum type reads best on one line, but the longest of them is 484px wide
      and nowrap made the whole page scroll sideways on a phone. Below the point
      where it stops fitting, let it wrap instead. */
   @media (max-width: 640px) {
      .ftype {
         white-space: normal;
      }
   }

   .req {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.11em;
      text-transform: uppercase;
      color: var(--leji-ink-on-accent);
      background: var(--leji-accent);
      border-radius: 999px;
      padding: 0.12rem 0.5rem;
      transform: translateY(-0.06em);
   }

   .field-list dd {
      margin: 0.5rem 0 0;
   }
   .fdesc {
      margin: 0;
      max-width: var(--measure);
   }
   .pattern {
      font-size: 0.85rem;
      color: var(--leji-text-body);
      margin: 0.5rem 0 0;
   }
   .pattern code {
      font-size: 0.82em;
   }

   /* nesting tightens with depth: leaf fields sit close, only sub-objects get air */
   .object-body {
      margin-top: 0.8rem;
      padding-left: 1.4rem;
   }
   .object-body.nested {
      margin-top: 0.4rem;
   }
   .object-body > .subfield {
      margin-top: 1.5rem;
   }
   .object-body.nested > .subfield {
      margin-top: 0.5rem;
   }
   .object-body > .subfield:first-child,
   .object-body.nested > .subfield:first-child {
      margin-top: 0;
   }
   .shared-note {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--leji-text-body);
      margin: 0 0 0.6rem;
   }
   .subfield-head {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      flex-wrap: wrap;
   }
   .subfield-head > .fname {
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--leji-link);
   }
   .object-body.nested > .subfield > .subfield-head > .fname {
      font-size: 0.88rem;
      font-weight: 550;
   }
   .subdesc {
      margin: 0.3rem 0 0;
      color: var(--leji-text-body);
      max-width: var(--measure);
   }
</style>
