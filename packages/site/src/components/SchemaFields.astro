---
// Generated field reference for a JSON Schema (two levels deep, $defs resolved); single-sourced so reference and contract agree.
const { schema } = Astro.props;

function resolve(prop: any): any {
   if (prop?.$ref) {
      const def = prop.$ref.split('/').pop();
      return schema.$defs?.[def] ?? prop;
   }
   return prop;
}

// Type column shows the resolved JSON Schema type ($refs resolved to their target's type).
function typeOf(prop: any): string {
   if (!prop) return 'value';
   if (prop.$ref) return typeOf(resolve(prop));
   if (prop.enum) return prop.enum.map((v: string) => `"${v}"`).join(' · ');
   if (prop.type === 'array') {
      const items = resolve(prop.items ?? {});
      if (items.enum) return `array of ${items.enum.map((v: string) => `"${v}"`).join(' · ')}`;
      if (items.properties || items.type === 'object') return 'array of objects';
      // The fallback is already plural; pluralizing it again rendered "itemss".
      return items.type ? `array of ${items.type}s` : 'array of items';
   }
   if (prop.patternProperties) return 'map';
   return prop.type ?? 'value';
}

function childrenOf(prop: any, depth: number): any[] {
   if (depth <= 0) return [];
   const target = prop.type === 'array' ? resolve(prop.items ?? {}) : resolve(prop);
   const req = new Set(target.required ?? []);
   return Object.entries(target.properties ?? {}).map(([name, sub]: [string, any]) => ({
      name,
      type: typeOf(sub),
      description: sub.description ?? '',
      required: req.has(name),
      // Which shared definition this entry points at, so siblings that all reuse
      // one $def can render its shape once instead of once each.
      ref: sub.$ref ?? null,
      children: childrenOf(sub, depth - 1),
   }));
}

/**
 * Siblings that all resolve to the same `$def` describe one shape, not several.
 * Rendering each in full repeats that shape verbatim per sibling: the five
 * category entries all point at `categoryMapping`, so its `indexes` description
 * was emitted five times. Hoist the shared shape and keep each sibling's own
 * description, which is the part that actually differs.
 */
function hoistSharedShape(sub: any[]): { sub: any[]; shared: any[] | null } {
   const refs = sub.map((s) => s.ref);
   const allSame = sub.length > 1 && refs[0] && refs.every((r) => r === refs[0]);
   const haveChildren = sub.every((s) => s.children.length > 0);
   if (!allSame || !haveChildren) return { sub, shared: null };
   return { sub: sub.map((s) => ({ ...s, children: [] })), shared: sub[0].children };
}

const required = new Set(schema.required ?? []);
const fields = Object.entries(schema.properties ?? {})
   .filter(([name]) => name !== '$schema')
   .map(([name, prop]: [string, any]) => ({
      name,
      required: required.has(name),
      type: typeOf(prop),
      description: prop.description ?? '',
      pattern: prop.pattern,
      ...hoistSharedShape(childrenOf(prop, 2)),
   }));
---

<dl class="field-list">
   {
      fields.map((f) => (
         <>
            <dt id={f.name}>
               <a class="anchor" href={`#${f.name}`} aria-label={`Link to ${f.name}`}>
                  #
               </a>
               <code class="fname">{f.name}</code>
               <span class="ftype">{f.type}</span>
               {f.required && (
                  <span class="req" title="required">
                     required
                  </span>
               )}
            </dt>
            <dd>
               {f.description && <p class="fdesc">{f.description}</p>}
               {f.pattern && (
                  <p class="pattern">
                     Pattern <code>{f.pattern}</code>
                  </p>
               )}
               {f.shared && (
                  <div class="object-body shared-shape">
                     <p class="shared-note">Each key below takes the same shape:</p>
                     {f.shared.map((c: any) => (
                        <div class="subfield">
                           <div class="subfield-head">
                              <code class="fname">{c.name}</code>
                              <span class="ftype">{c.type}</span>
                              {c.required && <span class="req">required</span>}
                           </div>
                           {c.description && <p class="subdesc">{c.description}</p>}
                        </div>
                     ))}
                  </div>
               )}
               {f.sub.length > 0 && (
                  <div class="object-body">
                     {f.sub.map((s) => (
                        <div class="subfield">
                           <div class="subfield-head">
                              <code class="fname">{s.name}</code>
                              <span class="ftype">{s.type}</span>
                              {s.required && <span class="req">required</span>}
                           </div>
                           {s.description && <p class="subdesc">{s.description}</p>}
                           {s.children.length > 0 && (
                              <div class="object-body nested">
                                 {s.children.map((g: any) => (
                                    <div class="subfield">
                                       <div class="subfield-head">
                                          <code class="fname">{g.name}</code>
                                          <span class="ftype">{g.type}</span>
                                          {g.required && <span class="req">required</span>}
                                       </div>
                                       {g.description && <p class="subdesc">{g.description}</p>}
                                    </div>
                                 ))}
                              </div>
                           )}
                        </div>
                     ))}
                  </div>
               )}
            </dd>
         </>
      ))
   }
</dl>

<style>
   /* Set off by spacing and indentation, not boxes or rules. */
   .field-list {
      margin: 1.8rem 0 0;
   }

   .field-list dt {
      position: relative;
      margin-top: 2.5rem;
      display: flex;
      align-items: baseline;
      gap: 0.55rem;
      flex-wrap: wrap;
      scroll-margin-top: calc(var(--header-h) + 1.5rem);
   }
   .field-list > dt:first-of-type {
      margin-top: 0.6rem;
   }
   .fname {
      font-family: var(--mono);
      background: none;
      padding: 0;
   }
   .field-list dt > .fname {
      font-size: 1.02rem;
      font-weight: 600;
      color: var(--leji-text);
      letter-spacing: -0.01em;
   }

   /* the deep-link anchor sits in the gutter, revealed on hover/focus */
   .anchor {
      position: absolute;
      left: -1.15rem;
      top: 0;
      font-family: var(--mono);
      font-weight: 600;
      /* Link green, not brand green: the brand measures 2.7:1 on the canvas, and
         this is an interactive control, not decoration. */
      color: var(--leji-link);
      text-decoration: none;
      opacity: 0;
      transition: opacity 0.15s;
   }
   .field-list dt:hover .anchor,
   .anchor:focus-visible {
      opacity: 1;
   }
   /* Narrow screens hide it visually, but a keyboard user must still be able to
      reach and see it, so it returns on focus rather than being display:none. */
   @media (max-width: 560px) {
      .anchor {
         opacity: 0;
         pointer-events: none;
      }
      .anchor:focus-visible {
         opacity: 1;
         pointer-events: auto;
      }
   }

   .ftype {
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--leji-text-body);
      white-space: nowrap;
   }
   /* An enum type reads best on one line, but the longest of them is 484px wide
      and nowrap made the whole page scroll sideways on a phone. Below the point
      where it stops fitting, let it wrap instead. */
   @media (max-width: 640px) {
      .ftype {
         white-space: normal;
      }
   }

   .req {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.11em;
      text-transform: uppercase;
      color: var(--leji-text);
      background: var(--leji-accent);
      border-radius: 999px;
      padding: 0.12rem 0.5rem;
      transform: translateY(-0.06em);
   }

   .field-list dd {
      margin: 0.5rem 0 0;
   }
   .fdesc {
      margin: 0;
      max-width: var(--measure);
   }
   .pattern {
      font-size: 0.85rem;
      color: var(--leji-text-body);
      margin: 0.5rem 0 0;
   }
   .pattern code {
      font-size: 0.82em;
   }

   /* nesting tightens with depth: leaf fields sit close, only sub-objects get air */
   .object-body {
      margin-top: 0.8rem;
      padding-left: 1.4rem;
   }
   .object-body.nested {
      margin-top: 0.4rem;
   }
   .object-body > .subfield {
      margin-top: 1.5rem;
   }
   .object-body.nested > .subfield {
      margin-top: 0.5rem;
   }
   .object-body > .subfield:first-child,
   .object-body.nested > .subfield:first-child {
      margin-top: 0;
   }
   .shared-note {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--leji-text-body);
      margin: 0 0 0.6rem;
   }
   .subfield-head {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      flex-wrap: wrap;
   }
   .subfield-head > .fname {
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--leji-link);
   }
   .object-body.nested > .subfield > .subfield-head > .fname {
      font-size: 0.88rem;
      font-weight: 550;
   }
   .subdesc {
      margin: 0.3rem 0 0;
      color: var(--leji-text-body);
      max-width: var(--measure);
   }
</style>
