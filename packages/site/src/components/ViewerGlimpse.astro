---
// The viewer window in the hero: what `leji view` shows for the layer the terminal
// beside it has just created. Decorative and aria-hidden (the terminal stays the
// accessible content), but not invented: the sidebar and the page in it are the two
// files `leji export` writes for that layer, copied into src/data/hero-glimpse/ and
// read here, so no document, group or count is typed into this markup. The SDK's
// site-hero test fails when the generator's output moves away from those copies, and
// test/hero-glimpse.test.ts fails when the reading of them moves.
//
// Two things here are ours rather than the generator's, and both are why this is a
// glimpse and not a screenshot. The window is a miniature: one --g-scale below sizes
// every rule in it, so the whole sidebar and the whole map fit a terminal-sized pane.
// And the map's geometry (box sizes, rows, connectors) is drawn by hand from the
// mermaid text in the pinned file, because mermaid lays out at render time and this
// is static. The labels and counts on it are the file's.
//
// Folders render the way the viewer paints them on arrival: closed, with their
// documents in the markup and hidden, which is exactly what the viewer's collapse
// plugin does on a page that sits in no folder.
//
// The viewer's own typeface, at the two weights its chrome uses, is imported here and
// nowhere else: nothing outside this window renders in it.
import '@fontsource/source-sans-pro/400.css';
import '@fontsource/source-sans-pro/600.css';
import icon from '../assets/leji-icon.svg?raw';
import sidebarMd from '../data/hero-glimpse/_sidebar.md?raw';
import overviewMd from '../data/hero-glimpse/overview.md?raw';
import { parseOverview, parseSidebar, type MapNode } from '../lib/hero-glimpse.ts';

const sidebar = parseSidebar(sidebarMd);
const overview = parseOverview(overviewMd);
/** The map as the pinned file declares it: one root, and the categories that hang off
 * it by one edge each. The parser proves that shape or refuses the file, so the
 * drawing below can follow it instead of taking it on trust. */
const { root, categories } = overview.map;

/** `code` and **emphasis** in the seeded prose, the way the viewer renders them. */
type Token = { kind: 'text' | 'code' | 'strong'; text: string };
const inline = (prose: string): Token[] =>
   prose
      .split(/(`[^`]+`|\*\*[^*]+\*\*)/g)
      .filter((part) => part !== '')
      .map((part): Token => {
         if (part.startsWith('`')) return { kind: 'code', text: part.slice(1, -1) };
         if (part.startsWith('**')) return { kind: 'strong', text: part.slice(2, -2) };
         return { kind: 'text', text: part };
      });

// Map geometry, in the SVG's own units. A box is sized to its caption because the
// generated labels differ in length, the way mermaid sizes them. One connector is
// drawn per parsed edge, which is one per category: the parser rejects a map where
// that is not true, rather than letting this drawing quietly stand in for another.
const NODE_H = 26;
const ROW_GAP = 12;
const COL_X = 132;
const PAD_X = 9;
const CHAR_W = 4.9;
const caption = (node: MapNode): string => (node.count === '' ? node.label : `${node.label} · ${node.count}`);
const boxWidth = (node: MapNode): number => Math.round(PAD_X * 2 + [...caption(node)].length * CHAR_W);
const rowY = (index: number): number => index * (NODE_H + ROW_GAP);
const mapH = categories.length * NODE_H + (categories.length - 1) * ROW_GAP;
const mapW = COL_X + Math.max(...categories.map(boxWidth));
const rootW = boxWidth(root);
const rootY = (mapH - NODE_H) / 2;
---

<div class="glimpse" aria-hidden="true">
   <aside class="g-side">
      <div class="g-search">Search the context layer…</div>
      <div class="g-brand"><span class="g-mark" set:html={icon} /><span class="g-name">{overview.title}</span></div>
      <ul class="g-pins">
         {sidebar.pins.map((pin) => <li>{pin}</li>)}
      </ul>
      <hr class="g-hr" />
      <ul class="g-nav">
         {
            sidebar.groups.map((group) => (
               <li class="g-folder">
                  <span class="g-tri">▶</span>
                  <span class="g-label">{group.label}</span>
                  <ul class="g-sub">
                     {group.entries.map((entry) => (
                        <li>{entry}</li>
                     ))}
                  </ul>
               </li>
            ))
         }
      </ul>
      {
         sidebar.drawer && (
            <>
               <hr class="g-hr" />
               <ul class="g-nav">
                  <li class="g-folder">
                     <span class="g-tri">▶</span>
                     <span class="g-label">{sidebar.drawer.label}</span>
                     <ul class="g-sub">
                        {sidebar.drawer.entries.map((entry) => (
                           <li>{entry}</li>
                        ))}
                     </ul>
                  </li>
               </ul>
            </>
         )
      }
   </aside>

   <section class="g-main">
      {sidebar.drawer && <div class="g-cat">{sidebar.drawer.label}</div>}
      <h3 class="g-h1">{overview.title}</h3>
      {
         overview.paragraphs.map((prose) => (
            <p class="g-p">
               {inline(prose).map((token) =>
                  token.kind === 'code' ? (
                     <code>{token.text}</code>
                  ) : token.kind === 'strong' ? (
                     <strong>{token.text}</strong>
                  ) : (
                     token.text
                  ),
               )}
            </p>
         ))
      }

      <svg class="g-map" viewBox={`0 0 ${mapW + 2} ${mapH}`} role="presentation" preserveAspectRatio="xMinYMid meet">
         <defs>
            <marker
               id="lj-glimpse-arrow"
               viewBox="0 0 8 8"
               refX="7"
               refY="4"
               markerWidth="5"
               markerHeight="5"
               orient="auto"
            >
               <path d="M0 1 L7 4 L0 7 z"></path>
            </marker>
         </defs>
         <g class="g-edge" fill="none">
            {
               categories.map((_, index) => (
                  <path
                     d={`M${rootW} ${rootY + NODE_H / 2} L${COL_X - 6} ${rowY(index) + NODE_H / 2}`}
                     marker-end="url(#lj-glimpse-arrow)"
                  />
               ))
            }
         </g>
         <g class="g-box">
            <rect x="0" y={rootY} width={rootW} height={NODE_H} rx="1"></rect>
            <text x={PAD_X} y={rootY + NODE_H / 2 + 3.4}>{caption(root)}</text>
            {
               categories.map((node, index) => (
                  <>
                     <rect x={COL_X} y={rowY(index)} width={boxWidth(node)} height={NODE_H} rx="1" />
                     <text x={COL_X + PAD_X} y={rowY(index) + NODE_H / 2 + 3.4}>
                        {caption(node)}
                     </text>
                  </>
               ))
            }
         </g>
      </svg>

      <p class="g-powered">Powered by <span class="g-spark">✦</span> <strong>Leji</strong></p>
   </section>
</div>

<style>
   /* The viewer's own tones, as literal values rather than the site's tokens: this
      window is a render of another product's chrome sitting inside the hero, and it
      must not move when the site's palette does. Base 15px is the viewer's body size,
      so every rule below can be written in the viewer's own ems and the whole window
      scales on one number. */
   .glimpse {
      --g-scale: 0.57;
      --v-page: #ffffff;
      --v-canvas: #f7f8f5;
      --v-border: #cde5d9;
      --v-ink: #183b32;
      --v-body: #4d5b56;
      --v-chip: #e8f4ee;
      --v-accent: #009f71;
      --v-link: #007d59;
      --v-line: #666666;
      --v-sans: 'Source Sans Pro', 'Helvetica Neue', Arial, sans-serif;
      --v-mono: 'Roboto Mono', Monaco, courier, monospace;

      position: absolute;
      inset: 0;
      display: grid;
      grid-template-columns: 20em 1fr;
      background: var(--v-page);
      color: var(--v-body);
      font-family: var(--v-sans);
      font-size: calc(15px * var(--g-scale));
      line-height: 1.7;
      overflow: hidden;
      text-align: left;
   }

   .g-side {
      background: var(--v-canvas);
      border-right: 1px solid var(--v-border);
      padding: 0.8em 1.2em 1em;
      min-width: 0;
   }
   .g-search {
      background: var(--v-page);
      border-radius: 0.4em;
      padding: 0.5em 0.7em;
      color: var(--v-body);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
   }
   .g-brand {
      display: flex;
      align-items: center;
      gap: 0.45em;
      margin: 1.1em 0 0.9em;
   }
   .g-mark :global(svg) {
      display: block;
      width: 1.7em;
      height: auto;
   }
   .g-name {
      font-weight: 600;
      font-size: 1.6em;
      line-height: 1.2;
      color: var(--v-accent);
   }
   .g-pins,
   .g-nav,
   .g-sub {
      list-style: none;
      margin: 0;
      padding: 0;
   }
   .g-pins li {
      font-weight: 500;
      padding: 0.14em 0;
      white-space: nowrap;
   }
   .g-hr {
      border: 0;
      border-top: 1px solid var(--v-border);
      margin: 1.05em 0;
   }
   .g-folder {
      display: flex;
      align-items: baseline;
      gap: 0.5em;
      padding: 0.14em 0;
      white-space: nowrap;
   }
   .g-tri {
      font-size: 0.55em;
      color: #aaaaaa;
   }
   .g-label {
      font-weight: 600;
      color: var(--v-ink);
   }
   /* The documents are in the markup and hidden, which is where the viewer leaves
      them until the folder is opened. */
   .g-sub {
      display: none;
   }

   .g-main {
      position: relative;
      padding: 1.4em 1.8em 1em;
      min-width: 0;
   }
   .g-cat {
      position: absolute;
      top: 0.8em;
      right: 0.9em;
      background: var(--v-canvas);
      border: 1px solid var(--v-border);
      border-radius: 999px;
      padding: 0.2em 0.66em;
      font-size: 0.75em;
      line-height: 1.5;
      color: var(--v-body);
   }
   .g-h1 {
      font-size: 2.13em;
      font-weight: 600;
      line-height: 1.2;
      color: var(--v-ink);
      margin: 0.4em 0 0.6em;
   }
   .g-p {
      margin: 0 0 1em;
      color: var(--v-body);
      max-width: 46em;
   }
   .g-p strong {
      font-weight: 600;
      color: var(--v-ink);
   }
   .g-p code {
      font-family: var(--v-mono);
      font-size: 0.85em;
      background: var(--v-chip);
      color: var(--v-link);
      border-radius: 2px;
      padding: 0.2em 0.33em;
   }

   .g-map {
      display: block;
      width: 100%;
      max-width: 25em;
      height: auto;
      margin-top: 0.4em;
   }
   .g-edge path {
      stroke: var(--v-line);
      stroke-width: 1;
   }
   .g-map marker path {
      fill: var(--v-line);
   }
   .g-box rect {
      fill: var(--v-accent);
      stroke: #165644;
      stroke-width: 0.5;
   }
   .g-box text {
      fill: #1a1a1a;
      font-family: var(--v-sans);
      font-size: 9px;
   }

   .g-powered {
      position: absolute;
      right: 1.1em;
      bottom: 0.7em;
      margin: 0;
      font-size: 0.75em;
      color: var(--v-body);
   }
   .g-powered strong,
   .g-spark {
      color: var(--v-link);
      font-weight: 600;
   }
</style>
