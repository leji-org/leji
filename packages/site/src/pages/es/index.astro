---
// Spanish translation of src/pages/index.astro. The English page is the page of
// record; `source` is its git blob sha at the revision this translation follows.
import { Code } from 'astro:components';
import Base from '../../layouts/Base.astro';
import HeroMark from '../../components/HeroMark.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import AnimatedTerminal from '../../components/AnimatedTerminal.astro';
import ViewerGlimpse from '../../components/ViewerGlimpse.astro';
import InstallTabs from '../../components/InstallTabs.astro';
import TranslationNote from '../../components/TranslationNote.astro';
import { translationStrings } from '../../data/i18n';
import githubIcon from '../../assets/github.svg?raw';
import lejiSyntaxTheme from '../../styles/shiki-leji.json';

const source = '36bcf47882672f4531a8db2ca978572968ea09f3';
const strings = translationStrings('es');

// Captured verbatim from a real run, so it stays exactly as captured: a repo with
// an existing docs/ tree and an AGENTS.md, `leji adopt --yes --wire-adapters`,
// then validate and conformance.
// The fixture is `fixture()` in packages/sdk/test/site-hero.test.ts: that test runs
// the same three commands against the built CLI and compares what it prints to the
// lines below, so the transcript is re-captured where the CLI's output moves.
const heroSession = [
   { cmd: 'leji adopt --yes --wire-adapters' },
   { out: 'Wrote 16 files (context root: docs/):' },
   { out: '   .leji/work/onboarding-brief.md   AGENTS.md   docs/agents/core.md   …', mark: 'dim' },
   { gap: true },
   { cmd: 'leji validate' },
   { out: 'ok (0 errors, 0 warnings)', mark: 'ok' },
   { gap: true },
   { cmd: 'leji conformance' },
   { out: 'ok (0 errors, 0 warnings; claimedLevel: core, verifiedLevel: core, processAttested: 4)', mark: 'ok' },
];

// What the hero's `adopt` wrote: the manifest of the very layer the transcript
// above creates. The panel leaves out the `$schema` pointer and the `claimedAt`
// date, and the same test compares everything else to the fixture's leji.json.
const peekJson = `{
  "leji": "1.0",
  "name": "acme-billing-context",
  "description": "Shared context layer for this repository.",
  "rootPath": "docs/",
  "bootProfilePath": "docs/boot-profile.md",
  "categories": {
    "domain": { "indexes": ["docs/context/domain.md"] },
    "system": { "indexes": ["docs/context/system.md"] },
    "governance": { "indexes": ["docs/context/governance.md"] },
    "decisions": { "indexes": ["docs/context/decisions.md"] }
  },
  "owners": { "primary": { "name": "Acme Platform Team", "contact": "platform@acme.example" } },
  "conformance": { "claimedLevel": "core" },
  "vendorAdapters": ["AGENTS.md"]
}`;
---

<Base
   lang="es"
   title="Leji: la capa de contexto compartida para equipos nativos de IA"
   description="Leji es una especificación abierta para una capa de contexto compartida, versionada y propiedad del repositorio, que leen personas y agentes de IA, con cada cambio gobernado mediante revisión."
>
   <!-- The banner sits outside <main>, but the monument band still has to start above
        it so the gradient, glow and fluting run unbroken behind the header. -->
   <SiteHeader flush />
   <main id="content">
      <div class="monument">
         <div class="wrap">
            <section class="hero">
               <div class="hero-text">
                  <p class="kicker reveal r1">
                     <span>/LEH-jee/</span><i class="sep" aria-hidden="true">◆</i><span
                        >Especificación y utillaje abiertos</span
                     >
                  </p>
                  <!-- "legible" is the name: Leji, from legible, per the /LEH-jee/ kicker above.
                       Spanish keeps the wordplay: "legible" is the same word. -->
                  <h1 class="reveal r2">Haga su contexto<br /><span class="gild">legible.</span></h1>
                  <div class="carved-rule reveal r2" aria-hidden="true"></div>
                  <p class="lede reveal r3">
                     Leji reúne la intención dispersa entre los chats del equipo y las instrucciones de cada herramienta
                     en un único lugar: una capa de contexto compartida que pertenece al equipo y que este revisa.
                     Estandariza la forma y la gobernanza, no el contenido. Personas y agentes ahora pueden leer la
                     misma fuente, y el utillaje de validación hace visible la desviación.
                  </p>
                  <div class="cta reveal r4">
                     <a class="btn solid" href="/es/quickstart/">Inicio rápido</a>
                     <a class="btn ghost" href="/es/spec/">Lea la especificación</a>
                  </div>
                  <div class="hero-note reveal r4">
                     <TranslationNote strings={strings.note} href="/" />
                  </div>
               </div>

               <div class="hero-proof reveal r5">
                  <AnimatedTerminal
                     lines={heroSession}
                     title="acme-billing"
                     glimpseTitle="leji view  ·  acme-billing-context"
                     label="Una sesión real de Leji: adoptar un repositorio existente, validarlo y puntuarlo"
                  >
                     <HeroMark slot="brand" size={64} loop />
                     <ViewerGlimpse slot="glimpse" />
                     <InstallTabs slot="footer" />
                  </AnimatedTerminal>
                  <p class="hero-license">
                     <a class="oss-link" href="https://github.com/leji-org/leji" target="_blank" rel="noopener">
                        <span class="gh-icon" set:html={githubIcon} /><span class="free">Libre y de código abierto</span
                        >
                     </a>&ensp;·&ensp;Apache-2.0&ensp;·&ensp;CC-BY-4.0
                  </p>
               </div>
            </section>
         </div>
      </div>

      <div class="levels-band">
         <div class="wrap">
            <section class="levels">
               <p class="eyebrow is-kicker">Adopción, no migración</p>
               <h2 class="section-title levels-title">Empiece por el repositorio que ya tiene.</h2>
               <p class="levels-lede">
                  La CLI genera el andamiaje de una capa de contexto sobre el árbol que ya tiene. Nada se mueve, y un
                  punto de entrada solo cambia cuando usted lo pide con <code>--wire-adapters</code>.
               </p>
               <ol class="adopt-flow">
                  <li class="adopt-step">
                     <span class="step-when">Primero</span>
                     <h3>Genera el andamiaje alrededor de su árbol</h3>
                     <p>
                        <code>adopt</code> reutiliza su raíz de documentación, siembra los archivos de índice de categoría
                        y copia a la capa de contexto lo que ya dice su punto de entrada de agente. Nada de lo que usted escribió
                        se mueve, y ningún punto de entrada se reescribe hasta que lo pide con <code
                           >--wire-adapters</code
                        >.
                     </p>
                  </li>
                  <li class="adopt-step">
                     <span class="step-when">Después</span>
                     <h3>Su agente propone el mapeo</h3>
                     <p>
                        El brief de incorporación hace que su agente lea el repositorio y proponga qué documentos
                        corresponden a cada categoría. Usted revisa esa propuesta como cualquier otro cambio.
                     </p>
                  </li>
                  <li class="adopt-step">
                     <span class="step-when">En adelante</span>
                     <h3>Y gobierna desde ahí</h3>
                     <p>
                        Los cambios pasan por el proceso de revisión y aprobación de su repositorio. La validación en
                        integración continua detecta la desviación, y los horizontes de vigencia señalan el contexto que
                        ha envejecido.
                     </p>
                  </li>
               </ol>
            </section>
         </div>
      </div>

      <div class="wrap">
         <section class="surfaces">
            <p class="eyebrow is-kicker">La leen las personas, la alcanzan los agentes</p>
            <h2 class="section-title surfaces-title">Una fuente, dos&nbsp;audiencias.</h2>
            <p class="surfaces-lede">
               Un registro de cómo piensa su equipo, propiedad del repositorio: lenguaje del dominio, restricciones,
               decisiones, convenciones y salvaguardas para los agentes. Una sola fuente, modificada a través de un
               único proceso de revisión y aprobación.
            </p>
            <div class="chart">
               <div class="chart-source">
                  <span class="chart-source-name">Capa de contexto compartida</span>
                  <span class="chart-source-tag">se cambia mediante revisión</span>
               </div>
               <svg class="chart-fork" viewBox="0 0 40 100" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 50 H20 M20 23 V77 M20 23 H40 M20 77 H40"></path>
               </svg>
               <div class="chart-surfaces">
                  <article class="surface">
                     <p class="surface-label">Para las personas</p>
                     <p class="surface-body">
                        Cualquiera del equipo puede leer la misma capa de contexto que se indica a los agentes.{' '}
                        <code>leji view</code>{' '}
                        abre la <strong>capa de contexto compartida</strong>, presentada de forma legible en el
                        navegador.
                     </p>
                  </article>
                  <article class="surface">
                     <p class="surface-label">Para los agentes</p>
                     <p class="surface-body">
                        Los agentes entran por el <a href="/es/spec/boot-profile/">perfil de arranque</a>, el único
                        archivo que dice qué cargar antes de una tarea; los archivos de punto de entrada (<code
                           >AGENTS.md</code
                        >, <code>CLAUDE.md</code>) redirigen allí en vez de llevar su propia copia. El <strong
                           >servidor MCP</strong
                        > les entrega la especificación y los esquemas y les permite <a href="/es/mcp/"
                           >validarla y puntuar la conformidad</a
                        > de forma nativa.
                     </p>
                  </article>
               </div>
            </div>
         </section>
      </div>

      <div class="levels-band">
         <div class="wrap">
            <section class="levels">
               <p class="eyebrow is-kicker">Conformidad</p>
               <h2 class="section-title levels-title">Declare un nivel y después compruébelo.</h2>
               <p class="levels-lede">
                  Cuatro niveles acumulativos, definidos por los requisitos implantados y no por una madurez
                  autoevaluada. La mayoría de los equipos llegan a{' '}
                  <code>governed</code> y se quedan ahí. La CLI comprueba lo que puede comprobar una máquina; de lo demás
                  responde su equipo.
               </p>
               <ol class="ladder">
                  <li>
                     <span class="rung-tag">core</span>
                     <strong class="rung-cap">Contexto compartido del equipo</strong>
                     <span
                        >manifiesto, perfil de arranque, contenido real, una primera decisión y un responsable con
                        nombre.</span
                     >
                  </li>
                  <li>
                     <span class="rung-tag">indexed</span>
                     <strong class="rung-cap">Legible para el utillaje</strong>
                     <span>un índice generado y un registro de cambios legible por máquinas.</span>
                  </li>
                  <li>
                     <span class="rung-tag">governed</span>
                     <strong class="rung-cap">Revisado, con la desviación comprobada</strong>
                     <span
                        >revisión por pull request, perfiles de agente, integración continua y horizontes de vigencia
                        comprobados.</span
                     >
                  </li>
                  <li>
                     <span class="rung-tag">federated</span>
                     <strong class="rung-cap">Práctica de toda la organización</strong>
                     <span
                        >un montaje fijado en otros repositorios, con informe de fijaciones desactualizadas.{' '}
                        <a href="/es/federation/">Cómo funciona la federación.</a></span
                     >
                  </li>
               </ol>
               <aside class="standard-note">
                  <span class="standard-note-label">Sin requisitos comerciales</span>
                  <p>
                     Todos los niveles son alcanzables solo con la especificación abierta y el utillaje de referencia.
                     La conformidad nunca exige un producto o servicio comercial, incluidos los del propio custodio.
                  </p>
               </aside>
            </section>
         </div>
      </div>

      <div class="why-band">
         <div class="wrap">
            <p class="eyebrow is-kicker on-dark">Por qué está construido así</p>
            <h2 class="section-title levels-title">
               Intención duradera, compartida en círculo, verificada mediante&nbsp;mecanismos.
            </h2>
            <section class="theses">
               <article class="thesis">
                  <span class="thesis-num">I.</span>
                  <div class="thesis-body">
                     <h3>La intención antes que las instrucciones</h3>
                     <p>
                        La intención duradera corresponde a una única capa de contexto revisada, de la que personas y
                        agentes derivan sus acciones. Los puntos de entrada de proveedor redirigen allí, de modo que el
                        contexto de un <a href="/es/ai-native/">equipo nativo de IA</a> sobrevive a cualquier herramienta.{
                           ' '
                        }
                        <a href="/es/rationale/#la-intención-antes-que-las-instrucciones">Por qué dura la intención.</a>
                     </p>
                  </div>
               </article>
               <article class="thesis">
                  <span class="thesis-num">II.</span>
                  <div class="thesis-body">
                     <h3>Un círculo, no un escalafón</h3>
                     <p>
                        Persona-a-persona, persona-a-IA y persona-a-IA-a-persona son flujos de primera clase alrededor
                        de una capa de contexto compartida. Todos leen, cualquiera propone y las personas aprueban
                        mediante pull requests.{' '}
                        <a href="/es/rationale/#un-círculo-no-un-escalafón">Por qué funciona el círculo.</a>
                     </p>
                  </div>
               </article>
               <article class="thesis">
                  <span class="thesis-num">III.</span>
                  <div class="thesis-body">
                     <h3>Mecanismo antes que buena voluntad</h3>
                     <p>
                        La realidad cambia y el contexto compartido se degrada. La revisión de código, las
                        comprobaciones automáticas de desviación y los horizontes de vigencia sistematizan el
                        mantenimiento; el contexto desactualizado nunca se trata en silencio como si estuviera vigente.{
                           ' '
                        }
                        <a href="/es/rationale/#por-qué-esto-no-es-un-wiki">Por qué importan los mecanismos.</a>
                     </p>
                  </div>
               </article>
            </section>
         </div>
      </div>

      <div class="wrap">
         <section class="manifest-peek">
            <div class="peek-text">
               <p class="eyebrow is-kicker">El punto de entrada para máquinas</p>
               <h2 class="section-title">Un solo archivo de manifiesto</h2>
               <p>
                  Su árbol <code>docs/</code> existente es conforme por <em>mapeo</em>, no por renombrado. Un único{' '}
                  <code>leji.json</code> en la raíz del repositorio declara la raíz del contexto, el perfil de arranque, las
                  asignaciones de categoría y la declaración de conformidad.
               </p>
               <p>
                  La capa de contexto más limpia no necesita archivos de proveedor en absoluto: la invocación apunta el
                  host de agente directamente al perfil de arranque, o <code>leji start</code> abre allí un host detectado.
               </p>
               <p>
                  Los archivos de punto de entrada son punteros, no lugares donde guardar el contexto. <code
                     >AGENTS.md</code
                  > es el puntero portable que leen muchos hosts de agente; la <a href="/es/adoption/"
                     >guía de adopción</a
                  > cubre el resto.
               </p>
               <p class="peek-more"><a href="/es/manifest/">Referencia del manifiesto →</a></p>
            </div>
            <div class="peek-code">
               <Code code={peekJson} lang="json" theme={lejiSyntaxTheme} wrap />
            </div>
         </section>
      </div>
   </main>
   <SiteFooter />
</Base>

<style>
   .monument {
      --grain: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='160'%20height='160'%3E%3Cfilter%20id='n'%3E%3CfeTurbulence%20type='fractalNoise'%20baseFrequency='0.8'%20numOctaves='2'%20stitchTiles='stitch'/%3E%3CfeColorMatrix%20type='saturate'%20values='0'/%3E%3C/filter%3E%3Crect%20width='100%25'%20height='100%25'%20filter='url(%23n)'/%3E%3C/svg%3E");
      position: relative;
      overflow: hidden;
      color: var(--leji-ink-on-deep);
      /* Depth, three layers deep: the linear runs deepest at both ends and opens
         to --leji-deep across the middle, so the band frames itself; a mint wash
         lights the top where the headline sits; and the brand green, centred
         below the band's own edge, lifts the ground under the terminal the way
         the retired composition lifted it from below. */
      background:
         radial-gradient(120% 80% at 50% -20%, var(--leji-hero-glow-mint), transparent 55%),
         radial-gradient(90% 60% at 50% 118%, var(--leji-hero-glow-brand), transparent 60%),
         linear-gradient(180deg, var(--leji-deepest) 0%, var(--leji-deep) 32%, var(--leji-deepest) 100%);
      padding-bottom: clamp(3.5rem, 8vh, 6rem);
      /* The banner is a sibling above this band, not a child, so <main> can be the
         page's landmark. Pull the band up behind it and pad the same amount back, so
         the gradient, glow and fluting are continuous under the header.
         --header-h is the header row's height, defined in global.css. */
      margin-top: calc(-1 * var(--header-h));
      padding-top: var(--header-h);
   }
   /* stone grain */
   .monument::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: var(--grain);
      background-size: 160px 160px;
      opacity: 0.07;
      mix-blend-mode: overlay;
      pointer-events: none;
      z-index: 0;
   }
   /* engraved fluting */
   .monument::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: repeating-linear-gradient(90deg, transparent 0 78px, rgba(112, 216, 194, 0.05) 78px 79px);
      pointer-events: none;
      z-index: 0;
   }
   .monument > * {
      position: relative;
      z-index: 1;
   }
   .hero {
      padding: clamp(2.6rem, 8vh, 5.5rem) 0 clamp(1.5rem, 4vh, 3rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.06fr);
      gap: clamp(2.2rem, 5vw, 4.5rem);
      align-items: start;
   }
   @media (max-width: 900px) {
      .hero {
         grid-template-columns: 1fr;
         gap: 2.6rem;
         max-width: 680px;
      }
   }
   .hero-text {
      min-width: 0;
   }

   .kicker {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--leji-accent);
      margin: 0 0 1.3rem;
   }
   .kicker .sep {
      font-style: normal;
      font-size: 0.5rem;
      color: var(--leji-accent);
      opacity: 0.7;
      transform: translateY(-1px);
   }

   h1 {
      font-family: var(--serif-display);
      font-variation-settings: 'opsz' 144;
      font-weight: 460;
      font-size: clamp(2.4rem, 5.2vw, 4.05rem);
      line-height: 1.06;
      letter-spacing: -0.02em;
      color: var(--leji-ink-on-deep);
      margin: 0;
      max-width: 30ch;
   }

   /* The one word the headline turns on: mint against white, with the glow that
      makes it read as lit rather than merely coloured. */
   .gild {
      position: relative;
      white-space: nowrap;
      color: var(--leji-accent);
      font-style: italic;
      font-variation-settings: 'opsz' 144;
      text-shadow: 0 0 34px rgba(112, 216, 194, 0.4);
   }

   .carved-rule {
      width: 92px;
      height: 2px;
      margin: 1.7rem 0 0;
      background: linear-gradient(90deg, var(--leji-accent), rgba(112, 216, 194, 0.05));
      border-radius: 2px;
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.25);
   }

   .hero-note {
      max-width: 50ch;
      margin: 1.6rem 0 0;
   }
   .hero-note :global(.translation-note) {
      margin: 0;
      padding: 0.8rem 1.1rem;
      border-left-color: var(--leji-accent);
      background: rgba(255, 255, 255, 0.06);
      font-size: 0.86rem;
      color: var(--white-soft);
   }
   .hero-note :global(.translation-note a) {
      color: var(--leji-accent);
      text-decoration-color: var(--leji-accent-rule);
   }
   .hero-note :global(.translation-note a:hover) {
      text-decoration-color: var(--leji-accent);
   }

   .lede {
      font-family: var(--serif-text);
      font-size: clamp(1.04rem, 1.5vw, 1.17rem);
      line-height: 1.72;
      color: var(--white-soft);
      max-width: 50ch;
      margin: 1.7rem 0 2.1rem;
   }
   .lede strong {
      color: var(--leji-ink-on-deep);
      font-weight: 600;
   }
   .lede code {
      font-size: 0.84em;
      color: var(--white-strong);
      background: rgba(255, 255, 255, 0.09);
      border: 1px solid rgba(112, 216, 194, 0.22);
      padding: 0.06em 0.36em;
      border-radius: 4px;
   }
   .lede a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: rgba(112, 216, 194, 0.35);
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
      transition:
         color 0.15s ease,
         text-decoration-color 0.15s ease;
   }
   .lede a:hover {
      color: var(--leji-accent);
      text-decoration-color: var(--leji-accent);
   }

   .cta {
      display: flex;
      gap: 0.9rem;
      flex-wrap: wrap;
   }
   .hero-license {
      margin: 1.1rem 0 0;
      padding-left: 1.4rem;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      color: var(--white-faint);
   }
   .hero-license .oss-link {
      display: inline-flex;
      align-items: center;
      gap: 0.45em;
      color: var(--leji-accent);
      text-decoration: none;
   }
   .hero-license .gh-icon {
      display: inline-flex;
      color: var(--leji-ink-on-deep);
   }
   .hero-license .gh-icon :global(svg) {
      display: block;
      height: 1.05em;
      width: auto;
   }
   .hero-license .free {
      color: var(--leji-accent);
      text-transform: uppercase;
      letter-spacing: 0.12em;
   }
   .hero-license .oss-link:hover .free {
      text-decoration: underline;
      text-decoration-color: var(--leji-accent);
      text-underline-offset: 3px;
   }
   .btn {
      font-family: var(--mono);
      font-size: 0.8rem;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 0.9rem 1.6rem;
      border-radius: 7px;
      transition:
         transform 0.16s ease,
         box-shadow 0.16s ease,
         background 0.16s ease,
         border-color 0.16s ease;
   }
   /* Primary CTA per the brand's own website mapping: brand green ground, white
      label. Flat, not a ramp: the green is saturated enough to hold the button on
      its own, and the shadow already gives it the lift. */
   .btn.solid {
      /* the accessible green ground carries white at 5.15:1 at any size; the
         vivid brand green is the hover moment. In dark the ground is the mint
         and the label the deep ink, and the hover ground lifts to hold it. */
      background: var(--leji-brand-dark);
      color: var(--leji-ink-on-cta);
      font-weight: 600;
      box-shadow:
         inset 0 1px 0 rgba(255, 255, 255, 0.45),
         0 10px 28px rgba(0, 159, 113, 0.32);
   }
   .btn.solid:hover {
      background: var(--leji-cta-hover);
      transform: translateY(-2px);
      box-shadow:
