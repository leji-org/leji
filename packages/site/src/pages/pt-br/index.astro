---
// Brazilian Portuguese translation of src/pages/index.astro. The English page is the
// page of record; `source` is its git blob sha at the revision this translation
// follows.
import { Code } from 'astro:components';
import Base from '../../layouts/Base.astro';
import HeroMark from '../../components/HeroMark.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import AnimatedTerminal from '../../components/AnimatedTerminal.astro';
import ViewerGlimpse from '../../components/ViewerGlimpse.astro';
import InstallTabs from '../../components/InstallTabs.astro';
import TranslationNote from '../../components/TranslationNote.astro';
import { translationStrings } from '../../data/i18n';
import githubIcon from '../../assets/github.svg?raw';
import lejiSyntaxTheme from '../../styles/shiki-leji.json';

const source = '7acbb9a072d2b6210d2cdb83e952c5b49666ba1f';
const strings = translationStrings('pt-br');

// Captured verbatim from a real run, so it stays exactly as captured.
// The fixture is `fixture()` in packages/sdk/test/site-hero.test.ts: that test runs
// the same three commands against the built CLI and compares what it prints to the
// lines below, so the transcript is re-captured where the CLI's output moves.
const heroSession = [
   { cmd: 'leji adopt --yes --wire-adapters' },
   { out: 'Wrote 16 files (context root: docs/):' },
   { out: '   .leji/work/onboarding-brief.md   AGENTS.md   docs/agents/core.md   …', mark: 'dim' },
   { gap: true },
   { cmd: 'leji validate' },
   { out: 'ok (0 errors, 0 warnings)', mark: 'ok' },
   { gap: true },
   { cmd: 'leji conformance' },
   { out: 'ok (0 errors, 0 warnings; claimedLevel: core, verifiedLevel: core, processAttested: 4)', mark: 'ok' },
];

// What the hero's `adopt` wrote: the manifest of the very layer the transcript
// above creates. The panel leaves out the `$schema` pointer and the `claimedAt`
// date, and the same test compares everything else to the fixture's leji.json.
const peekJson = `{
  "leji": "1.0",
  "name": "acme-billing-context",
  "description": "Shared context layer for this repository.",
  "rootPath": "docs/",
  "bootProfilePath": "docs/boot-profile.md",
  "categories": {
    "domain": { "indexes": ["docs/context/domain.md"] },
    "system": { "indexes": ["docs/context/system.md"] },
    "governance": { "indexes": ["docs/context/governance.md"] },
    "decisions": { "indexes": ["docs/context/decisions.md"] }
  },
  "owners": { "primary": { "name": "Acme Platform Team", "contact": "platform@acme.example" } },
  "conformance": { "claimedLevel": "core" },
  "vendorAdapters": ["AGENTS.md"]
}`;
---

<Base
   lang="pt-br"
   title="Leji: a camada de contexto compartilhada de equipes nativas de IA"
   description="Leji é uma especificação aberta para uma camada de contexto compartilhada, versionada e pertencente ao repositório, lida por pessoas e agentes de IA, com toda mudança governada por revisão."
>
   <!-- The banner sits outside <main>, but the monument band still has to start above
        it so the gradient, glow and fluting run unbroken behind the header. .monument
        pulls itself up by the header's height and pads the same amount back, and the
        header paints transparent on top. See --header-h below. -->
   <SiteHeader flush />
   <main id="content">
      <div class="monument">
         <div class="wrap">
            <section class="hero">
               <div class="hero-text">
                  <p class="kicker reveal r1">
                     <span>/LEH-jee/</span><i class="sep" aria-hidden="true">◆</i><span
                        >Especificação aberta e ferramentas</span
                     >
                  </p>
                  <!-- "legible" is the name: Leji, from legible, per the /LEH-jee/ kicker above. -->
                  <h1 class="reveal r2">Torne o seu<br />contexto <span class="gild">legível.</span></h1>
                  <div class="carved-rule reveal r2" aria-hidden="true"></div>
                  <p class="lede reveal r3">
                     Leji oferece um lugar próprio para a intenção que hoje fica escondida em conversas da equipe e em
                     instruções específicas de cada ferramenta: uma camada de contexto compartilhada, revisada e de
                     propriedade da sua equipe. Leji padroniza o formato e a governança, não o conteúdo. Pessoas e
                     agentes passam a ler a mesma fonte, e o conjunto de ferramentas de validação torna os desvios
                     visíveis.
                  </p>
                  <div class="cta reveal r4">
                     <a class="btn solid" href="/pt-br/quickstart/">Início rápido</a>
                     <a class="btn ghost" href="/pt-br/spec/">Ler a especificação</a>
                  </div>
                  <div class="hero-note reveal r4">
                     <TranslationNote strings={strings.note} href="/" />
                  </div>
               </div>

               <div class="hero-proof reveal r5">
                  <AnimatedTerminal
                     lines={heroSession}
                     title="acme-billing"
                     glimpseTitle="leji view  ·  acme-billing-context"
                     label="Uma sessão real do Leji: adotar um repositório existente, validá-lo, pontuá-lo"
                  >
                     <HeroMark slot="brand" size={64} loop />
                     <ViewerGlimpse slot="glimpse" />
                     <InstallTabs slot="footer" />
                  </AnimatedTerminal>
                  <p class="hero-license">
                     <a class="oss-link" href="https://github.com/leji-org/leji" target="_blank" rel="noopener">
                        <span class="gh-icon" set:html={githubIcon} /><span class="free">Livre e de código aberto</span>
                     </a>&ensp;·&ensp;Apache-2.0&ensp;·&ensp;CC-BY-4.0
                  </p>
               </div>
            </section>
         </div>
      </div>

      <div class="levels-band">
         <div class="wrap">
            <section class="levels">
               <p class="eyebrow is-kicker">Adoção, não migração</p>
               <h2 class="section-title levels-title">Comece pelo repositório que você já tem.</h2>
               <p class="levels-lede">
                  A CLI gera a estrutura de uma camada de contexto sobre a árvore existente. Nada muda de lugar, e os
                  pontos de entrada só são alterados quando você solicita isso com <code>--wire-adapters</code>.
               </p>
               <ol class="adopt-flow">
                  <li class="adopt-step">
                     <span class="step-when">Primeiro</span>
                     <h3>Gera a estrutura em torno da sua árvore</h3>
                     <p>
                        <code>adopt</code> reaproveita a raiz da sua documentação, cria os arquivos iniciais de índice por
                        categoria e copia para a camada de contexto as instruções que já estão no ponto de entrada do agente.
                        Nada do que você escreveu muda de lugar, e nenhum ponto de entrada é reescrito até que você peça com{
                           ' '
                        }
                        <code>--wire-adapters</code>.
                     </p>
                  </li>
                  <li class="adopt-step">
                     <span class="step-when">Depois</span>
                     <h3>O seu agente propõe o mapeamento</h3>
                     <p>
                        Com o roteiro de integração, seu agente lê o repositório e propõe a categoria de cada documento.
                        Você revisa essa proposta como faria com qualquer outra mudança.
                     </p>
                  </li>
                  <li class="adopt-step">
                     <span class="step-when">Daí em diante</span>
                     <h3>Governa a partir dali</h3>
                     <p>
                        As mudanças seguem o processo de revisão e aprovação do seu repositório. A validação no CI
                        detecta desvios, e os horizontes de atualidade sinalizam o contexto que envelheceu.
                     </p>
                  </li>
               </ol>
            </section>
         </div>
      </div>

      <div class="wrap">
         <section class="surfaces">
            <p class="eyebrow is-kicker">Lida por pessoas, acessada por agentes</p>
            <h2 class="section-title surfaces-title">Uma fonte, dois&nbsp;públicos.</h2>
            <p class="surfaces-lede">
               Um registro pertencente ao repositório que mostra como a sua equipe pensa: linguagem do domínio,
               restrições, decisões, convenções e travas de proteção para agentes. Uma única fonte, alterada por um só
               processo de revisão e aprovação.
            </p>
            <div class="chart">
               <div class="chart-source">
                  <span class="chart-source-name">Camada de contexto compartilhada</span>
                  <span class="chart-source-tag">alterada por revisão</span>
               </div>
               <svg class="chart-fork" viewBox="0 0 40 100" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 50 H20 M20 23 V77 M20 23 H40 M20 77 H40"></path>
               </svg>
               <div class="chart-surfaces">
                  <article class="surface">
                     <p class="surface-label">Para pessoas</p>
                     <p class="surface-body">
                        Qualquer pessoa da equipe pode consultar a mesma camada de contexto indicada aos agentes. <code
                           >leji view</code
                        >{' '}
                        abre a <strong>camada de contexto compartilhada</strong>, apresentada de forma legível por
                        humanos no navegador.
                     </p>
                  </article>
                  <article class="surface">
                     <p class="surface-label">Para agentes</p>
                     <p class="surface-body">
                        Os agentes entram pelo <a href="/pt-br/spec/boot-profile/">perfil de boot</a>, o único arquivo
                        que diz o que carregar antes de uma tarefa; os arquivos de ponto de entrada (<code
                           >AGENTS.md</code
                        >,{' '}
                        <code>CLAUDE.md</code>) redirecionam para lá em vez de carregar a própria cópia. O <strong
                           >servidor MCP</strong
                        > fornece a eles a especificação e os schemas e permite que <a href="/pt-br/mcp/"
                           >validem a camada e pontuem a conformidade</a
                        > nativamente.
                     </p>
                  </article>
               </div>
            </div>
         </section>
      </div>

      <div class="levels-band">
         <div class="wrap">
            <section class="levels">
               <p class="eyebrow is-kicker">Conformidade</p>
               <h2 class="section-title levels-title">Declare um nível e depois verifique-o.</h2>
               <p class="levels-lede">
                  São quatro níveis cumulativos, avaliados pelo que está em funcionamento, não por uma percepção de
                  maturidade. A maioria das equipes chega a{' '}
                  <code>governed</code> e para por aí. A CLI verifica o que pode ser conferido por máquina; a sua equipe responde
                  pelo restante.
               </p>
               <ol class="ladder">
                  <li>
                     <span class="rung-tag">core</span>
                     <strong class="rung-cap">Contexto compartilhado da equipe</strong>
                     <span>manifesto, perfil de boot, conteúdo real, uma primeira decisão, um dono nomeado.</span>
                  </li>
                  <li>
                     <span class="rung-tag">indexed</span>
                     <strong class="rung-cap">Legível para as ferramentas</strong>
                     <span>um índice gerado e um changelog legível por máquina.</span>
                  </li>
                  <li>
                     <span class="rung-tag">governed</span>
                     <strong class="rung-cap">Revisado, com desvio verificado</strong>
                     <span>revisão por pull request, perfis de agente, CI e horizontes de atualidade verificados.</span>
                  </li>
                  <li>
                     <span class="rung-tag">federated</span>
                     <strong class="rung-cap">Prática de alcance organizacional</strong>
                     <span
                        >um mount fixado em outros repositórios, com relato de pin desatualizado.{' '}
                        <a href="/pt-br/federation/">Como a federação funciona.</a></span
                     >
                  </li>
               </ol>
               <aside class="standard-note">
                  <span class="standard-note-label">Sem exigência comercial</span>
                  <p>
                     Todos os níveis podem ser alcançados apenas com a especificação aberta e as ferramentas de
                     referência. A conformidade nunca exige um produto ou serviço comercial, nem mesmo os da própria
                     curadora.
                  </p>
               </aside>
            </section>
         </div>
      </div>

      <div class="why-band">
         <div class="wrap">
            <p class="eyebrow is-kicker on-dark">Por que é construído assim</p>
            <h2 class="section-title levels-title">
               Intenção duradoura, compartilhada em um círculo e verificada por&nbsp;mecanismos.
            </h2>
            <section class="theses">
               <article class="thesis">
                  <span class="thesis-num">I.</span>
                  <div class="thesis-body">
                     <h3>Intenção acima de instruções</h3>
                     <p>
                        A intenção duradoura pertence a uma única camada de contexto revisada, da qual pessoas e agentes
                        derivam suas ações. Os pontos de entrada de fornecedor redirecionam para essa camada, portanto o
                        contexto de uma <a href="/pt-br/ai-native/">equipe nativa de IA</a> sobrevive a qualquer ferramenta.{
                           ' '
                        }
                        <a href="/pt-br/rationale/#intenção-acima-de-instruções">Por que a intenção dura.</a>
                     </p>
                  </div>
               </article>
               <article class="thesis">
                  <span class="thesis-num">II.</span>
                  <div class="thesis-body">
                     <h3>Um círculo, não um degrau</h3>
                     <p>
                        Humano para humano, humano para IA e humano para IA para humano são fluxos de primeira classe em
                        torno de uma única camada de contexto compartilhada. Todos leem, qualquer pessoa pode propor, e
                        pessoas aprovam por pull requests.{' '}
                        <a href="/pt-br/rationale/#um-círculo-não-um-degrau">Por que o círculo funciona.</a>
                     </p>
                  </div>
               </article>
               <article class="thesis">
                  <span class="thesis-num">III.</span>
                  <div class="thesis-body">
                     <h3>Mecanismo acima de boa vontade</h3>
                     <p>
                        A realidade muda e o contexto compartilhado se deteriora. A revisão de código, as verificações
                        mecânicas de desvio e os horizontes de atualidade transformam a manutenção em um processo
                        sistemático; o contexto desatualizado nunca é tratado silenciosamente como atual.{' '}
                        <a href="/pt-br/rationale/#por-que-isto-não-é-um-wiki">Por que os mecanismos importam.</a>
                     </p>
                  </div>
               </article>
            </section>
         </div>
      </div>

      <div class="wrap">
         <section class="manifest-peek">
            <div class="peek-text">
               <p class="eyebrow is-kicker">O ponto de entrada de máquina</p>
               <h2 class="section-title">Um arquivo de manifesto</h2>
               <p>
                  A árvore <code>docs/</code> que você já tem se torna conforme por <em>mapeamento</em>, não por
                  renomeação. Um único{' '}
                  <code>leji.json</code> na raiz do repositório declara a raiz do contexto, o perfil de boot, os mapeamentos
                  de categoria e a declaração de conformidade.
               </p>
               <p>
                  Uma camada de contexto enxuta não precisa de nenhum arquivo de fornecedor: a invocação direciona o
                  host de agente para o perfil de boot, ou <code>leji start</code> abre nesse ponto um host detectado.
               </p>
               <p>
                  Os arquivos de ponto de entrada funcionam como ponteiros, nunca como destino final. <code
                     >AGENTS.md</code
                  > é o ponteiro portátil que muitos hosts de agente leem; o <a href="/pt-br/adoption/"
                     >guia de adoção</a
                  > cobre o resto.
               </p>
               <p class="peek-more"><a href="/pt-br/manifest/">Referência do manifesto →</a></p>
            </div>
            <div class="peek-code">
               <Code code={peekJson} lang="json" theme={lejiSyntaxTheme} wrap />
            </div>
         </section>
      </div>
   </main>
   <SiteFooter />
</Base>

<style>
   .monument {
      --grain: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='160'%20height='160'%3E%3Cfilter%20id='n'%3E%3CfeTurbulence%20type='fractalNoise'%20baseFrequency='0.8'%20numOctaves='2'%20stitchTiles='stitch'/%3E%3CfeColorMatrix%20type='saturate'%20values='0'/%3E%3C/filter%3E%3Crect%20width='100%25'%20height='100%25'%20filter='url(%23n)'/%3E%3C/svg%3E");
      position: relative;
      overflow: hidden;
      color: var(--leji-surface);
      /* Depth, three layers deep: the linear runs deepest at both ends and opens
         to --leji-deep across the middle, so the band frames itself; a mint wash
         lights the top where the headline sits; and the brand green, centred
         below the band's own edge, lifts the ground under the terminal the way
         the retired composition lifted it from below. */
      background:
         radial-gradient(120% 80% at 50% -20%, rgba(112, 216, 194, 0.16), transparent 55%),
         radial-gradient(90% 60% at 50% 118%, rgba(0, 159, 113, 0.55), transparent 60%),
         linear-gradient(180deg, var(--leji-deepest) 0%, var(--leji-deep) 32%, var(--leji-deepest) 100%);
      padding-bottom: clamp(3.5rem, 8vh, 6rem);
      /* The banner is a sibling above this band, not a child, so <main> can be the
         page's landmark. Pull the band up behind it and pad the same amount back, so
         the gradient, glow and fluting are continuous under the header.
         --header-h is the header row's height, defined in global.css. */
      margin-top: calc(-1 * var(--header-h));
      padding-top: var(--header-h);
   }
   /* stone grain */
   .monument::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: var(--grain);
      background-size: 160px 160px;
      opacity: 0.07;
      mix-blend-mode: overlay;
      pointer-events: none;
      z-index: 0;
   }
   /* engraved fluting */
   .monument::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: repeating-linear-gradient(90deg, transparent 0 78px, rgba(112, 216, 194, 0.05) 78px 79px);
      pointer-events: none;
      z-index: 0;
   }
   .monument > * {
      position: relative;
      z-index: 1;
   }
   .hero {
      padding: clamp(2.6rem, 8vh, 5.5rem) 0 clamp(1.5rem, 4vh, 3rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.06fr);
      gap: clamp(2.2rem, 5vw, 4.5rem);
      align-items: start;
   }
   @media (max-width: 900px) {
      .hero {
         grid-template-columns: 1fr;
         gap: 2.6rem;
         max-width: 680px;
      }
   }
   .hero-text {
      min-width: 0;
   }

   .kicker {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--leji-accent);
      margin: 0 0 1.3rem;
   }
   .kicker .sep {
      font-style: normal;
      font-size: 0.5rem;
      color: var(--leji-accent);
      opacity: 0.7;
      transform: translateY(-1px);
   }

   h1 {
      font-family: var(--serif-display);
      font-variation-settings: 'opsz' 144;
      font-weight: 460;
      font-size: clamp(2.4rem, 5.2vw, 4.05rem);
      line-height: 1.06;
      letter-spacing: -0.02em;
      color: var(--leji-surface);
      margin: 0;
      max-width: 30ch;
   }

   /* The one word the headline turns on: mint against white, with the glow that
      makes it read as lit rather than merely coloured. */
   .gild {
      position: relative;
      white-space: nowrap;
      color: var(--leji-accent);
      font-style: italic;
      font-variation-settings: 'opsz' 144;
      text-shadow: 0 0 34px rgba(112, 216, 194, 0.4);
   }

   .carved-rule {
      width: 92px;
      height: 2px;
      margin: 1.7rem 0 0;
      background: linear-gradient(90deg, var(--leji-accent), rgba(112, 216, 194, 0.05));
      border-radius: 2px;
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.25);
   }

   .hero-note {
      max-width: 50ch;
      margin: 1.6rem 0 0;
   }
   .hero-note :global(.translation-note) {
      margin: 0;
      padding: 0.8rem 1.1rem;
      border-left-color: var(--leji-accent);
      background: rgba(255, 255, 255, 0.06);
      font-size: 0.86rem;
      color: var(--white-soft);
   }
   .hero-note :global(.translation-note a) {
      color: var(--leji-accent);
      text-decoration-color: var(--leji-accent-rule);
   }
   .hero-note :global(.translation-note a:hover) {
      text-decoration-color: var(--leji-accent);
   }

   .lede {
      font-family: var(--serif-text);
      font-size: clamp(1.04rem, 1.5vw, 1.17rem);
      line-height: 1.72;
      color: var(--white-soft);
      max-width: 50ch;
      margin: 1.7rem 0 2.1rem;
   }
   .lede strong {
      color: var(--leji-surface);
      font-weight: 600;
   }
   .lede code {
      font-size: 0.84em;
      color: var(--white-strong);
      background: rgba(255, 255, 255, 0.09);
      border: 1px solid rgba(112, 216, 194, 0.22);
      padding: 0.06em 0.36em;
      border-radius: 4px;
   }
   .lede a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: rgba(112, 216, 194, 0.35);
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
      transition:
         color 0.15s ease,
         text-decoration-color 0.15s ease;
   }
   .lede a:hover {
      color: var(--leji-accent);
      text-decoration-color: var(--leji-accent);
   }

   .cta {
      display: flex;
      gap: 0.9rem;
      flex-wrap: wrap;
   }
   .hero-license {
      margin: 1.1rem 0 0;
      padding-left: 1.4rem;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      color: var(--white-faint);
   }
   .hero-license .oss-link {
      display: inline-flex;
      align-items: center;
      gap: 0.45em;
      color: var(--leji-accent);
      text-decoration: none;
   }
   .hero-license .gh-icon {
      display: inline-flex;
      color: var(--leji-surface);
   }
   .hero-license .gh-icon :global(svg) {
      display: block;
      height: 1.05em;
      width: auto;
   }
   .hero-license .free {
      color: var(--leji-accent);
      text-transform: uppercase;
      letter-spacing: 0.12em;
   }
   .hero-license .oss-link:hover .free {
      text-decoration: underline;
      text-decoration-color: var(--leji-accent);
      text-underline-offset: 3px;
   }
   .btn {
      font-family: var(--mono);
      font-size: 0.8rem;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 0.9rem 1.6rem;
      border-radius: 7px;
      transition:
         transform 0.16s ease,
         box-shadow 0.16s ease,
         background 0.16s ease,
         border-color 0.16s ease;
   }
   /* Primary CTA per the brand's own website mapping: brand green ground, white
      label. Flat, not a ramp: the green is saturated enough to hold the button on
      its own, and the shadow already gives it the lift. */
   .btn.solid {
      /* the accessible green ground carries white at 5.15:1 at any size; the
         vivid brand green is the hover moment */
      background: var(--leji-brand-dark);
      color: var(--leji-surface);
      font-weight: 600;
      box-shadow:
         inset 0 1px 0 rgba(255, 255, 255, 0.45),
         0 10px 28px rgba(0, 159, 113, 0.32);
   }
   .btn.solid:hover {
      background: var(--leji-brand);
