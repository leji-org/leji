---
import fs from 'node:fs';
import path from 'node:path';
import { Code } from 'astro:components';
import Doc from '../layouts/Doc.astro';
import SupportedRuntimes from '../components/SupportedRuntimes.astro';
import InstallTabs from '../components/InstallTabs.astro';
import lejiSyntaxTheme from '../styles/shiki-leji.json';

// Single-sourced from the SDK's CLI spec; `leji --help` renders from the same
// file, so this page and the tool cannot disagree.
const cli = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), '../../packages/sdk/cli.json'), 'utf-8'));
const slug = (name: string) => name.replace(/\s+/g, '-');

// Split inline `code` spans on backticks (odd segments are code). Segments stay
// escaped text children, never set:html.
const segments = (s: string) => s.split('`').map((part, i) => ({ part, code: i % 2 === 1 }));
---

<Doc
   kind="reference"
   title="CLI reference · Leji"
   description="The complete leji command reference, generated from the CLI's own specification: every command with its flags, exit codes, and examples."
>
   <h1>CLI reference</h1>
   <p class="sp-lede">{cli.summary}</p>
   <p>
      Install it in whichever runtime your toolchain or CI uses; the command surface is identical across all three.
      Every command takes <code>--root &lt;dir&gt;</code>; the reporting commands also emit machine-readable <code
         >--json</code
      >. The same spec generates both this reference and <code>leji --help</code>. Working through an agent? The same
      validation and conformance are available as <a href="/mcp/">MCP tools</a>.
   </p>

   <div class="runtimes-block">
      <SupportedRuntimes />
   </div>

   <div class="cli-install">
      <p class="cli-install-label">Install</p>
      <div class="cli-install-tabs"><InstallTabs /></div>
      <p class="cli-install-next">
         New to Leji? The <a href="/quickstart/">Quickstart</a> walks through installing, then scaffolding or adopting your
         first context layer.
      </p>
   </div>

   <div class="cli-code"><Code code={cli.usage} lang="bash" theme={lejiSyntaxTheme} /></div>

   <aside class="cli-onboarding">
      <h2>Agent onboarding</h2>
      <p>
         Bring a repository into a context layer.{' '}
         <a href="#adopt"><code>leji adopt</code></a> scaffolds a context layer around an existing repo and leaves its files
         in place (with <code>--wire-adapters</code> it converts existing <code>CLAUDE.md</code> /
         <code>AGENTS.md</code> entrypoints into one-line redirects); <a href="#init"><code>leji init</code></a> scaffolds
         a new one with an onboarding brief for your agent to fill; <a href="#detect"><code>leji detect</code></a> finds installed
         hosts, and <a href="#start"><code>leji start</code></a> opens one in the context layer. Preview <code
            >init</code
         > or <code>adopt</code> with <code>--dry-run</code>.
      </p>
   </aside>

   {
      cli.groups.map((g: any) => (
         <Fragment>
            <h2>{g.title}</h2>
            <table class="cli-table cmd-table">
               <tbody>
                  {cli.commands
                     .filter((c: any) => c.group === g.id)
                     .map((c: any) => (
                        <tr>
                           <td>
                              <a href={`#${slug(c.name)}`}>
                                 <code>{c.name}</code>
                              </a>
                           </td>
                           <td>
                              {c.aliasOf
                                 ? [
                                      'alias of ',
                                      <a href={`#${slug(c.aliasOf)}`}>
                                         <code>{c.aliasOf}</code>
                                      </a>,
                                   ]
                                 : segments(c.summary).map((s) => (s.code ? <code>{s.part}</code> : s.part))}
                           </td>
                        </tr>
                     ))}
               </tbody>
            </table>
         </Fragment>
      ))
   }

   <h2>Exit codes</h2>
   <table class="cli-table">
      <thead>
         <tr><th>Code</th><th>Meaning</th></tr>
      </thead>
      <tbody>
         {
            cli.exitCodes.map((e: any) => (
               <tr>
                  <td>
                     <code>{e.code}</code>
                  </td>
                  <td>{segments(e.meaning).map((s) => (s.code ? <code>{s.part}</code> : s.part))}</td>
               </tr>
            ))
         }
      </tbody>
   </table>

   <h2>Global options</h2>
   <table class="cli-table">
      <tbody>
         {
            cli.globalOptions.map((o: any) => (
               <tr>
                  <td>
                     <code>{o.flags}</code>
                  </td>
                  <td>{segments(o.summary).map((s) => (s.code ? <code>{s.part}</code> : s.part))}</td>
               </tr>
            ))
         }
      </tbody>
   </table>

   <h2 id="pinned-cli">The CLI a repository pins</h2>
   <p>
      Inside a repository that directly declares the Leji CLI and has it installed, with a copy that meets the layer's
      minimum, the installed <code>leji</code> runs that copy for every invocation, <code>--version</code> and <code
         >--help</code
      > included. Node finds it under <code>node_modules</code>; Python finds it in a project environment inside the
      repository (<code>.venv</code>, or uv's <code>UV_PROJECT_ENVIRONMENT</code>). So a person typing <code>leji</code
      >, the git hook, CI, and every teammate run one version of the tool, whatever each of them installed globally.
      Anything else runs the global CLI exactly as before.
   </p>
   <p>
      Set <code>LEJI_NO_LOCAL</code> to any value to run the global copy instead. The Go CLI does not hand off, because a
      Go repository's declared copy is built on demand by the toolchain rather than installed as an executable: run the pinned
      copy with <code>go tool leji</code>. Upgrading the Python CLI? An already-installed console script gains the
      hand-off after a reinstall, which rebakes the entry point.
   </p>

   {
      cli.commands.map((c: any) => (
         <section class="cmd">
            <h2 id={slug(c.name)}>
               <code>leji {c.name}</code>
            </h2>
            <p>{segments(c.description).map((s) => (s.code ? <code>{s.part}</code> : s.part))}</p>
            {c.details?.length > 0 && (
               <ul class="cmd-details">
                  {c.details.map((d: string) => (
                     <li>{segments(d).map((s) => (s.code ? <code>{s.part}</code> : s.part))}</li>
                  ))}
               </ul>
            )}
            <div class="cli-code">
               <Code code={c.usage} lang="bash" theme={lejiSyntaxTheme} />
            </div>
            {c.options.length > 0 && (
               <table class="cli-table">
                  <tbody>
                     {c.options.map((o: any) => (
                        <tr>
                           <td>
                              <code>{o.flags}</code>
                           </td>
                           <td>{segments(o.summary).map((s) => (s.code ? <code>{s.part}</code> : s.part))}</td>
                        </tr>
                     ))}
                  </tbody>
               </table>
            )}
            <p class="ex-label">{c.examples.length > 1 ? 'Examples' : 'Example'}</p>
            <div class="cli-code">
               <Code code={c.examples.join('\n')} lang="bash" theme={lejiSyntaxTheme} />
            </div>
         </section>
      ))
   }
</Doc>

<style>
   .cli-onboarding {
      margin: 1.8rem 0 0.6rem;
      padding: 1.1rem 1.3rem;
      border-left: 3px solid var(--leji-brand);
      background: var(--leji-accent-soft);
      border-radius: 0 8px 8px 0;
   }
   .cli-onboarding h2 {
      margin: 0 0 0.4rem;
      font-size: 1.1rem;
   }
   .cli-onboarding p {
      margin: 0;
      color: var(--leji-text-body);
   }

   /* command names styled like the schema links */
   .cmd-table td a code {
      color: var(--leji-link);
   }
   .cmd-table td a:hover code {
      background: rgba(0, 159, 113, 0.14);
   }

   .runtimes-block {
      margin-bottom: 1.2rem;
   }

   /* dark wrapper because InstallTabs is styled for a dark background */
   .cli-install {
      margin: 0 0 1.8rem;
   }
   .cli-install-label {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--leji-text-body);
      margin: 0 0 0.6rem;
   }
   .cli-install-tabs {
      background: var(--leji-deep);
      border-radius: 12px;
      box-shadow: 0 14px 40px rgba(24, 61, 59, 0.16);
      overflow: hidden;
   }
   .cli-install-next {
      margin: 0.9rem 0 0;
      color: var(--leji-text-body);
   }

   .cli-table {
      width: 100%;
      border-collapse: collapse;
      margin: 0.8rem 0 0;
   }
   .cli-table th {
      text-align: left;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--leji-text-body);
      padding: 0.4rem 0.9rem 0.4rem 0;
      border-bottom: 1px solid var(--leji-border);
   }
   .cli-table td {
      padding: 0.5rem 0.9rem 0.5rem 0;
      border-bottom: 1px solid var(--leji-border);
      vertical-align: top;
      color: var(--leji-text-body);
   }
   .cli-table td:first-child {
      white-space: nowrap;
   }
   .cli-table td code {
      color: var(--leji-text);
      font-size: 0.85em;
   }

   .cmd {
      margin-top: 2.6rem;
      padding-top: 0.4rem;
   }
   .cmd h2 {
      scroll-margin-top: calc(var(--header-h) + 1.5rem);
   }
   .cmd h2 code {
      color: var(--leji-text);
      background: none;
      padding: 0;
   }
   .cmd-details {
      margin: 0.9rem 0 0;
      padding: 0;
      list-style: none;
   }
   .cmd-details li {
      position: relative;
      padding-left: 1.1rem;
      margin: 0.5rem 0;
      color: var(--leji-text-body);
      line-height: 1.6;
   }
   .cmd-details li::before {
      content: '';
      position: absolute;
      left: 0.1rem;
      top: 0.62em;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--leji-brand);
   }
   .ex-label {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--leji-text-body);
      margin: 1.1rem 0 0;
   }
   .cli-code :global(.astro-code) {
      background: var(--leji-deep) !important;
      border-radius: 10px;
      padding: 1rem 1.2rem;
      font-size: var(--code-fz);
      line-height: 1.6;
      margin-top: 0.6rem;
   }
</style>
