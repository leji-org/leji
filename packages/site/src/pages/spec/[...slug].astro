---
import { getCollection, render } from 'astro:content';
import Doc from '../../layouts/Doc.astro';
import { SPEC_DOCS, specDocTitle, specPath } from '../../data/spec-docs';

export async function getStaticPaths() {
   const docs = await getCollection('spec');
   return docs.map((doc) => ({
      params: { slug: doc.id === 'readme' ? undefined : doc.id },
      props: { doc },
   }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const docTitle = specDocTitle(doc.id);
// Structured data must name the page as a reader sees it, so the headline comes
// from the document's own H1 rather than the sidebar label, which is sentence
// case for navigation and drifts from the frozen spec headings.
const h1 = /^#\s+(.+)$/m.exec(doc.body ?? '')?.[1]?.trim();
const headline = h1 ?? docTitle;
const title = `${docTitle} · Leji`;

const pageUrl = new URL(specPath(doc.id), Astro.site).href;
const description =
   doc.id === 'readme'
      ? 'The Leji specification: an open specification for the shared context layer of AI-native teams.'
      : `${docTitle}, part of the Leji specification for the shared context layer of AI-native teams.`;
const articleLd = {
   '@context': 'https://schema.org',
   '@type': 'TechArticle',
   name: headline,
   headline,
   description,
   url: pageUrl,
   inLanguage: 'en',
   isPartOf: { '@type': 'TechArticle', name: 'The Leji Specification', url: new URL('/spec/', Astro.site).href },
   // The steward node the sitewide graph defines in Base.astro. Leji is the
   // specification, not an organization; naming one here invented an entity.
   publisher: { '@id': 'https://leji.org/#organization' },
};

// The spec index calls these documents "in reading order", but a reader who
// finished one had to go back to the sidebar and remember which number they were
// on. The prose is frozen; the chrome is not.
const order = SPEC_DOCS.findIndex((d) => d.id === doc.id);
const prev = order > 0 ? SPEC_DOCS[order - 1] : null;
const next = order >= 0 && order < SPEC_DOCS.length - 1 ? SPEC_DOCS[order + 1] : null;
---

<Doc kind="normative" title={title} description={description} alternate={`/spec/${doc.id}.md`}>
   <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
   <Content />
   {
      (prev || next) && (
         <nav class="doc-seq" aria-label="Specification order">
            {prev ? (
               <a class="doc-seq-prev" href={specPath(prev.id)}>
                  <span>Previous</span>
                  {specDocTitle(prev.id)}
               </a>
            ) : (
               <span />
            )}
            {next && (
               <a class="doc-seq-next" href={specPath(next.id)}>
                  <span>Next</span>
                  {specDocTitle(next.id)}
               </a>
            )}
         </nav>
      )
   }
</Doc>
