---
import { getCollection } from 'astro:content';
import Doc from '../../layouts/Doc.astro';
import { SPEC_DOCS, specPath } from '../../data/spec-docs';
import { renderSpecSections } from '../../spec-full';

// One straight-through copy of the spec in canonical order; per-section anchors live on the individual documents.
const all = await getCollection('spec');
const byId = Object.fromEntries(all.map((d) => [d.id, d]));
const sections = await renderSpecSections(
   SPEC_DOCS.map(({ id, label }) => ({ id, label, href: specPath(id), body: byId[id].body ?? '' })),
);
---

<Doc
   kind="normative"
   title="The Leji Specification (one page) · Leji"
   alternate="/llms-full.txt"
   description="The complete Leji specification on one page: every normative document of the open specification for the shared context layer of AI-native teams."
>
   <div class="spec-full">
      <h1>The Leji Specification</h1>
      <p class="sp-lede">
         The complete normative specification on one page, in reading order, for reading straight through or searching.
         Each section links to its own page, where every heading carries a citation anchor.
      </p>

      <nav class="doc-toc onepage-toc" aria-label="Contents">
         <p class="toc-title">Contents</p>
         <ol>
            {
               sections.map((s) => (
                  <li>
                     <a href={`#sec-${s.id}`}>{s.label}</a>
                  </li>
               ))
            }
         </ol>
      </nav>

      {
         sections.map(({ id, label, href, html }) => (
            <section class="spec-section" id={`sec-${id}`}>
               <p class="sec-meta">
                  <a href={href}>{label} ↗</a>
               </p>
               <Fragment set:html={html} />
            </section>
         ))
      }
   </div>
</Doc>

<style>
   /* box chrome comes from the shared `.doc-toc`; ten sections read better in two */
   .onepage-toc ol {
      columns: 2;
      column-gap: 2rem;
   }
   .spec-section {
      scroll-margin-top: calc(var(--header-h) + 1.5rem);
      padding-top: 1.5rem;
      margin-top: 2.5rem;
      border-top: 1px solid var(--leji-border);
   }
   .spec-section:first-of-type {
      border-top: none;
      margin-top: 1.5rem;
   }
   .sec-meta {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin: 0 0 -0.6rem;
   }
   .sec-meta a {
      color: var(--leji-text-body);
      text-decoration: none;
   }
   .sec-meta a:hover {
      color: var(--leji-link);
   }
   /* the demoted h2 (was h1) reads as the section title on the consolidated page */
   .sec-meta + :global(h2) {
      font-family: var(--serif-display);
      font-weight: 580;
      font-size: 1.7rem;
      color: var(--leji-text);
      margin: 0.2rem 0 0.8rem;
   }
   /* the overview's own heading repeats the page title, so drop it here */
   .spec-section:first-of-type .sec-meta + :global(h2) {
      display: none;
   }
   /* hide per-heading anchors here: repeated ids would point at the first match;
      the section links above are the navigation path */
   .spec-full :global(a.heading-anchor) {
      display: none;
   }
</style>
