---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionNav from '../components/SectionNav.astro';
import SupportedRuntimes from '../components/SupportedRuntimes.astro';
import PageHeader from '../components/PageHeader.astro';
import InstallTabs from '../components/InstallTabs.astro';

const initCode = `leji adopt --dry-run    # the exact write plan; nothing is written
leji adopt              # adopt an existing repo (leji init for a new one)
                        # then offers to open Claude Code or Codex

leji adopt --wire-adapters  # adopt over an existing CLAUDE.md / AGENTS.md`;

const validateCode = `leji validate           # schemas + lint rules
leji validate --content # + placeholder / thin-content warnings
leji index              # generate the index`;

const conformanceCode = `leji conformance        # score the claim`;

const viewCode = `leji view               # open the human-readable viewer in your browser
leji viewer build       # export a static folder to host behind internal auth`;

const ciCode = `leji ci                 # generate the workflow
leji ci --hooks         # the same gates as a local pre-commit

# what the generated job runs:
leji validate           # schemas + lint rules
leji index --check      # stale index fails

# add at indexed and above:
leji changelog check    # append-only`;

const startCode = 'leji start              # or --agent claude-code | codex to pin one';

const apiCode = `import { validateLayer, writeIndex, conformanceReport } from '@leji-org/leji';

const { findings } = validateLayer('.');`;

const mcpCode = `# Claude Code (available in every project)
claude mcp add leji --scope user -- npx -y @leji-org/mcp

# Codex
codex mcp add leji -- npx -y @leji-org/mcp`;

// Structured data for the reference SDKs, so answer engines associate the
// packages with the specification.
const repo = 'https://github.com/leji-org/leji';
const sdkLd = {
   '@context': 'https://schema.org',
   '@graph': [
      {
         '@type': 'SoftwareSourceCode',
         name: '@leji-org/leji',
         description:
            'Reference SDK and CLI for Leji, the open specification for the shared context layer of AI-native teams (Node.js).',
         codeRepository: repo,
         programmingLanguage: 'TypeScript',
         runtimePlatform: 'Node.js',
         license: 'https://www.apache.org/licenses/LICENSE-2.0',
         url: 'https://www.npmjs.com/package/@leji-org/leji',
      },
      {
         '@type': 'SoftwareSourceCode',
         name: 'leji (Python)',
         description:
            'Reference SDK and CLI for Leji, the open specification for the shared context layer of AI-native teams (Python).',
         codeRepository: repo,
         programmingLanguage: 'Python',
         license: 'https://www.apache.org/licenses/LICENSE-2.0',
         url: 'https://pypi.org/project/leji/',
      },
      {
         '@type': 'SoftwareSourceCode',
         name: 'leji (Go)',
         description:
            'Reference SDK and CLI for Leji, the open specification for the shared context layer of AI-native teams (Go, single binary).',
         codeRepository: repo,
         programmingLanguage: 'Go',
         license: 'https://www.apache.org/licenses/LICENSE-2.0',
         url: 'https://pkg.go.dev/github.com/leji-org/leji/packages/sdk-go',
      },
   ],
};
---

<Base
   title="Quickstart · Leji"
   description="Quickstart: install the Leji CLI, bootstrap or map a context layer, validate it, and score it against the level it claims."
>
   <SiteHeader />
   <div class="wrap">
      <div class="doc-shell">
         <SectionNav current={Astro.url.pathname} />
         <main id="content" class="adopt-main measured">
            <section class="gs-hero">
               <PageHeader kind="guide" />
               <h1>Build a context layer, check it conforms.</h1>
               {
                  /* The steps below already name what the CLI does. The only thing this
                   line can add is what they cannot show: how long, and that it is offline. */
               }
               <p class="lede">
                  Five commands, install to conformance. Everything ships in the package, so it runs offline.
               </p>
            </section>

            <SupportedRuntimes />

            <section class="steps" aria-label="Quickstart steps">
               <article class="step">
                  <div class="step-text">
                     <h2><span class="step-num">01</span>Install the tooling</h2>
                     <p>
                        All three pass the same fixture suite, so flags, JSON output and exit codes are identical
                        whichever one your CI installs.
                     </p>
                     <p>
                        In a Node repository, add it as a devDependency (<code>npm i -D @leji-org/leji</code>) so CI,
                        the hook and every contributor run the pinned version.
                     </p>
                  </div>
                  <div class="step-install"><InstallTabs /></div>
               </article>

               <article class="step">
                  <div class="step-text">
                     <h2><span class="step-num">02</span>Bootstrap a new context layer, or adopt an existing repo</h2>
                     <p>
                        You get a <code>leji.json</code> manifest at the repository root, a boot profile, seeded category
                        documents, a first decision record, and an onboarding brief. None of it requires an agent.
                     </p>
                     <p>
                        The scaffold starts as placeholder. Accept the offer and the agent reads your repository,
                        proposes the mapping for you to approve, then deletes the brief. Decline and you get the command
                        to run later; <code>--yes</code> skips it, so CI stays unattended.
                     </p>
                     <p>
                        Working alone? <code>--mode solo</code> seeds identity and writing-style starters and points the brief
                        at an owner interview; answers can be typed, attached, or dropped in a folder. Only the synthesis
                        you approve becomes context, and your raw files never enter git: <code>init</code> and{' '}
                        <code>adopt</code> refuse to run while anything under <code>&lt;rootPath&gt;/.leji/</code> is tracked,
                        and the agent deletes the artifacts once the context layer is populated.
                     </p>
                     <aside class="map-note">
                        <strong>Already have a <code>docs/</code> tree?</strong>
                        <code>adopt</code> scaffolds alongside it and moves nothing. Your existing entrypoint is left untouched,
                        so until <code>--wire-adapters</code> runs you have an adoption draft rather than a conformant layer.
                     </aside>
                  </div>
                  <div class="step-code"><Code code={initCode} lang="bash" theme="night-owl" wrap /></div>
               </article>

               <article class="step">
                  <div class="step-text">
                     <h2><span class="step-num">03</span>Validate</h2>
                     <ul class="checks">
                        <li>
                           <strong>Schema-checked:</strong> the manifest, the index, the changelog, and agent-profile and
                           decision-record frontmatter.
                        </li>
                        <li>
                           <strong>Structure and lint:</strong> boot profiles, index files and ordinary documents have no
                           schema. Declared files must exist, and the changelog is append-only against{' '}
                           <code>HEAD</code>. At <code>indexed</code> and above, a stale index fails hard.
                        </li>
                     </ul>
                     <p class="fine">
                        After a plain <code>adopt</code> over an existing <code>CLAUDE.md</code> or <code
                           >AGENTS.md</code
                        >, expect one failure, <code>vendor-adapter-redirect</code>, until <code>--wire-adapters</code> runs.
                     </p>
                  </div>
                  <div class="step-code"><Code code={validateCode} lang="bash" theme="night-owl" wrap /></div>
               </article>

               <article class="step">
                  <div class="step-text">
                     <h2><span class="step-num">04</span>Claim a level, then check it</h2>
                     <p>
                        Partial adoption is by design: start at <code>core</code>, and each level contains the last. The
                        manifest declares the claim;{' '}
                        <code>leji conformance</code> scores the context layer against it.
                     </p>
                     <p class="ladder-line">
                        <code>core</code> → <code>indexed</code> → <code>governed</code> → <code>federated</code>
                     </p>
                     <p class="ladder-more">
                        <a href="/spec/conformance/">What each level asks of you</a>
                     </p>
                  </div>
                  <div class="step-code"><Code code={conformanceCode} lang="bash" theme="night-owl" wrap /></div>
               </article>

               <article class="step">
                  <div class="step-text">
                     <h2><span class="step-num">05</span>See your context layer</h2>
                     <p>The same layer your agents read, rendered for people.</p>
                  </div>
                  <div class="step-code"><Code code={viewCode} lang="bash" theme="night-owl" wrap /></div>
               </article>
            </section>

            <section class="duo">
               <div class="duo-cell">
                  <h2>Keep it honest in CI</h2>
                  <p>
                     The provider is inferred from your <code>origin</code> remote, falling back to GitHub when the remote
                     names none.
                  </p>
                  <Code code={ciCode} lang="bash" theme="night-owl" wrap />
                  <p class="fine">
                     Exit codes are CI-native: <code>0</code> clean, <code>1</code> findings, <code>2</code> usage error.
                  </p>
               </div>
               <div class="duo-cell">
                  <h2>Enter the context layer</h2>
                  <p>The layer becomes the agent's first context, with no vendor file in between.</p>
                  <Code code={startCode} lang="bash" theme="night-owl" wrap />
                  <p class="fine">
                     Several hosts detected? It asks. None detected, or a scripted / CI run? It prints the command to
                     run instead of guessing. The{' '}
                     <a href="/adoption/#put-it-to-work">adoption guide</a> covers host pass-through flags and the vendor-file
                     fallback table.
                  </p>
               </div>
            </section>

            <section class="mcp-block">
               <h2>Give your agent the tools, not just the context</h2>
               <p>
                  Entering the context layer gives your agent the context. The <a href="/mcp/">MCP server</a> gives it the
                  tooling: a local, read-only server that runs validation and conformance against the context layer on disk,
                  so the agent never needs a shell. It reads and reports; it never writes.
               </p>
               <Code code={mcpCode} lang="bash" theme="night-owl" wrap />
               <p class="fine">
                  <code>init</code> and <code>adopt</code> offer to register it for you: project-scoped for Claude Code, user-level
                  for Codex. The commands above are for anyone who skipped that prompt. Any MCP client works; the <a
                     href="/mcp/">MCP server</a
                  > page has the full tool list.
               </p>
            </section>

            <section class="shapes" aria-label="Adoption guides by situation">
               <h2>Then adopt for your situation</h2>
               <table class="shape-table">
                  <tbody>
                     <tr>
                        <th scope="row"><a href="/adoption/#where-it-lives">Monorepo</a></th>
                        <td>One repository, one context layer, initialized once at the repository root.</td>
                     </tr>
                     <tr>
                        <th scope="row"><a href="/adoption/#where-it-lives">Many repos, one layer</a></th>
                        <td>
                           A dedicated context repository, mounted docs-only in each consuming repo, pinned per
                           repository.
                        </td>
                     </tr>
                     <tr>
                        <th scope="row"><a href="/federation/">Several owned layers</a></th>
                        <td
                           >Teams that each already own a context layer. Mount each as a sibling; ownership and workflow
                           stay unchanged.</td
                        >
                     </tr>
                  </tbody>
               </table>
            </section>

            <section class="api-peek">
               <div class="peek-text">
                  <h2>From a script</h2>
                  <p>
                     Every command is also a library call, for hooks, bots and build steps. Source at <a
                        href="https://github.com/leji-org/leji"
                        target="_blank"
                        rel="noopener">leji-org/leji</a
                     >, Apache-2.0.
                  </p>
               </div>
               <div class="peek-code"><Code code={apiCode} lang="js" theme="night-owl" wrap /></div>
            </section>

            <p class="next-step">
               Next: the <a href="/adoption/">adoption guide</a> for an existing repository, or{' '}
               <a href="/federation/">federation</a> when several teams each own a context layer.
            </p>
         </main>
      </div>
   </div>
   <script type="application/ld+json" set:html={JSON.stringify(sdkLd)} />
   <SiteFooter />
</Base>

<style>
   .gs-hero {
      /* No top padding: .doc-shell already sets the 2.5rem above the first line,
         and every Doc page starts its h1 there. This section used to add another
         2.5-4.5rem, which is why this page's header sat lower than the rest. */
      padding: 0 0 1rem;
      max-width: 760px;
   }
   /* .eyebrow now comes from global.css via PageHeader; the local copy is gone so
      the classification cannot drift from the rest of the site. */
   /* h1 comes from the shared .measured/.prose display scale in global.css. */
   .lede {
      font-size: var(--text-lede);
      line-height: 1.7;
      color: var(--ink-soft);
      max-width: var(--measure-fine);
      margin: 0;
   }

   h2 {
      font-family: var(--serif-display);
      font-weight: 560;
      font-size: 1.6rem;
      line-height: 1.25;
      color: var(--blue-deep);
      margin: 0 0 0.6rem;
   }

   .steps {
      margin-top: 2.5rem;
      display: grid;
      gap: 2.8rem;
      padding: 1.6rem 0 0.4rem;
   }
   .step {
      display: grid;
      gap: 0.9rem;
   }
   .step-text p {
      color: var(--ink-soft);
      margin: 0.4rem 0 0;
   }
   .step-text code {
      background: rgba(34, 63, 147, 0.07);
      padding: 0.1em 0.35em;
      border-radius: 4px;
      font-size: 0.85em;
      color: var(--blue-deep);
   }
   .map-note {
      margin-top: 1.1rem;
      padding: 0.9rem 1.2rem;
      border-left: 3px solid var(--gold);
      background: rgba(255, 189, 110, 0.1);
      border-radius: 0 8px 8px 0;
      font-size: 0.92rem;
      color: var(--ink-soft);
   }
   .map-note strong {
      color: var(--blue-deep);
   }
   .checks {
      margin: 0.6rem 0 1rem;
      padding-left: 1.1rem;
      color: var(--ink-soft);
   }
   .checks li {
      margin: 0.4rem 0;
   }
   .checks strong {
      color: var(--blue-deep);
      font-weight: 600;
   }
   .ladder-line {
      font-size: 0.92rem;
   }
   .step-text .ladder-more {
      margin-top: 1.15rem;
   }
   .ladder-more a {
      font-family: var(--mono);
      font-size: 0.74rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--blue);
      text-decoration: none;
      border-bottom: 1px solid var(--gold);
      padding-bottom: 2px;
      white-space: nowrap;
   }
   .ladder-more a:hover {
      color: var(--blue-soft);
      border-color: var(--gold-bright);
   }

   /* CI + invocation */
   .duo {
      margin-top: 4rem;
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.8rem;
   }
   .duo-cell h2 {
      font-size: 1.35rem;
   }
   .duo-cell p {
      color: var(--ink-soft);
      margin: 0 0 1.1rem;
   }
   .duo-cell .fine {
      margin: 1rem 0 0;
   }
   .duo-cell .fine a {
      color: var(--blue);
      text-decoration-color: var(--gold);
      text-underline-offset: 3px;
   }
   .duo-cell code {
      background: rgba(34, 63, 147, 0.07);
      padding: 0.1em 0.35em;
      border-radius: 4px;
      font-size: 0.85em;
      color: var(--blue-deep);
   }

   /* by situation */
   .shapes {
      margin-top: 4rem;
   }
   .shape-table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.4rem 0 0;
   }
   .shape-table th,
   .shape-table td {
      border-bottom: 1px solid var(--line);
      vertical-align: baseline;
      text-align: left;
      padding: 0.85rem 0 0.85rem 0;
   }
   .shape-table th {
      white-space: nowrap;
      padding-right: 2.2rem;
      font-family: var(--serif-display);
      font-weight: 580;
      font-size: 1.08rem;
   }
   .shape-table th a {
      color: var(--blue-deep);
      text-decoration-color: var(--gold);
      text-underline-offset: 3px;
      transition: color 0.15s;
   }
   .shape-table th a:hover {
      color: var(--blue);
   }
   .shape-table td {
      font-size: 0.95rem;
      color: var(--ink-soft);
      line-height: 1.55;
   }

   /* library surface */
   .api-peek {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.4rem;
      padding: 4rem 0 4.5rem;
   }
   .peek-text p {
      color: var(--ink-soft);
   }
   .peek-text a {
      color: var(--blue);
      text-decoration-color: var(--gold);
      text-underline-offset: 3px;
   }
   .peek-text code {
      background: rgba(34, 63, 147, 0.07);
      padding: 0.1em 0.35em;
      border-radius: 4px;
      font-size: 0.85em;
      color: var(--blue-deep);
   }

   .step-code {
      margin-top: 0;
   }

   .step-install {
      background: var(--blue-deep);
      border-radius: 12px;
      box-shadow: 0 14px 40px rgba(22, 41, 96, 0.14);
      overflow: hidden;
   }

   .mcp-block {
      margin-top: 4rem;
   }
   .mcp-block p {
      color: var(--ink-soft);
      margin: 0 0 1.1rem;
   }
   .mcp-block code {
      background: rgba(34, 63, 147, 0.07);
      padding: 0.1em 0.35em;
      border-radius: 4px;
      font-size: 0.85em;
      color: var(--blue-deep);
   }
   /* Continuation prose, not marginalia: what leji init does, and where the full
      tool list lives. Same size and measure as the paragraph above the snippet;
      the smaller setting was the only thing making them read as a footnote. */
   .mcp-block .fine {
      margin: 1rem 0 0;
   }
   .mcp-block .fine a {
      color: var(--blue);
      text-decoration-color: var(--gold);
      text-underline-offset: 3px;
   }

   .step-code :global(.astro-code),
   .duo-cell :global(.astro-code),
   .peek-code :global(.astro-code),
   .mcp-block :global(.astro-code) {
      background: var(--blue-deep) !important;
      border-radius: 12px;
      padding: 1.2rem 1.4rem;
      font-size: var(--code-fz);
      line-height: 1.65;
      box-shadow: 0 14px 40px rgba(22, 41, 96, 0.14);
      margin: 0;
   }
</style>
