---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionNav from '../components/SectionNav.astro';
import SupportedRuntimes from '../components/SupportedRuntimes.astro';
import InstallTabs from '../components/InstallTabs.astro';

const initCode = `leji adopt --dry-run    # the exact write plan; nothing is written
leji adopt              # adopt an existing repo (leji init for a new one)
                        # then it offers to open Claude Code or Codex on the brief

leji adopt --wire-adapters  # finish an adoption over an existing CLAUDE.md / AGENTS.md`;

const validateCode = `leji validate           # schemas + lint rules
leji validate --content # + placeholder / thin-content warnings
leji index              # generate the index`;

const conformanceCode = `leji conformance        # score the claim`;

const viewCode = `leji view               # open the human-readable viewer in your browser
leji viewer build       # export a static folder to host behind internal auth`;

const ciCode = `leji ci                 # generate the workflow; --provider <github|gitlab|circleci|azure>
leji ci --hooks         # the same gates as a local pre-commit

# what the generated job runs:
leji validate           # schemas + lint rules
leji index --check      # stale index fails

# add at indexed and above:
leji changelog check    # append-only`;

const startCode = 'leji start              # or --agent claude-code | codex to pin one';

const apiCode = `import { validateLayer, writeIndex, conformanceReport } from '@leji-org/leji';

const { findings } = validateLayer('.');`;

const mcpCode = `# Claude Code (available in every project)
claude mcp add leji --scope user -- npx -y @leji-org/mcp

# Codex
codex mcp add leji -- npx -y @leji-org/mcp`;

// Structured data for the reference SDKs, so answer engines associate the
// packages with the specification.
const repo = 'https://github.com/leji-org/leji';
const sdkLd = {
   '@context': 'https://schema.org',
   '@graph': [
      {
         '@type': 'SoftwareSourceCode',
         name: '@leji-org/leji',
         description:
            'Reference SDK and CLI for Leji, the open specification for the shared context layer of AI-native teams (Node.js).',
         codeRepository: repo,
         programmingLanguage: 'TypeScript',
         runtimePlatform: 'Node.js',
         license: 'https://www.apache.org/licenses/LICENSE-2.0',
         url: 'https://www.npmjs.com/package/@leji-org/leji',
      },
      {
         '@type': 'SoftwareSourceCode',
         name: 'leji (Python)',
         description:
            'Reference SDK and CLI for Leji, the open specification for the shared context layer of AI-native teams (Python).',
         codeRepository: repo,
         programmingLanguage: 'Python',
         license: 'https://www.apache.org/licenses/LICENSE-2.0',
         url: 'https://pypi.org/project/leji/',
      },
      {
         '@type': 'SoftwareSourceCode',
         name: 'leji (Go)',
         description:
            'Reference SDK and CLI for Leji, the open specification for the shared context layer of AI-native teams (Go, single binary).',
         codeRepository: repo,
         programmingLanguage: 'Go',
         license: 'https://www.apache.org/licenses/LICENSE-2.0',
         url: 'https://pkg.go.dev/github.com/leji-org/leji/packages/sdk-go',
      },
      {
         '@type': 'SoftwareSourceCode',
         name: 'create-leji',
         description:
            'Bootstrap a Leji context layer: npm create leji runs leji init for the shared context layer of AI-native teams.',
         codeRepository: repo,
         programmingLanguage: 'JavaScript',
         runtimePlatform: 'Node.js',
         license: 'https://www.apache.org/licenses/LICENSE-2.0',
         url: 'https://www.npmjs.com/package/create-leji',
      },
   ],
};
---

<Base
   title="Quickstart · Leji"
   description="Quickstart: install the Leji CLI, bootstrap or map a context layer, validate it, and score it against the level it claims."
>
   <SiteHeader />
   <div class="wrap">
      <div class="doc-shell">
         <SectionNav current={Astro.url.pathname} />
         <main id="content" class="adopt-main">
            <section class="gs-hero">
               <p class="eyebrow">Quickstart&ensp;·&ensp;spec 1.0</p>
               <h1>Build a context layer, check it conforms.</h1>
               <p class="lede">
                  The reference CLI does the mechanical work: bootstrap or adopt a context layer, launch your agent
                  hosts into it, validate the machine-readable artifacts and frontmatter against the schemas, then run
                  structural and lint checks over the rest, and score it against the conformance level it claims.
                  Schemas and templates ship inside the package, so no network access is needed.
               </p>
            </section>

            <SupportedRuntimes />

            <section class="steps" aria-label="Quickstart steps">
               <article class="step">
                  <div class="step-text">
                     <h2><span class="step-num">01</span>Install the tooling</h2>
                     <p>
                        The <code>leji</code> CLI is implemented in 3 languages: Node/TypeScript, Python, and Go. All three
                        are tested against the same fixture suite, so commands, flags, JSON findings, and exit codes stay
                        identical no matter which one your toolchain or CI installs.
                     </p>
                     <p>
                        For a Node repository, add it as a devDependency (<code>npm i -D @leji-org/leji</code>) so CI,
                        the git hook, and every contributor run the lockfile-pinned version.
                     </p>
                  </div>
                  <div class="step-install"><InstallTabs /></div>
               </article>

               <article class="step">
                  <div class="step-text">
                     <h2><span class="step-num">02</span>Bootstrap a new context layer, or adopt an existing repo</h2>
                     <p>
                        <code>leji init</code> scaffolds a new context layer: a <code>leji.json</code> manifest at the repository
                        root, a boot profile, seeded category documents, a first decision record, and an agent onboarding
                        brief. <code>--dry-run</code> prints the complete write plan and touches nothing, and every step through
                        validation and conformance runs without handing anything to an agent.
                     </p>
                     <p>
                        You do not have to wire the agent up yourself. The scaffold starts as placeholder, and when the
                        run finishes, if Claude Code or Codex is on your <code>PATH</code>, <code>init</code> and{' '}
                        <code>adopt</code> offer to open it on the onboarding brief for you. Accept, and the agent reads your
                        repository and fills the layer in; it deletes the brief when it is done, because the brief is scaffolding
                        rather than context. Decline, and you get the command to run later, or you can edit the seeded documents
                        yourself. A <code>--yes</code> run skips the offer, so scripted and CI runs stay unattended.
                     </p>
                     <p>
                        Working alone? <code>leji init --mode solo</code> also seeds identity and writing-style starters and
                        points the onboarding brief at an owner interview: your agent asks who you are, who you serve, and
                        how you write, and every question takes a typed answer, attached files, pasted file paths, or a drop
                        folder. Only the synthesis you approve becomes context. Your raw files never enter git:{' '}
                        <code>init</code> and <code>adopt</code> refuse to run while anything under <code>.leji/</code> is
                        tracked, and write the ignore rule before the first transient file. The onboarding brief then has
                        your agent delete the raw artifacts as its last step, once the context layer is populated.
                     </p>
                     <aside class="map-note">
                        <strong>Already have a <code>docs/</code> tree?</strong>
                        <code>leji adopt</code> reuses it: it scaffolds the category index files alongside your existing docs,
                        moves nothing, and migrates any vendor entrypoint (<code>CLAUDE.md</code>,{' '}
                        <code>AGENTS.md</code>) into the context layer without touching the originals. Hand the
                        onboarding brief to your agent to populate those index files from the real tree.{' '}
                        <code>leji detect</code> finds your installed agent hosts, and <code>leji start</code> opens one in
                        the context layer. Because the originals are deliberately untouched, the old entrypoint does not yet
                        redirect to the boot profile, so what you have is an adoption draft rather than a conformant context
                        layer. <code>leji adopt --wire-adapters</code> finishes it.
                     </aside>
                  </div>
                  <div class="step-code"><Code code={initCode} lang="bash" theme="night-owl" wrap /></div>
               </article>

               <article class="step">
                  <div class="step-text">
                     <h2><span class="step-num">03</span>Validate</h2>
                     <p>
                        The machine-readable artifacts check against the v1.0 schemas: the manifest, the index, the
                        changelog, agent-profile and decision-record frontmatter. Boot profiles, index files and
                        ordinary documents have no schema and get structural and lint checks instead: declared files
                        must exist, the changelog is append-only against the current <code>HEAD</code> (a committed rewrite
                        is caught in review, not here), and at <code>indexed</code> and above a stale index is a hard failure
                        (<code>leji index --check</code> checks currency at any level). After a plain{' '}
                        <code>leji adopt</code> over an existing <code>CLAUDE.md</code> or <code>AGENTS.md</code>,
                        expect one failure here, <code>vendor-adapter-redirect</code>, until <code
                           >leji adopt --wire-adapters</code
                        >{' '}
                        runs. That is the adoption draft the CLI announces when <code>adopt</code> finishes.
                     </p>
                  </div>
                  <div class="step-code"><Code code={validateCode} lang="bash" theme="night-owl" wrap /></div>
               </article>

               <article class="step">
                  <div class="step-text">
                     <h2><span class="step-num">04</span>Claim a level, then check it</h2>
                     <p>
                        Partial adoption is by design: start at <code>core</code>, and each level contains the last. The
                        manifest declares the claim;{' '}
                        <code>leji conformance</code> scores the context layer against it.
                     </p>
                     <p class="ladder-line">
                        <code>core</code> → <code>indexed</code> → <code>governed</code> → <code>federated</code>
                     </p>
                     <p class="ladder-more">
                        <a href="/spec/conformance/">What each level asks of you</a>
                     </p>
                  </div>
                  <div class="step-code"><Code code={conformanceCode} lang="bash" theme="night-owl" wrap /></div>
               </article>

               <article class="step">
                  <div class="step-text">
                     <h2><span class="step-num">05</span>See your context layer</h2>
                     <p>
                        <code>leji view</code> opens the human-readable viewer in your browser: the reviewed context layer
                        rendered for people to read, not just for agents to parse. To host it for the team,{' '}
                        <code>leji viewer build</code> exports a self-contained static folder you can put behind internal
                        auth.
                     </p>
                  </div>
                  <div class="step-code"><Code code={viewCode} lang="bash" theme="night-owl" wrap /></div>
               </article>
            </section>

            <section class="duo">
               <div class="duo-cell">
                  <h2>Keep it honest in CI</h2>
                  <p>
                     <code>leji ci</code> adds a CI job that runs <code>leji validate</code> and{' '}
                     <code>leji index --check</code> on every change, so a drifted index fails the build. It infers the provider
                     from your <code>origin</code> remote and falls back to GitHub when the remote names none;{' '}
                     <code>--provider gitlab</code> / <code>circleci</code> / <code>azure</code> overrides it.{' '}
                     <code>--hooks</code> mirrors the same two gates as a local pre-commit.
                  </p>
                  <Code code={ciCode} lang="bash" theme="night-owl" wrap />
                  <p class="fine">
                     Exit codes are CI-native: <code>0</code> clean, <code>1</code> findings, <code>2</code> usage error.
                  </p>
               </div>
               <div class="duo-cell">
                  <h2>Enter the context layer</h2>
                  <p>
                     <code>leji start</code> auto-detects an installed agent host and opens it booted from the boot profile,
                     so the context layer is the agent's first context with zero hops.
                  </p>
                  <Code code={startCode} lang="bash" theme="night-owl" wrap />
                  <p class="fine">
                     Several hosts detected? It asks. None detected, or a scripted / CI run? It prints the command to
                     run instead of guessing. The{' '}
                     <a href="/adoption/#entering-the-context-layer">adoption guide</a> covers host pass-through flags and
                     the vendor-file fallback table.
                  </p>
               </div>
            </section>

            <section class="mcp-block">
               <h2>Give your agent the tools, not just the context</h2>
               <p>
                  Entering a context layer gives your agent the context. The <a href="/mcp/">MCP server</a> gives it the Leji
                  tooling: a local, read-only server that serves the spec and schemas and runs validation and conformance
                  against the context layer on disk, so the agent can learn the spec and check a context layer without a shell.
                  It reads and reports; it never writes. Add it once and the <code>leji</code> tools are available in every
                  session its configured scope covers.
               </p>
               <Code code={mcpCode} lang="bash" theme="night-owl" wrap />
               <p class="fine">
                  <code>leji init</code> and <code>leji adopt</code> now offer to register the server for you before the handoff:
                  for Claude Code it's project-scoped (a committed <code>.mcp.json</code> your team shares), for Codex it's
                  user-level. The commands above are for anyone who skips that prompt or wants to set it up by hand.
               </p>
               <p class="fine">
                  Works in any MCP client; the <a href="/mcp/">MCP server</a> page has the full tool list and the config for
                  Claude Desktop, Cursor, and others.
               </p>
            </section>

            <section class="shapes" aria-label="Adoption guides by situation">
               <h2>Then adopt for your situation</h2>
               <table class="shape-table">
                  <tbody>
                     <tr>
                        <th scope="row"><a href="/adoption/#monorepo">Monorepo</a></th>
                        <td>1 repository, 1 context layer, initialized once at the repository root.</td>
                     </tr>
                     <tr>
                        <th scope="row"><a href="/adoption/#multi-repo">Multi-repo</a></th>
                        <td>
                           A dedicated context repository, mounted docs-only in each consuming repo, pinned per
                           repository.
                        </td>
                     </tr>
                     <tr>
                        <th scope="row">
                           <a href="/adoption/#teams-that-already-have-a-context-repo">Existing context repo</a>
                        </th>
                        <td
                           >Don't merge it. Mount it as a sibling context layer; ownership and workflow stay unchanged.</td
                        >
                     </tr>
                  </tbody>
               </table>
            </section>

            <section class="api-peek">
               <div class="peek-text">
                  <h2>From a script</h2>
                  <p>
                     The validation, indexing, conformance, routing, viewer, and onboarding APIs are exported as a
                     library, for hooks, bots, and build steps. Source lives at <a
                        href="https://github.com/leji-org/leji"
                        target="_blank"
                        rel="noopener">leji-org/leji</a
                     >{' '}
                     under <code>packages/sdk</code>, Apache-2.0. For AI agents, the spec, schemas, and validation ship
                     as an <a href="/mcp/">MCP server</a>.
                  </p>
               </div>
               <div class="peek-code"><Code code={apiCode} lang="js" theme="night-owl" wrap /></div>
            </section>
         </main>
      </div>
   </div>
   <script type="application/ld+json" set:html={JSON.stringify(sdkLd)} />
   <SiteFooter />
</Base>

<style>
   .gs-hero {
      padding: clamp(2.5rem, 6vh, 4.5rem) 0 1rem;
      max-width: 760px;
   }
   .eyebrow {
      font-family: var(--mono);
      font-size: 0.78rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--blue);
      margin: 0 0 1rem;
   }
   h1 {
      font-family: var(--serif-display);
      font-size: clamp(2.3rem, 5.5vw, 3.6rem);
      font-weight: 500;
      line-height: 1.06;
      letter-spacing: -0.012em;
      color: var(--blue-deep);
      margin: 0 0 1.2rem;
   }
   .lede {
      font-size: clamp(1rem, 1.5vw, 1.12rem);
      line-height: 1.7;
      color: var(--ink-soft);
      max-width: 58ch;
      margin: 0;
   }

   h2 {
      font-family: var(--serif-display);
      font-weight: 560;
      font-size: 1.6rem;
      line-height: 1.25;
      color: var(--blue-deep);
      margin: 0 0 0.6rem;
   }

   .steps {
      margin-top: 2.5rem;
      display: grid;
      gap: 2.8rem;
      padding: 1.6rem 0 0.4rem;
   }
   .step {
      display: grid;
      gap: 0.9rem;
   }
   .step-num {
      font-family: var(--serif-display);
      font-weight: 620;
      font-size: 0.95rem;
      color: var(--blue-deep);
      background: var(--gold);
      padding: 0.1rem 0.6rem;
      border-radius: 999px;
      margin-right: 0.8rem;
      vertical-align: 0.18em;
   }
   .step-text p {
      color: var(--ink-soft);
      margin: 0.4rem 0 0;
   }
   .step-text code {
      background: rgba(34, 63, 147, 0.07);
      padding: 0.1em 0.35em;
      border-radius: 4px;
      font-size: 0.85em;
      color: var(--blue-deep);
   }
   .map-note {
      margin-top: 1.1rem;
      padding: 0.9rem 1.2rem;
      border-left: 3px solid var(--gold);
      background: rgba(255, 189, 110, 0.1);
      border-radius: 0 8px 8px 0;
      font-size: 0.92rem;
      color: var(--ink-soft);
   }
   .map-note strong {
      color: var(--blue-deep);
   }
   .ladder-line {
      font-size: 0.92rem;
   }
   .step-text .ladder-more {
      margin-top: 1.15rem;
   }
   .ladder-more a {
      font-family: var(--mono);
      font-size: 0.74rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--blue);
      text-decoration: none;
      border-bottom: 1px solid var(--gold);
      padding-bottom: 2px;
      white-space: nowrap;
   }
   .ladder-more a:hover {
      color: var(--blue-soft);
      border-color: var(--gold-bright);
   }

   /* CI + invocation */
   .duo {
      margin-top: 4rem;
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.8rem;
   }
   .duo-cell h2 {
      font-size: 1.35rem;
   }
   .duo-cell p {
      color: var(--ink-soft);
      margin: 0 0 1.1rem;
   }
   .duo-cell .fine {
      font-size: 0.88rem;
      margin: 1rem 0 0;
   }
   .duo-cell .fine a {
      color: var(--blue);
      text-decoration-color: var(--gold);
      text-underline-offset: 3px;
   }
   .duo-cell code {
      background: rgba(34, 63, 147, 0.07);
      padding: 0.1em 0.35em;
      border-radius: 4px;
      font-size: 0.85em;
      color: var(--blue-deep);
   }

   /* by situation */
   .shapes {
      margin-top: 4rem;
   }
   .shape-table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.4rem 0 0;
   }
   .shape-table th,
   .shape-table td {
      border-bottom: 1px solid var(--line);
      vertical-align: baseline;
      text-align: left;
      padding: 0.85rem 0 0.85rem 0;
   }
   .shape-table th {
      white-space: nowrap;
      padding-right: 2.2rem;
      font-family: var(--serif-display);
      font-weight: 580;
      font-size: 1.08rem;
   }
   .shape-table th a {
      color: var(--blue-deep);
      text-decoration-color: var(--gold);
      text-underline-offset: 3px;
      transition: color 0.15s;
   }
   .shape-table th a:hover {
      color: var(--blue);
   }
   .shape-table td {
      font-size: 0.95rem;
      color: var(--ink-soft);
      line-height: 1.55;
   }

   /* library surface */
   .api-peek {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.4rem;
      padding: 4rem 0 4.5rem;
   }
   .peek-text p {
      color: var(--ink-soft);
   }
   .peek-text a {
      color: var(--blue);
      text-decoration-color: var(--gold);
      text-underline-offset: 3px;
   }
   .peek-text code {
      background: rgba(34, 63, 147, 0.07);
      padding: 0.1em 0.35em;
      border-radius: 4px;
      font-size: 0.85em;
      color: var(--blue-deep);
   }

   .step-code {
      margin-top: 0;
   }

   .step-install {
      background: var(--blue-deep);
      border-radius: 12px;
      box-shadow: 0 14px 40px rgba(22, 41, 96, 0.14);
      overflow: hidden;
   }

   .mcp-block {
      margin-top: 4rem;
   }
   .mcp-block p {
      color: var(--ink-soft);
      margin: 0 0 1.1rem;
   }
   .mcp-block code {
      background: rgba(34, 63, 147, 0.07);
      padding: 0.1em 0.35em;
      border-radius: 4px;
      font-size: 0.85em;
      color: var(--blue-deep);
   }
   .mcp-block .fine {
      font-size: 0.88rem;
      margin: 1rem 0 0;
   }
   .mcp-block .fine a {
      color: var(--blue);
      text-decoration-color: var(--gold);
      text-underline-offset: 3px;
   }

   .step-code :global(.astro-code),
   .duo-cell :global(.astro-code),
   .peek-code :global(.astro-code),
   .mcp-block :global(.astro-code) {
      background: var(--blue-deep) !important;
      border-radius: 12px;
      padding: 1.2rem 1.4rem;
      font-size: var(--code-fz);
      line-height: 1.65;
      box-shadow: 0 14px 40px rgba(22, 41, 96, 0.14);
      margin: 0;
   }
</style>
