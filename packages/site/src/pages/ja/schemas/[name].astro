---
// Japanese translation of src/pages/schemas/[name].astro. The English page is the page
// of record; `source` is its git blob sha at the revision this translation follows.
//
// The schema tab prints the published file byte for byte: it is the machine surface and
// is never translated. Everything the page states about that file (its title, its lede,
// every field description, and the prose inside the example beside it) comes from the
// locale's schema map, which carries one translation per place a string lives.
import { Code } from 'astro:components';
import PageHeader from '../../../components/PageHeader.astro';
import SchemaFields from '../../../components/SchemaFields.astro';
import SectionNav from '../../../components/SectionNav.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import TranslationNote from '../../../components/TranslationNote.astro';
import { translationStrings } from '../../../data/i18n';
import type { ExampleNoteKey } from '../../../data/schema-examples';
import Base from '../../../layouts/Base.astro';
import { checkedExample, localizeSchema, readSchemaSources, schemaMap, schemaMapInputs } from '../../../schema-i18n';
import lejiSyntaxTheme from '../../../styles/shiki-leji.json';

const source = 'f90d4b17ac5062b03e49ef95d81440b693081100';
const strings = translationStrings('ja');

/** The note above each example panel, under the key the inventory names it by. */
const EXAMPLE_NOTES: Record<ExampleNoteKey, string> = {
   manifest: 'リポジトリルートに置かれた、適合するマニフェストです。',
   index: '生成されたコンテキストインデックスです。変更のたびに CLI が生成し直します。',
   changelog: 'コンテキストレイヤーの変更を記録した、機械可読な変更履歴です。',
   agentProfile:
      '適合するエージェントプロファイルです。このスキーマが検証するのは YAML フロントマターで、その下の markdown 本文は自由な形式の文章です。',
   decisionRecord:
      '適合する決定記録です。このスキーマが検証するのは YAML フロントマターで、markdown 本文が文脈と決定と帰結を担います。',
};

export async function getStaticPaths() {
   return readSchemaSources().map((entry) => ({ params: { name: entry.name } }));
}

const { name } = Astro.params;
const sources = readSchemaSources();
const map = schemaMap('ja', schemaMapInputs(sources));
const entry = sources.find((one) => one.name === name)!;
const translated = map[entry.name];
const schema = localizeSchema(entry.schema, translated.strings);
// Checked on the way out: the localized instance reads back as the instance it claims to
// be, differs from the published one only in the prose this locale carries, and still
// satisfies the schema wherever the translation touched it.
const exampleText = checkedExample(entry.parsed, translated.example, entry.schema, `ja ${entry.name} example`);
---

<Base
   lang="ja"
   title={`${schema.title ?? entry.file} · Leji`}
   description={`${schema.title ?? entry.file} の JSON Schema です。AI ネイティブなチームの共有コンテキストレイヤーを定義する Leji 仕様の一部です。`}
>
   <SiteHeader />
   <div class="wrap">
      <div class="doc-shell">
         <SectionNav current={`/schemas/${entry.name}/`} />
         <main id="content" class="prose">
            <PageHeader kind="normative" />
            <h1>{schema.title ?? entry.file}</h1>
            <TranslationNote strings={strings.note} href={`/schemas/${entry.name}/`} />
            {schema.description && <p class="sp-lede">{schema.description}</p>}

            <p class="schema-meta">
               <strong>正規の <code>$id</code>：</strong>
               <code>{schema.$id}</code><br />
               <strong>生ファイル：</strong>
               <a href={`/schemas/v1.0/${entry.file}`}><code>{entry.file}</code></a>
            </p>

            <h2>フィールド</h2>
            <SchemaFields schema={schema} />

            <h2>スキーマと実例</h2>
            <div class="tabs">
               <input type="radio" name="schema-tabs" id="tab-schema" checked />
               <input type="radio" name="schema-tabs" id="tab-example" />
               <div class="tab-bar">
                  <label for="tab-schema">スキーマ</label>
                  <label for="tab-example">
                     実例 · <code>{entry.example.label}</code>
                  </label>
               </div>
               <div class="tab-panels">
                  <div class="tab-panel" data-panel="schema">
                     <Code code={entry.raw.trimEnd()} lang="json" theme={lejiSyntaxTheme} wrap />
                  </div>
                  <div class="tab-panel" data-panel="example">
                     <p class="example-note">{EXAMPLE_NOTES[entry.example.noteKey]}</p>
                     <Code code={exampleText} lang={entry.example.format} theme={lejiSyntaxTheme} wrap />
                  </div>
               </div>
            </div>

            <p class="all-schemas"><a href="/ja/schemas/">← スキーマ一覧</a></p>
         </main>
      </div>
   </div>
   <SiteFooter />
</Base>

<style>
   .schema-meta {
      line-height: 2;
   }

   /* CSS-only tabs: hidden radios drive the active panel, no JavaScript. */
   .tabs {
      margin-top: 1rem;
   }
   .tabs > input {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
      pointer-events: none;
   }
   .tab-bar {
      display: flex;
      gap: 0.3rem;
      border-bottom: 1px solid var(--leji-border);
   }
   .tab-bar label {
      font-family: var(--mono);
      font-size: 0.76rem;
      letter-spacing: 0.04em;
      color: var(--leji-text-body);
      padding: 0.5rem 0.9rem;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      transition: color 0.15s;
   }
   .tab-bar label code {
      background: none;
      padding: 0;
      font-size: 1em;
      color: inherit;
   }
   .tab-bar label:hover {
      color: var(--leji-link);
   }
   #tab-schema:checked ~ .tab-bar label[for='tab-schema'],
   #tab-example:checked ~ .tab-bar label[for='tab-example'] {
      color: var(--leji-text);
      border-bottom-color: var(--leji-brand);
   }
   #tab-schema:focus-visible ~ .tab-bar label[for='tab-schema'],
   #tab-example:focus-visible ~ .tab-bar label[for='tab-example'] {
      outline: 2px solid var(--leji-link);
      outline-offset: 2px;
   }
   .tab-panel {
      display: none;
   }
   #tab-schema:checked ~ .tab-panels [data-panel='schema'],
   #tab-example:checked ~ .tab-panels [data-panel='example'] {
      display: block;
   }
   .example-note {
      font-size: 0.9rem;
      color: var(--leji-text-body);
      margin: 0.9rem 0 0;
   }
   .tab-panels :global(.astro-code) {
      background: var(--leji-deep) !important;
      border-radius: 10px;
      padding: 1.2rem 1.4rem;
      font-size: var(--code-fz);
      line-height: 1.6;
      margin-top: 0.9rem;
   }
   .all-schemas {
      margin-top: 2rem;
   }
</style>
