---
// Japanese translation of src/pages/404.astro. The English page is the page of
// record; `source` is its git blob sha at the revision this translation follows.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TranslationNote from '../../components/TranslationNote.astro';
import { translationStrings } from '../../data/i18n';

const source = '2962daecd782a203b8023fc8b4e9404066028a07';
const strings = translationStrings('ja');
---

<Base
   lang="ja"
   title="ページが見つかりません · Leji"
   description="このページは leji.org にはありません。ホームに戻るか、仕様を直接ご覧ください。"
   noindex
>
   <SiteHeader />
   <main id="content" class="wrap">
      <section class="lost">
         <p class="lost-eyebrow">404 · ページが見つかりません</p>
         <h1>ページが見つかりません。</h1>
         <TranslationNote strings={strings.note} href="/404" />
         <p class="lost-text">
            お探しのページはここにはありません。<a href="/ja/">ホーム</a>に戻るか、{' '}
            <a href="/ja/spec/">仕様</a>へ直接お進みください。
         </p>
      </section>
   </main>
   <SiteFooter />
</Base>

<style>
   .lost {
      padding: clamp(4rem, 14vh, 9rem) 0 6rem;
      max-width: 640px;
   }
   .lost-eyebrow {
      font-family: var(--mono);
      font-size: 0.78rem;
      letter-spacing: 0.22em;
      color: var(--leji-link);
      margin: 0 0 1rem;
   }
   h1 {
      font-family: var(--serif-display);
      font-size: clamp(2.2rem, 6vw, 3.4rem);
      font-weight: 520;
      color: var(--leji-text);
      margin: 0 0 1rem;
   }
   .lost-text {
      color: var(--leji-text-body);
   }
   .lost-text a {
      color: var(--leji-link);
      text-decoration-color: var(--leji-brand);
      text-underline-offset: 3px;
   }
</style>
