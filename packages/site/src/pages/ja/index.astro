---
// Japanese translation of src/pages/index.astro. The English page is the page of
// record; `source` is its git blob sha at the revision this translation follows.
import { Code } from 'astro:components';
import Base from '../../layouts/Base.astro';
import HeroMark from '../../components/HeroMark.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import AnimatedTerminal from '../../components/AnimatedTerminal.astro';
import ViewerGlimpse from '../../components/ViewerGlimpse.astro';
import InstallTabs from '../../components/InstallTabs.astro';
import TranslationNote from '../../components/TranslationNote.astro';
import { translationStrings } from '../../data/i18n';
import githubIcon from '../../assets/github.svg?raw';
import lejiSyntaxTheme from '../../styles/shiki-leji.json';

const source = '36bcf47882672f4531a8db2ca978572968ea09f3';
const strings = translationStrings('ja');

// Captured verbatim from a real run, so the transcript stays exactly as captured:
// a repo with an existing docs/ tree and an AGENTS.md,
// `leji adopt --yes --wire-adapters`, then validate and conformance.
// The fixture is `fixture()` in packages/sdk/test/site-hero.test.ts: that test runs
// the same three commands against the built CLI and compares what it prints to the
// lines below, so the transcript is re-captured where the CLI's output moves.
const heroSession = [
   { cmd: 'leji adopt --yes --wire-adapters' },
   { out: 'Wrote 16 files (context root: docs/):' },
   { out: '   .leji/work/onboarding-brief.md   AGENTS.md   docs/agents/core.md   …', mark: 'dim' },
   { gap: true },
   { cmd: 'leji validate' },
   { out: 'ok (0 errors, 0 warnings)', mark: 'ok' },
   { gap: true },
   { cmd: 'leji conformance' },
   { out: 'ok (0 errors, 0 warnings; claimedLevel: core, verifiedLevel: core, processAttested: 4)', mark: 'ok' },
];

// What the hero's `adopt` wrote: the manifest of the very layer the transcript
// above creates. The panel leaves out the `$schema` pointer and the `claimedAt`
// date, and the same test compares everything else to the fixture's leji.json.
const peekJson = `{
  "leji": "1.0",
  "name": "acme-billing-context",
  "description": "Shared context layer for this repository.",
  "rootPath": "docs/",
  "bootProfilePath": "docs/boot-profile.md",
  "categories": {
    "domain": { "indexes": ["docs/context/domain.md"] },
    "system": { "indexes": ["docs/context/system.md"] },
    "governance": { "indexes": ["docs/context/governance.md"] },
    "decisions": { "indexes": ["docs/context/decisions.md"] }
  },
  "owners": { "primary": { "name": "Acme Platform Team", "contact": "platform@acme.example" } },
  "conformance": { "claimedLevel": "core" },
  "vendorAdapters": ["AGENTS.md"]
}`;
---

<Base
   lang="ja"
   title="Leji: AI ネイティブなチームのための共有コンテキストレイヤー"
   description="Leji は、リポジトリで共有・所有され、バージョン管理されるコンテキストレイヤーのオープンな仕様です。人と AI エージェントが同じ情報を読み、すべての変更はレビューを通じて統制されます。"
>
   <!-- The banner sits outside <main>, but the monument band still has to start above
        it so the gradient, glow and fluting run unbroken behind the header. .monument
        pulls itself up by the header's height and pads the same amount back, and the
        header paints transparent on top. See --header-h below. -->
   <SiteHeader flush />
   <main id="content">
      <div class="monument">
         <div class="wrap">
            <section class="hero">
               <div class="hero-text">
                  <p class="kicker reveal r1">
                     <span>/LEH-jee/</span><i class="sep" aria-hidden="true">◆</i><span>オープンな仕様とツール</span>
                  </p>
                  <!-- "legible" is the name: Leji, from legible, per the /LEH-jee/ kicker above. -->
                  <h1 class="reveal r2">
                     あなたのコンテキストを<br /><span class="gild">読めるものに。</span>
                  </h1>
                  <div class="carved-rule reveal r2" aria-hidden="true"></div>
                  <p class="lede reveal r3">
                     チームのチャットやツールごとの指示に埋もれた意図を、Leji
                     はひとつの場所に集約します。それが、チームでレビューし所有する共有コンテキストレイヤーです。標準化するのは形とガバナンスであり、内容ではありません。人もエージェントも同じ出典を参照でき、検証ツールによってずれを可視化できます。
                  </p>
                  <div class="cta reveal r4">
                     <a class="btn solid" href="/ja/quickstart/">クイックスタート</a>
                     <a class="btn ghost" href="/ja/spec/">仕様を読む</a>
                  </div>
                  <div class="hero-note reveal r4">
                     <TranslationNote strings={strings.note} href="/" />
                  </div>
               </div>

               <div class="hero-proof reveal r5">
                  <AnimatedTerminal
                     lines={heroSession}
                     title="acme-billing"
                     glimpseTitle="leji view  ·  acme-billing-context"
                     label="実際の Leji のセッション: 既存のリポジトリに導入し、検証し、判定する"
                  >
                     <HeroMark slot="brand" size={64} loop />
                     <ViewerGlimpse slot="glimpse" />
                     <InstallTabs slot="footer" />
                  </AnimatedTerminal>
                  <p class="hero-license">
                     <a class="oss-link" href="https://github.com/leji-org/leji" target="_blank" rel="noopener">
                        <span class="gh-icon" set:html={githubIcon} /><span class="free">無料でオープンソース</span>
                     </a>&ensp;·&ensp;Apache-2.0&ensp;·&ensp;CC-BY-4.0
                  </p>
               </div>
            </section>
         </div>
      </div>

      <div class="levels-band">
         <div class="wrap">
            <section class="levels">
               <p class="eyebrow is-kicker">移行せずに導入</p>
               <h2 class="section-title levels-title">いまあるリポジトリから始める。</h2>
               <p class="levels-lede">
                  CLI
                  は、既存のツリーにコンテキストレイヤーをスキャフォールドします。ファイルは一切移動せず、エントリポイントが変わるのは、明示的に
                  <code>--wire-adapters</code> を指定した場合だけです。
               </p>
               <ol class="adopt-flow">
                  <li class="adopt-step">
                     <span class="step-when">まず</span>
                     <h3>既存ツリーにスキャフォールドする</h3>
                     <p>
                        <code>adopt</code>
                        は、既存のドキュメントルートを再利用し、カテゴリインデックスファイルのひな型を配置して、エージェントのエントリポイントに書かれている内容をコンテキストレイヤーへコピーします。既存ファイルは移動されず、<code
                           >--wire-adapters</code
                        > を指定するまで、エントリポイントも書き換えられません。
                     </p>
                  </li>
                  <li class="adopt-step">
                     <span class="step-when">次に</span>
                     <h3>エージェントがマッピングを提案する</h3>
                     <p>
                        オンボーディングブリーフに従って、エージェントがリポジトリを読み、各文書をどのカテゴリに分類するか提案します。その提案は、他の変更と同じようにレビューします。
                     </p>
                  </li>
                  <li class="adopt-step">
                     <span class="step-when">その後は</span>
                     <h3>そこから統制する</h3>
                     <p>
                        変更は、リポジトリのレビューのゲートを通ります。CI
                        での検証がずれを検出し、鮮度の期限によって古くなったコンテキストを識別できます。
                     </p>
                  </li>
               </ol>
            </section>
         </div>
      </div>

      <div class="wrap">
         <section class="surfaces">
            <p class="eyebrow is-kicker">人が読み、エージェントが利用する</p>
            <h2 class="section-title surfaces-title">ひとつの出典、ふたつの読み手。</h2>
            <p class="surfaces-lede">
               チームの考え方を、リポジトリが所有する記録として残します。内容は、ドメインの言葉、制約、決定、規約、エージェントのガードレールです。出典はひとつで、変更はすべて同じレビューのゲートを通ります。
            </p>
            <div class="chart">
               <div class="chart-source">
                  <span class="chart-source-name">共有コンテキストレイヤー</span>
                  <span class="chart-source-tag">レビューを通して変わる</span>
               </div>
               <svg class="chart-fork" viewBox="0 0 40 100" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 50 H20 M20 23 V77 M20 23 H40 M20 77 H40"></path>
               </svg>
               <div class="chart-surfaces">
                  <article class="surface">
                     <p class="surface-label">人のために</p>
                     <p class="surface-body">
                        チームの誰もが、エージェントが参照するのと同じコンテキストレイヤーを読めます。<code
                           >leji view</code
                        >{' '}
                        は、<strong>共有コンテキストレイヤー</strong>を、人が読める形でブラウザに開きます。
                     </p>
                  </article>
                  <article class="surface">
                     <p class="surface-label">エージェントのために</p>
                     <p class="surface-body">
                        エージェントは<a href="/ja/spec/boot-profile/">ブートプロファイル</a
                        >から入ります。作業前に読むべき内容を示す、ただひとつのファイルです。エントリポイントファイル（<code
                           >AGENTS.md</code
                        >、<code>CLAUDE.md</code>）は、独自の写しを持たず、そこへ誘導します。<strong
                           >MCP サーバー</strong
                        >は、エージェントに仕様とスキーマを提供し、<a href="/ja/mcp/">検証と適合性の判定</a
                        >を直接実行できるようにします。
                     </p>
                  </article>
               </div>
            </div>
         </section>
      </div>

      <div class="levels-band">
         <div class="wrap">
            <section class="levels">
               <p class="eyebrow is-kicker">適合性</p>
               <h2 class="section-title levels-title">レベルを宣言し、検証する。</h2>
               <p class="levels-lede">
                  4
                  つのレベルは段階的に積み上がります。自己評価による成熟度ではなく、実際に何が整っているかで判定されます。たいていのチームは{
                     ' '
                  }
                  <code>governed</code> まで進み、そこで止めます。CLI が機械的に確認できる項目を検証し、残りはチームが確認します。
               </p>
               <ol class="ladder">
                  <li>
                     <span class="rung-tag">core</span>
                     <strong class="rung-cap">チームで共有されたコンテキスト</strong>
                     <span>マニフェスト、ブートプロファイル、実質のある内容、最初の決定、明示された所有者。</span>
                  </li>
                  <li>
                     <span class="rung-tag">indexed</span>
                     <strong class="rung-cap">ツールから読めるように</strong>
                     <span>生成されたインデックスと、機械可読な変更履歴。</span>
                  </li>
                  <li>
                     <span class="rung-tag">governed</span>
                     <strong class="rung-cap">レビューされ、ずれが検出される</strong>
                     <span>プルリクエストのレビュー、エージェントプロファイル、CI、確認対象となる鮮度の期限。</span>
                  </li>
                  <li>
                     <span class="rung-tag">federated</span>
                     <strong class="rung-cap">組織全体の実践</strong>
                     <span
                        >他のリポジトリでのピン留めされたマウントと、古いピンの報告。
                        <a href="/ja/federation/">フェデレーションの仕組み。</a></span
                     >
                  </li>
               </ol>
               <aside class="standard-note">
                  <span class="standard-note-label">商用のゲートなし</span>
                  <p>
                     どのレベルにも、公開された仕様とリファレンスのツールだけで到達できます。適合性のために商用製品やサービスが必要になることはありません。スチュワード（仕様の管理主体）自身が提供するものも同様です。
                  </p>
               </aside>
            </section>
         </div>
      </div>

      <div class="why-band">
         <div class="wrap">
            <p class="eyebrow is-kicker on-dark">なぜこの形なのか</p>
            <h2 class="section-title levels-title">持続する意図を循環させ、仕組みで確かめる。</h2>
            <section class="theses">
               <article class="thesis">
                  <span class="thesis-num">I.</span>
                  <div class="thesis-body">
                     <h3>指示ではなく意図を</h3>
                     <p>
                        持続する意図は、レビューされたひとつのコンテキストレイヤーに置かれ、人もエージェントもそこから行動を導き出します。ベンダーのエントリポイントはそこへ誘導するので、<a
                           href="/ja/ai-native/">AI ネイティブなチーム</a
                        >のコンテキストは、どのツールよりも長く存続します。<a href="/ja/rationale/#指示ではなく意図を"
                           >意図が長持ちする理由。</a
                        >
                     </p>
                  </div>
               </article>
               <article class="thesis">
                  <span class="thesis-num">II.</span>
                  <div class="thesis-body">
                     <h3>階層ではなく輪</h3>
                     <p>
                        人から人へ、人から AI へ、人から AI を経て人へ。この 3
                        つはいずれも、ひとつの共有コンテキストレイヤーを中心とする主要な流れです。全員が読み、誰でも提案でき、人がプルリクエストを通じて承認します。{
                           ' '
                        }
                        <a href="/ja/rationale/#階層ではなく輪">輪がうまくいく理由。</a>
                     </p>
                  </div>
               </article>
               <article class="thesis">
                  <span class="thesis-num">III.</span>
                  <div class="thesis-body">
                     <h3>善意ではなく仕組みを</h3>
                     <p>
                        現実が変われば、共有コンテキストは古くなります。コードレビュー、機械的なずれの検査、鮮度の期限によって、保守が仕組み化されます。古くなったコンテキストが、黙って現行のものとして扱われることはありません。{
                           ' '
                        }
                        <a href="/ja/rationale/#これがウィキではない理由">仕組みが効く理由。</a>
                     </p>
                  </div>
               </article>
            </section>
         </div>
      </div>

      <div class="wrap">
         <section class="manifest-peek">
            <div class="peek-text">
               <p class="eyebrow is-kicker">機械向けのエントリポイント</p>
               <h2 class="section-title">マニフェストは 1 ファイル</h2>
               <p>
                  既存の <code>docs/</code> ツリーは、名前を変えずに<em>割り当てる</em
                  >ことで適合します。リポジトリルートのひとつの{' '}
                  <code>leji.json</code>
                  で、コンテキストルート、ブートプロファイル、カテゴリの割り当て、適合性の宣言を記述します。
               </p>
               <p>
                  十分に整備されたコンテキストレイヤーには、ベンダーファイルは不要です。invocation
                  でエージェントホストをブートプロファイルへ直接誘導するか、<code>leji start</code>
                  で検出したホストをそこで起動します。
               </p>
               <p>
                  エントリポイントファイルは参照先を示すポインタであり、コンテキストそのものを置く場所ではありません。<code
                     >AGENTS.md</code
                  >
                  は、多くのエージェントホストが読み込める移植可能な形式です。詳しくは<a href="/ja/adoption/"
                     >導入ガイド</a
                  >を参照してください。
               </p>
               <p class="peek-more"><a href="/ja/manifest/">マニフェストのリファレンス →</a></p>
            </div>
            <div class="peek-code">
               <Code code={peekJson} lang="json" theme={lejiSyntaxTheme} wrap />
            </div>
         </section>
      </div>
   </main>
   <SiteFooter />
</Base>

<style>
   .monument {
      --grain: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='160'%20height='160'%3E%3Cfilter%20id='n'%3E%3CfeTurbulence%20type='fractalNoise'%20baseFrequency='0.8'%20numOctaves='2'%20stitchTiles='stitch'/%3E%3CfeColorMatrix%20type='saturate'%20values='0'/%3E%3C/filter%3E%3Crect%20width='100%25'%20height='100%25'%20filter='url(%23n)'/%3E%3C/svg%3E");
      position: relative;
      overflow: hidden;
      color: var(--leji-ink-on-deep);
      /* Depth, three layers deep: the linear runs deepest at both ends and opens
         to --leji-deep across the middle, so the band frames itself; a mint wash
         lights the top where the headline sits; and the brand green, centred
         below the band's own edge, lifts the ground under the terminal the way
         the retired composition lifted it from below. */
      background:
         radial-gradient(120% 80% at 50% -20%, var(--leji-hero-glow-mint), transparent 55%),
         radial-gradient(90% 60% at 50% 118%, var(--leji-hero-glow-brand), transparent 60%),
         linear-gradient(180deg, var(--leji-deepest) 0%, var(--leji-deep) 32%, var(--leji-deepest) 100%);
      padding-bottom: clamp(3.5rem, 8vh, 6rem);
      /* The banner is a sibling above this band, not a child, so <main> can be the
         page's landmark. Pull the band up behind it and pad the same amount back, so
         the gradient, glow and fluting are continuous under the header.
         --header-h is the header row's height, defined in global.css. */
      margin-top: calc(-1 * var(--header-h));
      padding-top: var(--header-h);
   }
   /* stone grain */
   .monument::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: var(--grain);
      background-size: 160px 160px;
      opacity: 0.07;
      mix-blend-mode: overlay;
      pointer-events: none;
      z-index: 0;
   }
   /* engraved fluting */
   .monument::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: repeating-linear-gradient(90deg, transparent 0 78px, rgba(112, 216, 194, 0.05) 78px 79px);
      pointer-events: none;
      z-index: 0;
   }
   .monument > * {
      position: relative;
      z-index: 1;
   }
   .hero {
      padding: clamp(2.6rem, 8vh, 5.5rem) 0 clamp(1.5rem, 4vh, 3rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.06fr);
      gap: clamp(2.2rem, 5vw, 4.5rem);
      align-items: start;
   }
   @media (max-width: 900px) {
      .hero {
         grid-template-columns: 1fr;
         gap: 2.6rem;
         max-width: 680px;
      }
   }
   .hero-text {
      min-width: 0;
   }

   .kicker {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--leji-accent);
      margin: 0 0 1.3rem;
   }
   .kicker .sep {
      font-style: normal;
      font-size: 0.5rem;
      color: var(--leji-accent);
      opacity: 0.7;
      transform: translateY(-1px);
   }

   h1 {
      font-family: var(--serif-display);
      font-variation-settings: 'opsz' 144;
      font-weight: 460;
      /* Sized so the first clause fits one line in this column: Japanese has no word
         boundaries for the browser to break on, and at the shared size the clause
         broke inside コンテキスト. */
      font-size: clamp(2rem, 3.7vw, 3rem);
      line-height: 1.06;
      letter-spacing: -0.02em;
      color: var(--leji-ink-on-deep);
      margin: 0;
      max-width: 30ch;
   }

   /* The one word the headline turns on: mint against white, with the glow that
      makes it read as lit rather than merely coloured. */
   .gild {
      position: relative;
      white-space: nowrap;
      color: var(--leji-accent);
      font-style: italic;
      font-variation-settings: 'opsz' 144;
      text-shadow: 0 0 34px rgba(112, 216, 194, 0.4);
   }

   .carved-rule {
      width: 92px;
      height: 2px;
      margin: 1.7rem 0 0;
      background: linear-gradient(90deg, var(--leji-accent), rgba(112, 216, 194, 0.05));
      border-radius: 2px;
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.25);
   }

   .hero-note {
      max-width: 50ch;
      margin: 1.6rem 0 0;
   }
   .hero-note :global(.translation-note) {
      margin: 0;
      padding: 0.8rem 1.1rem;
      border-left-color: var(--leji-accent);
      background: rgba(255, 255, 255, 0.06);
      font-size: 0.86rem;
      color: var(--white-soft);
   }
   .hero-note :global(.translation-note a) {
      color: var(--leji-accent);
      text-decoration-color: var(--leji-accent-rule);
   }
   .hero-note :global(.translation-note a:hover) {
      text-decoration-color: var(--leji-accent);
   }

   .lede {
      font-family: var(--serif-text);
      font-size: clamp(1.04rem, 1.5vw, 1.17rem);
      line-height: 1.72;
      color: var(--white-soft);
      max-width: 50ch;
      margin: 1.7rem 0 2.1rem;
   }
   .lede strong {
      color: var(--leji-ink-on-deep);
      font-weight: 600;
   }
   .lede code {
      font-size: 0.84em;
      color: var(--white-strong);
      background: rgba(255, 255, 255, 0.09);
      border: 1px solid rgba(112, 216, 194, 0.22);
      padding: 0.06em 0.36em;
      border-radius: 4px;
   }
   .lede a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: rgba(112, 216, 194, 0.35);
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
      transition:
         color 0.15s ease,
         text-decoration-color 0.15s ease;
   }
   .lede a:hover {
      color: var(--leji-accent);
      text-decoration-color: var(--leji-accent);
   }

   .cta {
      display: flex;
      gap: 0.9rem;
      flex-wrap: wrap;
   }
   .hero-license {
      margin: 1.1rem 0 0;
      padding-left: 1.4rem;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      font-family: var(--mono);
