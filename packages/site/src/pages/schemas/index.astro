---
import fs from 'node:fs';
import path from 'node:path';
import Doc from '../../layouts/Doc.astro';
import { schemaInventory, schemaProjection } from '../../schema-i18n';
import { REPO_ROOT } from '../../repo-root';

const SCHEMA_DIR = path.join(REPO_ROOT, 'schemas');
// Title and description come off the projection, which is the one tree every schema page
// renders from, so this list and the pages it links to can never name a schema two ways.
const schemas = schemaInventory(fs.readdirSync(SCHEMA_DIR)).map((name) => {
   const file = `${name}.schema.json`;
   const { title, description } = schemaProjection(JSON.parse(fs.readFileSync(path.join(SCHEMA_DIR, file), 'utf-8')));
   return { file, name, title: title?.text, description: description?.text };
});
---

<Doc
   kind="normative"
   title="Schemas · Leji"
   description="The JSON Schemas of the Leji v1.0 line: context manifest, context index, context changelog, agent profile, and decision record."
>
   <h1>Schemas</h1>
   <p>
      JSON Schemas (draft 2020-12) for the machine-readable surface. Normative; the raw files are served at their
      canonical <code>$id</code> URLs for tooling. See{' '}
      <a href="/spec/machine-readable-surface/">the machine-readable surface</a> and{' '}
      <a href="/spec/versioning/">versioning</a> for the stability rules.
   </p>
   <table>
      <thead>
         <tr><th>Schema</th><th>Validates</th><th>Raw</th></tr>
      </thead>
      <tbody>
         {
            schemas.map((s) => (
               <tr>
                  <td>
                     <a href={`/schemas/${s.name}/`}>
                        <code>{s.name}</code>
                     </a>
                  </td>
                  <td>{s.description ?? s.title}</td>
                  <td>
                     <a href={`/schemas/v1.0/${s.file}`}>
                        <code>.json</code>
                     </a>
                  </td>
               </tr>
            ))
         }
      </tbody>
   </table>
</Doc>

<style>
   /* keep the Raw (.json) column on one line; only the middle "Validates" wraps */
   td:last-child,
   th:last-child {
      white-space: nowrap;
   }
</style>
