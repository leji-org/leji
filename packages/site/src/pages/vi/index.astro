---
// Vietnamese translation of src/pages/index.astro. The English page is the page of
// record; `source` is its git blob sha at the revision this translation follows.
import { Code } from 'astro:components';
import Base from '../../layouts/Base.astro';
import HeroMark from '../../components/HeroMark.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import AnimatedTerminal from '../../components/AnimatedTerminal.astro';
import ViewerGlimpse from '../../components/ViewerGlimpse.astro';
import InstallTabs from '../../components/InstallTabs.astro';
import TranslationNote from '../../components/TranslationNote.astro';
import { translationStrings } from '../../data/i18n';
import githubIcon from '../../assets/github.svg?raw';
import lejiSyntaxTheme from '../../styles/shiki-leji.json';

const source = '36bcf47882672f4531a8db2ca978572968ea09f3';
const strings = translationStrings('vi');

// Captured verbatim from a real run: a repo with an existing docs/ tree and an
// AGENTS.md, `leji adopt --yes --wire-adapters`, then validate and conformance
// (the file list is elided to its first entries, real sorted order).
// The fixture carries AGENTS.md, the portable adapter, rather than a
// single-vendor entrypoint, because the standard is vendor-agnostic.
// The fixture is `fixture()` in packages/sdk/test/site-hero.test.ts: that test
// builds the same repository, runs these three commands against the built CLI, and
// compares what it prints to the lines below. So this transcript is re-captured
// where the CLI's output moves, rather than by hand after someone notices.
const heroSession = [
   { cmd: 'leji adopt --yes --wire-adapters' },
   { out: 'Wrote 16 files (context root: docs/):' },
   { out: '   .leji/work/onboarding-brief.md   AGENTS.md   docs/agents/core.md   …', mark: 'dim' },
   { gap: true },
   { cmd: 'leji validate' },
   { out: 'ok (0 errors, 0 warnings)', mark: 'ok' },
   { gap: true },
   { cmd: 'leji conformance' },
   { out: 'ok (0 errors, 0 warnings; claimedLevel: core, verifiedLevel: core, processAttested: 4)', mark: 'ok' },
];

// What the hero's `adopt` wrote: the manifest of the very layer the transcript
// above creates. The panel leaves out the `$schema` pointer and the `claimedAt`
// date, and the same test compares everything else to the fixture's leji.json.
const peekJson = `{
  "leji": "1.0",
  "name": "acme-billing-context",
  "description": "Shared context layer for this repository.",
  "rootPath": "docs/",
  "bootProfilePath": "docs/boot-profile.md",
  "categories": {
    "domain": { "indexes": ["docs/context/domain.md"] },
    "system": { "indexes": ["docs/context/system.md"] },
    "governance": { "indexes": ["docs/context/governance.md"] },
    "decisions": { "indexes": ["docs/context/decisions.md"] }
  },
  "owners": { "primary": { "name": "Acme Platform Team", "contact": "platform@acme.example" } },
  "conformance": { "claimedLevel": "core" },
  "vendorAdapters": ["AGENTS.md"]
}`;
---

<Base
   lang="vi"
   title="Leji: lớp ngữ cảnh dùng chung cho các nhóm AI-native"
   description="Leji là một bản đặc tả mở cho một lớp ngữ cảnh dùng chung, có đánh phiên bản, thuộc về kho mã nguồn, được cả người lẫn AI agent đọc, với mọi thay đổi đều đi qua vòng xem xét."
>
   <!-- The banner sits outside <main>, but the monument band still has to start above
        it so the gradient, glow and fluting run unbroken behind the header. .monument
        pulls itself up by the header's height and pads the same amount back, and the
        header paints transparent on top. See --header-h below. -->
   <SiteHeader flush />
   <main id="content">
      <div class="monument">
         <div class="wrap">
            <section class="hero">
               <div class="hero-text">
                  <p class="kicker reveal r1">
                     <span>/LEH-jee/</span><i class="sep" aria-hidden="true">◆</i><span>Bản đặc tả mở & bộ công cụ</span
                     >
                  </p>
                  <!-- "legible" is the name: Leji, from legible, per the /LEH-jee/ kicker above. -->
                  <h1 class="reveal r2">Làm cho ngữ cảnh<br />của bạn <span class="gild">đọc được.</span></h1>
                  <div class="carved-rule reveal r2" aria-hidden="true"></div>
                  <p class="lede reveal r3">
                     Leji đưa phần chủ ý vốn bị vùi trong các cuộc chat của nhóm và chỉ dẫn riêng của từng công cụ về
                     một nơi: lớp ngữ cảnh dùng chung do chính nhóm bạn sở hữu và xem xét. Leji chuẩn hoá hình thái và
                     cách quản trị, chứ không chuẩn hoá nội dung. Nhờ đó, người và agent cùng đọc một nguồn, còn công cụ
                     kiểm tra giúp phát hiện sự trôi lệch.
                  </p>
                  <div class="cta reveal r4">
                     <a class="btn solid" href="/vi/quickstart/">Bắt đầu nhanh</a>
                     <a class="btn ghost" href="/vi/spec/">Đọc bản đặc tả</a>
                  </div>
                  <div class="hero-note reveal r4">
                     <TranslationNote strings={strings.note} href="/" />
                  </div>
               </div>

               <div class="hero-proof reveal r5">
                  <AnimatedTerminal
                     lines={heroSession}
                     title="acme-billing"
                     glimpseTitle="leji view  ·  acme-billing-context"
                     label="Một phiên Leji thật: áp dụng cho một kho mã nguồn sẵn có, kiểm tra, rồi chấm điểm"
                  >
                     <HeroMark slot="brand" size={64} loop />
                     <ViewerGlimpse slot="glimpse" />
                     <InstallTabs slot="footer" />
                  </AnimatedTerminal>
                  <p class="hero-license">
                     <a class="oss-link" href="https://github.com/leji-org/leji" target="_blank" rel="noopener">
                        <span class="gh-icon" set:html={githubIcon} /><span class="free"
                           >Miễn phí &amp; mã nguồn mở</span
                        >
                     </a>&ensp;·&ensp;Apache-2.0&ensp;·&ensp;CC-BY-4.0
                  </p>
               </div>
            </section>
         </div>
      </div>

      <div class="levels-band">
         <div class="wrap">
            <section class="levels">
               <p class="eyebrow is-kicker">Áp dụng, không phải di dời</p>
               <h2 class="section-title levels-title">Bắt đầu từ chính kho mã nguồn bạn đang có.</h2>
               <p class="levels-lede">
                  CLI dựng khung một lớp ngữ cảnh lên trên cây tệp bạn vốn đã có. Không có gì bị di chuyển, và một điểm
                  vào chỉ thay đổi khi bạn yêu cầu bằng <code>--wire-adapters</code>.
               </p>
               <ol class="adopt-flow">
                  <li class="adopt-step">
                     <span class="step-when">Trước hết</span>
                     <h3>Dựng khung quanh cây tệp của bạn</h3>
                     <p>
                        <code>adopt</code> dùng lại thư mục gốc của tài liệu hiện có, tạo sẵn các tệp index danh mục và đưa
                        nội dung từ điểm vào hiện tại của agent vào lớp ngữ cảnh. Không tệp nào bạn đã viết bị di chuyển;
                        điểm vào cũng chỉ được viết lại khi bạn yêu cầu bằng <code>--wire-adapters</code>.
                     </p>
                  </li>
                  <li class="adopt-step">
                     <span class="step-when">Rồi</span>
                     <h3>Agent của bạn đề xuất cách ánh xạ</h3>
                     <p>
                        Brief onboarding yêu cầu agent đọc kho mã nguồn rồi đề xuất tài liệu nào thuộc danh mục nào. Bạn
                        xem xét đề xuất đó như xem xét mọi thay đổi khác.
                     </p>
                  </li>
                  <li class="adopt-step">
                     <span class="step-when">Về sau</span>
                     <h3>Được quản trị từ đó trở đi</h3>
                     <p>
                        Mọi thay đổi đều đi qua cổng xem xét sẵn có của kho mã nguồn. Các phép kiểm trong CI phát hiện
                        sự trôi lệch, còn hạn tươi làm lộ phần ngữ cảnh đã cũ.
                     </p>
                  </li>
               </ol>
            </section>
         </div>
      </div>

      <div class="wrap">
         <section class="surfaces">
            <p class="eyebrow is-kicker">Con người đọc, agent truy cập</p>
            <h2 class="section-title surfaces-title">Một nguồn, hai&nbsp;nhóm đối tượng.</h2>
            <p class="surfaces-lede">
               Một bản ghi thuộc về kho mã nguồn, thể hiện cách nhóm bạn suy nghĩ: ngôn ngữ của lĩnh vực, các ràng buộc,
               các quyết định, các quy ước, các ràng buộc bảo vệ cho agent. Một nguồn duy nhất, thay đổi qua một cổng
               xem xét duy nhất.
            </p>
            <div class="chart">
               <div class="chart-source">
                  <span class="chart-source-name">Lớp ngữ cảnh dùng chung</span>
                  <span class="chart-source-tag">thay đổi qua vòng xem xét</span>
               </div>
               <svg class="chart-fork" viewBox="0 0 40 100" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 50 H20 M20 23 V77 M20 23 H40 M20 77 H40"></path>
               </svg>
               <div class="chart-surfaces">
                  <article class="surface">
                     <p class="surface-label">Cho người</p>
                     <p class="surface-body">
                        Bất kỳ ai trong nhóm cũng đọc được đúng lớp ngữ cảnh mà agent được trỏ tới. <code
                           >leji view</code
                        >{' '}
                        mở <strong>lớp ngữ cảnh dùng chung</strong> dưới dạng dễ đọc ngay trong trình duyệt.
                     </p>
                  </article>
                  <article class="surface">
                     <p class="surface-label">Cho agent</p>
                     <p class="surface-body">
                        Agent bước vào qua <a href="/vi/spec/boot-profile/">boot profile</a>, đúng một tệp nói rõ phải
                        nạp gì trước một tác vụ; các tệp điểm vào (<code>AGENTS.md</code>, <code>CLAUDE.md</code>)
                        chuyển hướng về đó thay vì tự giữ một bản sao. <strong>MCP server</strong> trao cho chúng bản đặc
                        tả cùng các schema và cho phép chúng <a href="/vi/mcp/">kiểm tra và chấm mức tuân thủ</a> ngay trong
                        giao diện đó, không cần gọi CLI.
                     </p>
                  </article>
               </div>
            </div>
         </section>
      </div>

      <div class="levels-band">
         <div class="wrap">
            <section class="levels">
               <p class="eyebrow is-kicker">Mức tuân thủ</p>
               <h2 class="section-title levels-title">Tuyên bố một mức, rồi kiểm lại nó.</h2>
               <p class="levels-lede">
                  Bốn mức, mức sau bao hàm mức trước, được chấm theo những gì hiện diện chứ không theo mức trưởng thành
                  tự đánh giá. Phần lớn các nhóm đi tới{' '}
                  <code>governed</code> rồi dừng. CLI kiểm những gì máy kiểm được; phần còn lại do nhóm bạn đứng ra bảo đảm.
               </p>
               <ol class="ladder">
                  <li>
                     <span class="rung-tag">core</span>
                     <strong class="rung-cap">Ngữ cảnh dùng chung của nhóm</strong>
                     <span
                        >manifest, boot profile, nội dung thật, một quyết định đầu tiên, một chủ sở hữu được nêu tên.</span
                     >
                  </li>
                  <li>
                     <span class="rung-tag">indexed</span>
                     <strong class="rung-cap">Đọc được đối với công cụ</strong>
                     <span>một index được sinh ra và một changelog máy đọc được.</span>
                  </li>
                  <li>
                     <span class="rung-tag">governed</span>
                     <strong class="rung-cap">Đã qua xem xét, có kiểm trôi lệch</strong>
                     <span>xem xét qua pull request, agent profile, CI, và hạn tươi được kiểm.</span>
                  </li>
                  <li>
                     <span class="rung-tag">federated</span>
                     <strong class="rung-cap">Thực hành ở quy mô tổ chức</strong>
                     <span
                        >một mount có ghim trong các kho mã nguồn khác, kèm báo cáo pin lỗi thời.{' '}
                        <a href="/vi/federation/">Federation hoạt động thế nào.</a></span
                     >
                  </li>
               </ol>
               <aside class="standard-note">
                  <span class="standard-note-label">Không có rào cản thương mại</span>
                  <p>
                     Mọi mức đều đạt tới được chỉ với bản đặc tả mở và công cụ tham chiếu. Việc tuân thủ không bao giờ
                     đòi hỏi một sản phẩm hay dịch vụ thương mại nào, kể cả của chính đơn vị quản thủ.
                  </p>
               </aside>
            </section>
         </div>
      </div>

      <div class="why-band">
         <div class="wrap">
            <p class="eyebrow is-kicker on-dark">Vì sao nó được dựng theo cách này</p>
            <h2 class="section-title levels-title">
               Chủ ý bền vững, chia sẻ trong một vòng tròn, kiểm bằng&nbsp;cơ chế.
            </h2>
            <section class="theses">
               <article class="thesis">
                  <span class="thesis-num">I.</span>
                  <div class="thesis-body">
                     <h3>Chủ ý thay vì chỉ dẫn</h3>
                     <p>
                        Chủ ý bền vững thuộc về một lớp ngữ cảnh duy nhất đã qua xem xét, nơi người và agent tự suy ra
                        hành động từ đó. Các điểm vào của nhà cung cấp chuyển hướng về đó, nên ngữ cảnh của một{' '}
                        <a href="/vi/ai-native/">nhóm AI-native</a> sống lâu hơn mọi công cụ.{' '}
                        <a href="/vi/rationale/#intent-over-instructions">Vì sao chủ ý bền lâu.</a>
                     </p>
                  </div>
               </article>
               <article class="thesis">
                  <span class="thesis-num">II.</span>
                  <div class="thesis-body">
                     <h3>Một vòng tròn, không phải một tầng</h3>
                     <p>
                        Người với người, người với AI, và người với AI với người đều được coi trọng ngang nhau quanh
                        cùng một lớp ngữ cảnh dùng chung. Ai cũng đọc, ai cũng đề xuất, và con người phê duyệt qua pull
                        request.{' '}
                        <a href="/vi/rationale/#a-circle-not-a-tier">Vì sao vòng tròn hiệu quả.</a>
                     </p>
                  </div>
               </article>
               <article class="thesis">
                  <span class="thesis-num">III.</span>
                  <div class="thesis-body">
                     <h3>Cơ chế thay vì thiện chí</h3>
                     <p>
                        Thực tế luôn thay đổi, còn ngữ cảnh dùng chung sẽ dần xuống cấp. Việc xem xét code, các phép
                        kiểm những dạng trôi lệch máy kiểm được và hạn tươi đưa việc bảo trì vào cơ chế vận hành thay vì
                        để nó trông vào thiện chí; ngữ cảnh lỗi thời không bao giờ bị âm thầm coi là còn hiệu lực.{' '}
                        <a href="/vi/rationale/#why-this-is-not-a-wiki">Vì sao cơ chế mới là thứ quan trọng.</a>
                     </p>
                  </div>
               </article>
            </section>
         </div>
      </div>

      <div class="wrap">
         <section class="manifest-peek">
            <div class="peek-text">
               <p class="eyebrow is-kicker">Điểm vào cho máy</p>
               <h2 class="section-title">Một tệp manifest</h2>
               <p>
                  Cây <code>docs/</code> sẵn có của bạn tuân thủ bằng cách <em>ánh xạ</em>, chứ không phải đổi tên. Một
                  tệp{' '}
                  <code>leji.json</code> duy nhất ở gốc kho mã nguồn khai báo gốc ngữ cảnh, boot profile, các ánh xạ danh
                  mục, và tuyên bố mức tuân thủ.
               </p>
               <p>
                  Một lớp ngữ cảnh tinh gọn không cần tệp nào của nhà cung cấp: lệnh triệu tập trỏ thẳng agent host tới
                  boot profile, hoặc <code>leji start</code> mở ngay một host đã phát hiện được tại đó.
               </p>
               <p>
                  Các tệp điểm vào chỉ là con trỏ, không bao giờ là nơi chứa ngữ cảnh. <code>AGENTS.md</code> là tệp dùng
                  chung mà nhiều agent host đều đọc; <a href="/vi/adoption/">hướng dẫn áp dụng</a> nói nốt phần còn lại.
               </p>
               <p class="peek-more"><a href="/vi/manifest/">Tra cứu manifest →</a></p>
            </div>
            <div class="peek-code">
               <Code code={peekJson} lang="json" theme={lejiSyntaxTheme} wrap />
            </div>
         </section>
      </div>
   </main>
   <SiteFooter />
</Base>

<style>
   .monument {
      --grain: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='160'%20height='160'%3E%3Cfilter%20id='n'%3E%3CfeTurbulence%20type='fractalNoise'%20baseFrequency='0.8'%20numOctaves='2'%20stitchTiles='stitch'/%3E%3CfeColorMatrix%20type='saturate'%20values='0'/%3E%3C/filter%3E%3Crect%20width='100%25'%20height='100%25'%20filter='url(%23n)'/%3E%3C/svg%3E");
      position: relative;
      overflow: hidden;
      color: var(--leji-ink-on-deep);
      /* Depth, three layers deep: the linear runs deepest at both ends and opens
         to --leji-deep across the middle, so the band frames itself; a mint wash
         lights the top where the headline sits; and the brand green, centred
         below the band's own edge, lifts the ground under the terminal the way
         the retired composition lifted it from below. */
      background:
         radial-gradient(120% 80% at 50% -20%, var(--leji-hero-glow-mint), transparent 55%),
         radial-gradient(90% 60% at 50% 118%, var(--leji-hero-glow-brand), transparent 60%),
         linear-gradient(180deg, var(--leji-deepest) 0%, var(--leji-deep) 32%, var(--leji-deepest) 100%);
      padding-bottom: clamp(3.5rem, 8vh, 6rem);
      /* The banner is a sibling above this band, not a child, so <main> can be the
         page's landmark. Pull the band up behind it and pad the same amount back, so
         the gradient, glow and fluting are continuous under the header.
         --header-h is the header row's height, defined in global.css. */
      margin-top: calc(-1 * var(--header-h));
      padding-top: var(--header-h);
   }
   /* stone grain */
   .monument::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: var(--grain);
      background-size: 160px 160px;
      opacity: 0.07;
      mix-blend-mode: overlay;
      pointer-events: none;
      z-index: 0;
   }
   /* engraved fluting */
   .monument::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: repeating-linear-gradient(90deg, transparent 0 78px, rgba(112, 216, 194, 0.05) 78px 79px);
      pointer-events: none;
      z-index: 0;
   }
   .monument > * {
      position: relative;
      z-index: 1;
   }
   .hero {
      padding: clamp(2.6rem, 8vh, 5.5rem) 0 clamp(1.5rem, 4vh, 3rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.06fr);
      gap: clamp(2.2rem, 5vw, 4.5rem);
      align-items: start;
   }
   @media (max-width: 900px) {
      .hero {
         grid-template-columns: 1fr;
         gap: 2.6rem;
         max-width: 680px;
      }
   }
   .hero-text {
      min-width: 0;
   }

   .kicker {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--leji-accent);
      margin: 0 0 1.3rem;
   }
   .kicker .sep {
      font-style: normal;
      font-size: 0.5rem;
      color: var(--leji-accent);
      opacity: 0.7;
      transform: translateY(-1px);
   }

   h1 {
      font-family: var(--serif-display);
      font-variation-settings: 'opsz' 144;
      font-weight: 460;
      font-size: clamp(2.4rem, 5.2vw, 4.05rem);
      line-height: 1.06;
      letter-spacing: -0.02em;
      color: var(--leji-ink-on-deep);
      margin: 0;
      max-width: 30ch;
   }

   /* The one word the headline turns on: mint against white, with the glow that
      makes it read as lit rather than merely coloured. */
   .gild {
      position: relative;
      white-space: nowrap;
      color: var(--leji-accent);
      font-style: italic;
      font-variation-settings: 'opsz' 144;
      text-shadow: 0 0 34px rgba(112, 216, 194, 0.4);
   }

   .carved-rule {
      width: 92px;
      height: 2px;
      margin: 1.7rem 0 0;
