---
// Simplified Chinese translation of src/pages/schemas/index.astro. The English page is
// the page of record; `source` is its git blob sha at the revision this translation
// follows.
//
// What each schema validates is the schema's own description, so it is read through the
// locale's schema map rather than from the file: the map carries one translation per
// place a string lives, and the build fails if any place the page renders is missing.
import PageHeader from '../../../components/PageHeader.astro';
import SectionNav from '../../../components/SectionNav.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import TranslationNote from '../../../components/TranslationNote.astro';
import { translationStrings } from '../../../data/i18n';
import Base from '../../../layouts/Base.astro';
import { localizeSchema, readSchemaSources, schemaMap, schemaMapInputs, schemaProjection } from '../../../schema-i18n';

const source = '598bbe8856e6a626d6cb9e6dcc63d8259bb78430';
const strings = translationStrings('zh-hans');

const sources = readSchemaSources();
const map = schemaMap('zh-hans', schemaMapInputs(sources));
const schemas = sources.map((entry) => {
   const { title, description } = schemaProjection(localizeSchema(entry.schema, map[entry.name].strings));
   return { file: entry.file, name: entry.name, title: title?.text, description: description?.text };
});
---

<Base
   lang="zh-hans"
   title="Schema · Leji"
   description="Leji v1.0 版本系列的各个 JSON Schema：上下文清单、上下文索引、上下文变更日志、智能体配置和决策记录。"
>
   <SiteHeader />
   <div class="wrap">
      <div class="doc-shell">
         <SectionNav current="/schemas/" />
         <main id="content" class="prose">
            <PageHeader kind="normative" />
            <h1>Schema</h1>
            <TranslationNote strings={strings.note} href="/schemas/" />
            <p>
               面向机器可读接口的 JSON Schema（draft 2020-12）。它们是规范性的；原始文件在各自权威的 <code>$id</code> URL
               上提供，供工具使用。稳定性规则见<a href="/zh-hans/spec/machine-readable-surface/">机器可读接口</a>与<a
                  href="/zh-hans/spec/versioning/">版本管理</a
               >。
            </p>
            <table>
               <thead>
                  <tr><th>Schema</th><th>校验对象</th><th>原始文件</th></tr>
               </thead>
               <tbody>
                  {
                     schemas.map((s) => (
                        <tr>
                           <td>
                              <a href={`/zh-hans/schemas/${s.name}/`}>
                                 <code>{s.name}</code>
                              </a>
                           </td>
                           <td>{s.description ?? s.title}</td>
                           <td>
                              <a href={`/schemas/v1.0/${s.file}`}>
                                 <code>.json</code>
                              </a>
                           </td>
                        </tr>
                     ))
                  }
               </tbody>
            </table>
         </main>
      </div>
   </div>
   <SiteFooter />
</Base>

<style>
   /* keep the Raw (.json) column on one line; only the middle "Validates" wraps */
   td:last-child,
   th:last-child {
      white-space: nowrap;
   }
</style>
