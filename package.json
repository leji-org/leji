{
  "name": "leji-monorepo",
  "version": "1.3.1",
  "private": true,
  "description": "Leji: an open specification for the shared context layer of AI-native teams. Workspace root for the spec, schemas, site, and SDKs.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "validate": "npm run validate -w packages/sdk",
    "dogfood": "node packages/sdk/dist/cli.js validate --content && node packages/sdk/dist/cli.js index --check && node packages/sdk/dist/cli.js conformance && node packages/sdk/dist/cli.js freshness",
    "build": "npm run build --workspaces --if-present",
    "cli:live": "node scripts/cli-mode.ts live",
    "cli:packed": "node scripts/cli-mode.ts packed",
    "cli:packed:refresh": "node scripts/cli-mode.ts refresh",
    "cli:mode": "node scripts/cli-mode.ts mode",
    "cli:assert": "node scripts/cli-mode.ts assert",
    "watch": "npm run build -w @leji-org/leji -- --watch",
    "setup:py": "npm run setup:py --workspaces --if-present",
    "setup:go": "npm run setup:go --workspaces --if-present",
    "test": "npm run assets:check && npm run lint:all && npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:proc": "npm run test:proc --workspaces --if-present",
    "coverage": "npm run coverage --workspaces --if-present",
    "smoke:prepublish": "bash scripts/smoke-prepublish.sh",
    "version:set": "node scripts/version.ts",
    "version:check": "node scripts/version.ts --check",
    "assets": "node scripts/sync-assets.ts",
    "assets:check": "node scripts/sync-assets.ts --check",
    "ncu": "npx npm-check-updates --format group --workspaces --root",
    "ncu:u": "npx npm-check-updates -u --workspaces --root && npm install",
    "lint": "prettier --check \"packages/sdk/src/**/*.ts\" \"packages/sdk/test/**/*.ts\" \"packages/mcp/src/**/*.ts\" \"packages/mcp/test/**/*.ts\" \"packages/create-leji/index.js\" \"packages/site/src/**/*.{ts,astro}\" \"packages/site/astro.config.ts\" \"scripts/*.ts\"",
    "lint:fix": "prettier --write \"packages/sdk/src/**/*.ts\" \"packages/sdk/test/**/*.ts\" \"packages/mcp/src/**/*.ts\" \"packages/mcp/test/**/*.ts\" \"packages/create-leji/index.js\" \"packages/site/src/**/*.{ts,astro}\" \"packages/site/astro.config.ts\" \"scripts/*.ts\"",
    "lint:all": "npm run lint && npm run lint --workspaces --if-present",
    "parity": "node scripts/parity-test.ts",
    "prepare": "husky"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "prettier": "3.8.4",
    "prettier-plugin-astro": "0.14.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true
  }
}
