# Release-path pin tuple: the versions the publish path must agree on.
#
# Read only through scripts/lib/release-pins.sh, which validates this file
# lexically before sourcing it: blank lines, comments, and these seven
# assignments, nothing else. Enforced against the tree by
# scripts/check-release-pins.sh rule 7, so a bump here cannot leave a copy behind.
#
# TWINE_VERSION is not a free choice: it is the twine that
# pypa/gh-action-pypi-publish bundles at PYPI_PUBLISH_ACTION_SHA
# (requirements/runtime.txt at PYPI_PUBLISH_ACTION_VERSION). Bumping the action
# means re-reading that file and moving TWINE_VERSION with it, or the local gate
# stops standing in for the upload.
#
# JSR_VERSION is the jsr CLI the publish step runs through npx; GORELEASER_VERSION
# is the goreleaser the goreleaser-action installs (its own pin is the action SHA).
#
# Refreshed as part of every release pre-flight.

PIP_VERSION=26.2.1
BUILD_VERSION=1.5.0
TWINE_VERSION=7.0.0
JSR_VERSION=0.14.3
PYPI_PUBLISH_ACTION_VERSION=v1.14.2
PYPI_PUBLISH_ACTION_SHA=dc37677b2e1c63e2034f94d8a5b11f265b73ba33
GORELEASER_VERSION=v2.18.0
