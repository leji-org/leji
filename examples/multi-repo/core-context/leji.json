{
  "$schema": "https://leji.org/schemas/v1.0/context-manifest.schema.json",
  "leji": "1.0",
  "name": "acme-core-context",
  "description": "Organization-wide context layer for Acme, consumed by product repos as a docs-only submodule.",
  "rootPath": "docs/",
  "bootProfilePath": "docs/boot-profile.md",
  "categories": {
    "domain": {
      "indexes": [
        "docs/context/domain.md"
      ]
    },
    "system": {
      "indexes": [
        "docs/context/system.md"
      ]
    },
    "governance": {
      "indexes": [
        "docs/context/governance.md"
      ]
    },
    "decisions": {
      "indexes": [
        "docs/context/decisions.md"
      ]
    }
  },
  "machine": {
    "indexPath": "docs/context-index.json",
    "changelogPath": "docs/context-changelog.json",
    "agentProfilesPath": "docs/agents/",
    "decisionRecordsPath": "docs/decisions/"
  },
  "owners": {
    "primary": {
      "name": "Sam Park",
      "contact": "sam@acme.example"
    },
    "continuity": {
      "name": "Ada Okafor"
    }
  },
  "conformance": {
    "claimedLevel": "federated",
    "claimedAt": "2026-06-10"
  },
  "federation": {
    "mounts": [
      {
        "name": "acme-product-context",
        "source": "https://github.com/acme/product-context",
        "pin": "7d3f2a19c4e8b6a0d5f1c2e9b8a7f6d5c4b3a2e1",
        "trackingRef": "refs/heads/main",
        "owner": {
          "name": "Product team"
        },
        "role": "product-side context, owned and kept current by the product team",
        "categories": [
          "domain",
          "decisions"
        ],
        "topics": [
          "product surface",
          "customer-facing semantics",
          "billing"
        ],
        "requiredWhen": [
          "a task touches customer-facing product behavior, product terminology, or product-owned decisions"
        ]
      }
    ]
  }
}
